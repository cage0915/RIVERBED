{
  "name": "riverbed",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "test": "node --test src/lib/*.test.mjs src/lib/albums/*.test.mjs src/lib/mountains/*.test.mjs",
    "albums:validate": "node --import tsx scripts/validate-album-repository.mjs",
    "albums:dimensions": "node scripts/backfill-album-photo-dimensions.mjs",
    "dev": "astro dev",
    "dev:host": "astro dev --host",
    "contours:generate": "node scripts/generate-mountain-contours.mjs",
    "prebuild": "node --import tsx scripts/validate-album-repository.mjs && node scripts/prepare-contour-assets.mjs prepare",
    "build": "astro build",
    "postbuild": "node scripts/prepare-contour-assets.mjs cleanup",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/rss": "^4.0.19",
    "@fontsource/fjalla-one": "^5.2.7",
    "@fontsource/noto-sans-jp": "^5.2.9",
    "@fontsource/noto-sans-tc": "^5.2.9",
    "@fontsource/pt-sans": "^5.2.8",
    "astro": "^7.4.7",
    "photoswipe": "^5.4.4",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@aws-sdk/client-s3": "^3.1090.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "autoprefixer": "^10.6.2",
    "geotiff": "^2.1.3",
    "sharp": "^0.33.5",
    "sirv": "^3.0.2",
    "trash": "^10.1.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.158.0"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
