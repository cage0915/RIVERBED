---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import {
    getFolderTitle,
    getFolderOrder,
    getImageUrl,
    R2_DOMAIN,
} from "../lib/constants";

// Get all albums
const allAlbums = await getCollection("albums");

// Load external order using import.meta.glob
const orderFiles = import.meta.glob("../content/albums/**/_order.json", { eager: true });

const getAlbumOrderIndex = (slug: string) => {
    const [folder, album] = slug.split("/");
    const orderData = orderFiles[`../content/albums/${folder}/_order.json`] as
        | { default: string[] }
        | undefined;
    const index = orderData?.default.indexOf(album) ?? -1;
    return index === -1 ? Number.MAX_SAFE_INTEGER : index;
};

const latestAlbum = [...allAlbums].sort((a, b) => {
    const dateDifference =
        (b.data.publishedAt?.getTime() ?? 0) -
        (a.data.publishedAt?.getTime() ?? 0);
    if (dateDifference !== 0) return dateDifference;

    const orderDifference = getAlbumOrderIndex(a.slug) - getAlbumOrderIndex(b.slug);
    return orderDifference || a.slug.localeCompare(b.slug);
})[0];

const latestAlbumCoverKey = latestAlbum.data.coverKey.includes("/")
    ? latestAlbum.data.coverKey
    : `${latestAlbum.slug}/${latestAlbum.data.coverKey}`;
const latestAlbumFolder = latestAlbum.slug.split("/")[0];

// Group albums by folder, sorted by album order (matching folder page logic)
const folderSlugs = [...new Set(allAlbums.map((album) => album.slug.split("/")[0]))];
const folderMap = new Map<
    string,
    {
        coverUrl: string;
        fallbackUrl: string;
        title: string;
        coverZoom?: number;
        coverOffset?: { x: number; y: number };
    }[]
>();

for (const slug of folderSlugs) {
    const albumsInFolder = allAlbums.filter((album) => album.slug.startsWith(`${slug}/`));

    // Sort according to _order.json if exists
    const targetOrderPath = `../content/albums/${slug}/_order.json`;
    const orderData = orderFiles[targetOrderPath] as { default: string[] } | undefined;
    const order = orderData ? orderData.default : [];

    albumsInFolder.sort((a, b) => {
        const albumSlugA = a.slug.split("/")[1];
        const albumSlugB = b.slug.split("/")[1];
        const idxA = order.indexOf(albumSlugA);
        const idxB = order.indexOf(albumSlugB);

        if (idxA !== -1 && idxB !== -1) return idxA - idxB;
        if (idxA !== -1) return -1;
        if (idxB !== -1) return 1;
        return (b.data.order ?? 0) - (a.data.order ?? 0);
    });

    folderMap.set(slug, albumsInFolder.map(album => {
        const resolvedCoverKey = album.data.coverKey.includes("/")
            ? album.data.coverKey
            : `${album.slug}/${album.data.coverKey}`;
        return {
            coverUrl: getImageUrl(resolvedCoverKey),
            fallbackUrl: `${R2_DOMAIN}/${resolvedCoverKey}`,
            title: album.data.title,
            coverZoom: album.data.coverZoom,
            coverOffset: album.data.coverOffset,
        };
    }));
}

const isDev = import.meta.env.DEV;

const globalOrderData = orderFiles["../content/albums/_order.json"] as { default: string[] } | undefined;
const globalOrder = globalOrderData ? globalOrderData.default : [];

const sortedFolders = folderSlugs
    .map((slug) => ({
        id: slug,
        title: getFolderTitle(slug),
        order: getFolderOrder(slug),
        covers: folderMap.get(slug) ?? [],
    }))
    .sort((a, b) => {
        const idxA = globalOrder.indexOf(a.id);
        const idxB = globalOrder.indexOf(b.id);
        if (idxA !== -1 && idxB !== -1) return idxA - idxB;
        if (idxA !== -1) return -1;
        if (idxB !== -1) return 1;
        return a.order - b.order;
    });

---

<Layout title="RIVERBED">
    <div class="pt-6 pb-8">
        <section class="latest-post" aria-label="Latest post">
            <article class="album-card latest-post-card group">
                <a href={`/${latestAlbum.slug}`} class="album-link">
                    <div class="album-cover latest-post-cover">
                        <img
                            src={getImageUrl(latestAlbumCoverKey)}
                            alt={latestAlbum.data.title}
                            loading="eager"
                            class="slide active"
                            style={`--zoom: ${latestAlbum.data.coverZoom ?? 1}; --ox: ${latestAlbum.data.coverOffset?.x ?? 50}%; --oy: ${latestAlbum.data.coverOffset?.y ?? 50}%;`}
                            onerror={
                                isDev
                                    ? `this.onerror=null; this.src='${R2_DOMAIN}/${latestAlbumCoverKey}';`
                                    : undefined
                            }
                        />
                        <div class="album-overlay">
                            <div class="latest-post-info">
                                <p class="latest-post-label">
                                    Latest · {getFolderTitle(latestAlbumFolder)}
                                </p>
                                <h1 class="album-title">{latestAlbum.data.title}</h1>
                                {latestAlbum.data.info && (
                                    <p class="latest-post-meta">{latestAlbum.data.info}</p>
                                )}
                            </div>
                        </div>
                    </div>
                </a>
            </article>
        </section>

        <nav
            class="folders-grid"
            aria-label="Photo collections"
            style={`--folder-count: ${sortedFolders.length}`}
        >
            {
                sortedFolders.map((folder) => (
                    <div
                        class="album-card folder-card group"
                        data-covers={folder.covers.length}
                    >
                        <a href={`/${folder.id}`} class="album-link">
                            <div class="album-cover">
                                {folder.covers.map((cover, i) => (
                                    <img
                                        src={cover.coverUrl}
                                        alt={cover.title}
                                        loading={i === 0 ? "eager" : "lazy"}
                                        class={`slide ${i === 0 ? "active" : ""}`}
                                        style={`--zoom: ${cover.coverZoom ?? 1}; --ox: ${cover.coverOffset?.x ?? 50}%; --oy: ${cover.coverOffset?.y ?? 50}%;`}
                                        onerror={
                                            isDev
                                                ? `this.onerror=null; this.src='${cover.fallbackUrl}';`
                                                : undefined
                                        }
                                    />
                                ))}
                                <div class="album-overlay">
                                    <h2 class="album-title">{folder.title}</h2>
                                </div>
                            </div>
                        </a>
                    </div>
                ))
            }
        </nav>
    </div>
</Layout>

<script>
    const INTERVAL_MS = 5000;

    const initFolderCards = () => {
        document
            .querySelectorAll<HTMLElement>(".album-card")
            .forEach((card) => {
                const slides =
                    card.querySelectorAll<HTMLImageElement>(".slide");
                if (slides.length <= 1) return;

                let current = 0;
                setInterval(() => {
                    slides[current].classList.remove("active");
                    current = (current + 1) % slides.length;
                    slides[current].classList.add("active");
                }, INTERVAL_MS);
            });

        // Mobile tap-to-reveal overlay (same as folder page)
        const cards = document.querySelectorAll(".album-card");
        cards.forEach((card) => {
            const link = card.querySelector(".album-link");
            card.addEventListener("click", (e) => {
                const isMobile = window.matchMedia(
                    "(max-width: 768px) and (hover: none)",
                ).matches;
                if (!isMobile) return;

                if (!card.classList.contains("show-info")) {
                    e.preventDefault();
                    cards.forEach((c) => c.classList.remove("show-info"));
                    card.classList.add("show-info");
                }
            });
        });

        document.addEventListener("click", (e) => {
            if (!(e.target as Element).closest(".album-card")) {
                cards.forEach((c) => c.classList.remove("show-info"));
            }
        });
    };

    initFolderCards();
    document.addEventListener("astro:after-swap", initFolderCards);
</script>

<style>
    .folders-grid {
        display: grid;
        grid-template-columns: repeat(var(--folder-count, 5), minmax(0, 1fr));
        gap: 0.5rem;
        margin: 0 auto;
    }

    .latest-post {
        margin-bottom: 0.5rem;
    }

    .latest-post-cover {
        max-height: calc(100vh - 10rem);
    }

    .latest-post-info {
        text-align: center;
    }

    .latest-post-label,
    .latest-post-meta {
        margin: 0;
        font-family: "PT Sans", sans-serif;
        font-size: 0.7rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: #374151;
    }

    .latest-post-meta {
        margin-top: 0.65rem;
        letter-spacing: 0.08em;
        text-transform: none;
    }

    .album-card {
        position: relative;
    }

    .album-link {
        text-decoration: none;
        color: inherit;
        display: block;
    }

    .album-cover {
        position: relative;
        width: 100%;
        aspect-ratio: 177/100;
        overflow: hidden;
    }

    /* All slides stacked on top of each other */
    .album-cover .slide {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0;
        object-position: var(--ox) var(--oy);
        transform-origin: var(--ox) var(--oy);
        transform: scale(var(--zoom));
        transition:
            opacity 0.8s ease,
            transform 0.6s cubic-bezier(0.16, 1, 0.3, 1),
            object-position 0.6s;
    }

    .album-cover .slide.active {
        opacity: 1;
    }

    .album-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
        transition: all 0.4s ease;
        background: rgba(255, 255, 255, 0);
        opacity: 0;
        z-index: 10;
        pointer-events: none;
    }

    .album-title {
        font-family: "Noto Sans TC", "Noto Sans JP", sans-serif;
        font-size: 1.5rem;
        font-weight: 400;
        letter-spacing: 0.08em;
        text-align: center;
        color: #111827;
        transform: translateY(10px);
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        z-index: 20;
    }

    .folder-card .album-title {
        font-size: clamp(0.7rem, 1.25vw, 1rem);
    }

    .album-card.show-info .album-overlay {
        opacity: 1;
        background: rgba(255, 255, 255, 0.7);
    }

    .album-card.show-info .album-title {
        opacity: 1;
        transform: translateY(0);
    }

    @media (hover: hover) {
        .album-card:hover .slide.active {
            transform: scale(calc(var(--zoom) * 1.05));
        }

        .album-card:hover .album-overlay {
            opacity: 1;
            background: rgba(255, 255, 255, 0.6);
        }

        .album-card:hover .album-title {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @media (max-width: 640px) {
        .latest-post-cover {
            aspect-ratio: 4 / 3;
        }

        .folders-grid {
            grid-template-columns: repeat(
                var(--folder-count, 5),
                minmax(9rem, 1fr)
            );
            overflow-x: auto;
            padding-bottom: 0.35rem;
            scrollbar-width: thin;
        }

        .folder-card .album-title {
            font-size: 0.8rem;
        }
    }
</style>
