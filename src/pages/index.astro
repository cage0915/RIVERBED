---
import Layout from "../layouts/Layout.astro";
import CatalogCardInteractions from "../components/CatalogCardInteractions.astro";
import { getAlbumSummaries } from "../lib/albums/catalog";
import {
    getFolderTitle,
    getFolderOrder,
    getThumbnailSrcSet,
    getThumbnailUrl,
    R2_DOMAIN,
} from "../lib/constants";

const allAlbums = await getAlbumSummaries();

const latestAlbum = [...allAlbums].sort((a, b) => {
    const dateDifference =
        (b.publishedAt ? Date.parse(b.publishedAt) : 0) -
        (a.publishedAt ? Date.parse(a.publishedAt) : 0);
    if (dateDifference !== 0) return dateDifference;

    const orderDifference = a.order - b.order;
    return orderDifference || a.slug.localeCompare(b.slug);
})[0];

if (!latestAlbum) {
    throw new Error("Home page requires at least one Album in the catalog");
}

const latestAlbumCoverKey = latestAlbum.cover.assetKey;
const latestAlbumFolder = latestAlbum.slug.split("/")[0];

// Group albums by folder, sorted by album order (matching folder page logic)
const folderSlugs = [...new Set(allAlbums.map((album) => album.slug.split("/")[0]))];
const folderMap = new Map<
    string,
    {
        coverUrl: string;
        coverSrcSet?: string;
        fallbackUrl: string;
        title: string;
        coverZoom?: number;
        coverOffset?: { x: number; y: number };
    }[]
>();

for (const slug of folderSlugs) {
    const albumsInFolder = allAlbums.filter((album) => album.slug.startsWith(`${slug}/`));

    folderMap.set(slug, albumsInFolder.map(album => {
        const resolvedCoverKey = album.cover.assetKey;
        return {
            coverUrl: getThumbnailUrl(resolvedCoverKey, 480),
            coverSrcSet: getThumbnailSrcSet(resolvedCoverKey, [320, 480, 720]),
            fallbackUrl: `${R2_DOMAIN}/${resolvedCoverKey}`,
            title: album.title,
            coverZoom: album.cover.zoom,
            coverOffset: album.cover.offset,
        };
    }));
}

const isDev = import.meta.env.DEV;

const sortedFolders = folderSlugs
    .map((slug) => ({
        id: slug,
        title: getFolderTitle(slug),
        order: getFolderOrder(slug),
        covers: folderMap.get(slug) ?? [],
    }))
    .sort((a, b) => a.order - b.order);

---

<Layout title="RIVERBED">
    <div class="pt-6 pb-8" data-catalog-grid>
        <section class="latest-post" aria-label="Latest post">
            <article class="album-card latest-post-card group" data-catalog-card data-keyboard-navigation-target>
                <a href={`/${latestAlbum.slug}`} class="album-link">
                    <div class="album-cover latest-post-cover">
                        <img
                            src={getThumbnailUrl(latestAlbumCoverKey, 1100)}
                            srcset={getThumbnailSrcSet(latestAlbumCoverKey)}
                            sizes="(max-width: 640px) calc(100vw - 2rem), (max-width: 1100px) calc(100vw - 4rem), 1036px"
                            alt={latestAlbum.title}
                            loading="eager"
                            fetchpriority="high"
                            decoding="async"
                            class="slide active"
                            style={`--zoom: ${latestAlbum.cover.zoom}; --ox: ${latestAlbum.cover.offset.x}%; --oy: ${latestAlbum.cover.offset.y}%;`}
                            onerror={
                                isDev
                                    ? `this.onerror=null; this.src='${R2_DOMAIN}/${latestAlbumCoverKey}';`
                                    : undefined
                            }
                        />
                        <div class="album-overlay">
                            <div class="latest-post-info">
                                <p class="latest-post-label">
                                    Latest · {getFolderTitle(latestAlbumFolder)}
                                </p>
                                <h1 class="album-title">{latestAlbum.title}</h1>
                                {latestAlbum.info && (
                                    <p class="latest-post-meta">{latestAlbum.info}</p>
                                )}
                            </div>
                        </div>
                    </div>
                </a>
            </article>
        </section>

        <nav
            class="folders-grid"
            aria-label="Photo collections"
            style={`--folder-count: ${sortedFolders.length}`}
        >
            {
                sortedFolders.map((folder) => (
                    <div
                        class="album-card folder-card group"
                        data-catalog-card
                        data-keyboard-navigation-target
                        data-mobile-direct
                        data-covers={folder.covers.length}
                    >
                        <a href={`/${folder.id}`} class="album-link">
                            <div class="album-cover">
                                {folder.covers.map((cover, i) => (
                                    <img
                                        src={i === 0 ? cover.coverUrl : undefined}
                                        srcset={i === 0 ? cover.coverSrcSet : undefined}
                                        sizes="(max-width: 640px) 9rem, (max-width: 1100px) calc((100vw - 6rem) / 5), 203px"
                                        data-src={i === 0 ? undefined : cover.coverUrl}
                                        data-srcset={i === 0 ? undefined : cover.coverSrcSet}
                                        alt={cover.title}
                                        loading={i === 0 ? "eager" : "lazy"}
                                        decoding="async"
                                        class={`slide ${i === 0 ? "active" : ""}`}
                                        style={`--zoom: ${cover.coverZoom ?? 1}; --ox: ${cover.coverOffset?.x ?? 50}%; --oy: ${cover.coverOffset?.y ?? 50}%;`}
                                        onerror={
                                            isDev
                                                ? `this.onerror=null; this.src='${cover.fallbackUrl}';`
                                                : undefined
                                        }
                                    />
                                ))}
                            </div>
                            <h2 class="folder-title">{folder.title}</h2>
                        </a>
                    </div>
                ))
            }
        </nav>
    </div>
    <CatalogCardInteractions />
</Layout>

<style>
    .folders-grid {
        display: grid;
        grid-template-columns: repeat(var(--folder-count, 5), minmax(0, 1fr));
        gap: 0.5rem;
        margin: 0 auto;
    }

    .latest-post {
        margin-bottom: 0.5rem;
    }

    .latest-post-cover {
        max-height: calc(100vh - 10rem);
    }

    .latest-post-info {
        text-align: center;
    }

    .latest-post-label,
    .latest-post-meta {
        margin: 0;
        font-family: "PT Sans", sans-serif;
        font-size: 0.7rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: #374151;
    }

    .latest-post-meta {
        margin-top: 0.65rem;
        letter-spacing: 0.08em;
        text-transform: none;
    }

    .album-card {
        position: relative;
    }

    .album-link {
        text-decoration: none;
        color: inherit;
        display: block;
    }

    .album-cover {
        position: relative;
        width: 100%;
        aspect-ratio: 177/100;
        overflow: hidden;
    }

    /* All slides stacked on top of each other */
    .album-cover .slide {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0;
        object-position: var(--ox) var(--oy);
        transform-origin: var(--ox) var(--oy);
        transform: scale(var(--zoom));
        transition:
            opacity 0.8s ease,
            transform 0.6s cubic-bezier(0.16, 1, 0.3, 1),
            object-position 0.6s;
    }

    .album-cover .slide.active {
        opacity: 1;
    }

    .album-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
        transition: all 0.4s ease;
        background: rgba(255, 255, 255, 0);
        opacity: 0;
        z-index: 10;
        pointer-events: none;
    }

    .album-title {
        font-family: "Noto Sans TC", "Noto Sans JP", sans-serif;
        font-size: 1.5rem;
        font-weight: 400;
        letter-spacing: 0.08em;
        text-align: center;
        color: #111827;
        transform: translateY(10px);
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        z-index: 20;
    }

    .folder-title {
        margin: 0;
        padding: 0.65rem 0.25rem 0;
        font-family: "Noto Sans TC", "Noto Sans JP", sans-serif;
        font-size: clamp(0.7rem, 1.25vw, 1rem);
        font-weight: 400;
        letter-spacing: 0.08em;
        text-align: center;
        color: #a1a1aa;
        transition: color 0.25s ease;
    }

    .album-card.show-info .album-overlay {
        opacity: 1;
        background: rgba(255, 255, 255, 0.7);
    }

    .album-card.show-info .album-title {
        opacity: 1;
        transform: translateY(0);
    }

    @media (hover: hover) {
        .album-card:hover .slide.active {
            transform: scale(calc(var(--zoom) * 1.05));
        }

        .album-card:hover .album-overlay {
            opacity: 1;
            background: rgba(255, 255, 255, 0.6);
        }

        .album-card:hover .album-title {
            opacity: 1;
            transform: translateY(0);
        }

        .album-card:hover .folder-title {
            color: #f4f4f5;
        }
    }

    @media (max-width: 640px) {
        .latest-post-cover {
            aspect-ratio: 4 / 3;
        }

        .folders-grid {
            grid-template-columns: repeat(
                var(--folder-count, 5),
                minmax(9rem, 1fr)
            );
            overflow-x: auto;
            padding-bottom: 0.35rem;
            scrollbar-width: thin;
        }

        .folder-title {
            font-size: 0.8rem;
        }
    }
</style>
