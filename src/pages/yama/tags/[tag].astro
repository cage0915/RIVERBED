---
import Layout from "../../../layouts/Layout.astro";
import Row from "../../../components/Row.astro";
import Photo from "../../../components/Photo.astro";
import MountainProfile from "../../../components/MountainProfile.astro";
import {
    getAlbumCatalog,
    getTaggedPhotos,
} from "../../../lib/albums/catalog";
import { allMountains as mountainsData } from "../../../lib/mountains";
import { getImageUrl, R2_DOMAIN } from "../../../lib/constants";
import { tagPathParams } from "../../../lib/static-paths";

export async function getStaticPaths() {
    const albums = (await getAlbumCatalog()).getAlbums();
    return tagPathParams(
        mountainsData.map((mountain) => mountain.name),
        albums.flatMap((album) =>
            album.photos
                .filter((photo) => photo.isContent)
                .flatMap((photo) => photo.tags.map((tag) => tag.name))
        ),
    );
}

const { tag } = Astro.params;

if (!tag) {
    return Astro.redirect("/404");
}

const decodedTag = decodeURIComponent(tag);
const mountain = mountainsData.find(
    (entry) => entry.name === decodedTag,
);
const matchingPhotos = await getTaggedPhotos(decodedTag);
const representativePhotoKey = mountain?.coverKey;
const representativePhotoUrl = representativePhotoKey
    ? getImageUrl(representativePhotoKey)
    : undefined;
const representativePhotoFallbackUrl = representativePhotoKey
    ? `${R2_DOMAIN}/${representativePhotoKey}`
    : undefined;
const isDev = import.meta.env.DEV;

const photosByAlbum = matchingPhotos.reduce(
    (acc, photo) => {
        const key = photo.sourceAlbumSlug;
        if (!acc[key]) {
            acc[key] = {
                albumTitle: photo.sourceAlbumTitle,
                sourceAlbumSlug: photo.sourceAlbumSlug,
                photos: [],
            };
        }
        acc[key].photos.push(photo);
        return acc;
    },
    {} as Record<
        string,
        {
            albumTitle: string;
            sourceAlbumSlug: string;
            photos: typeof matchingPhotos;
        }
    >,
);

const albums = Object.values(photosByAlbum);

function chunkArray<T>(array: T[], size: number): T[][] {
    const chunks: T[][] = [];
    for (let i = 0; i < array.length; i += size) {
        chunks.push(array.slice(i, i + size));
    }
    return chunks;
}
---

<Layout title={`#${decodedTag} - RIVERBED`}>
    <div class="fixed bottom-8 right-8 z-40 flex flex-col gap-3">
        <button
            onclick="window.scrollTo({top: 0, behavior: 'smooth'})"
            class="group text-zinc-500 hover:text-white transition-all duration-300 opacity-0 translate-y-4 pointer-events-none"
            id="back-to-top"
            aria-label="Scroll to top"
        >
            <div
                class="w-8 h-8 rounded-full border border-white/10 flex items-center justify-center group-hover:border-white/30 transition-colors bg-white/20 backdrop-blur-sm"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="m18 15-6-6-6 6"></path></svg
                >
            </div>
        </button>
        <a
            href="/yama/tags"
            title="Back to mountains"
            aria-label="Back to mountain view"
            class="group text-zinc-500 hover:text-white transition-all duration-300"
        >
            <div
                class="w-8 h-8 rounded-full border border-white/10 flex items-center justify-center group-hover:border-white/30 transition-colors bg-white/20 backdrop-blur-sm"
            >
                <svg
                    width="16"
                    height="16"
                    viewBox="0 -960 960 960"
                    fill="currentColor"
                    aria-hidden="true"
                >
                    <path d="m40-240 240-320 195 260h325L560-619 435-453l-38-50 163-217 360 480H40Zm510-60Zm-390 0h240L280-460 160-300Zm0 0h240-240Z"></path>
                </svg>
            </div>
        </a>
        <button
            onclick="window.scrollTo({top: document.body.scrollHeight, behavior: 'smooth'})"
            class="group text-zinc-500 hover:text-white transition-all duration-300 opacity-0 translate-y-4 pointer-events-none"
            id="scroll-to-bottom"
            aria-label="Scroll to bottom"
        >
            <div
                class="w-8 h-8 rounded-full border border-white/10 flex items-center justify-center group-hover:border-white/30 transition-colors bg-white/20 backdrop-blur-sm"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="m6 9 6 6 6-6"></path></svg
                >
            </div>
        </button>
    </div>

    <main
        class="tag-page container mx-auto px-4 py-4 max-w-5xl"
        data-tag-name={decodedTag}
    >
        {
            mountain ? (
                <MountainProfile mountain={mountain} />
            ) : (
                <h1 class="text-xl font-sans tracking-widest uppercase mb-6 text-center">
                    {decodedTag}
                </h1>
            )
        }

        {mountain && representativePhotoUrl && (
            <figure class="mountain-representative-photo">
                <img
                    src={representativePhotoUrl}
                    alt={`${decodedTag} cover photo`}
                    loading="eager"
                    onerror={
                        isDev && representativePhotoFallbackUrl
                            ? `this.onerror=null; this.src='${representativePhotoFallbackUrl}';`
                            : undefined
                    }
                />
            </figure>
        )}
        {mountain && isDev && (
            <p class="mountain-cover-status" aria-live="polite" />
        )}

        <div class="tag-photos space-y-12">
            {
                albums.map((album) => (
                    <div class="tag-album-group group border-b border-white/5 pb-12 last:border-0">
                        <div class="mb-6 flex items-baseline justify-between px-2">
                            <h2 class="text-[10px] font-medium tracking-[0.2em] text-zinc-500 uppercase">
                                {album.albumTitle}
                            </h2>
                        </div>

                        <div class="space-y-2">
                            {chunkArray(album.photos, 3).map((chunk) => (
                                <Row cols={chunk.length}>
                                    {chunk.map((photo) => (
                                        <div
                                            class:list={[
                                                "tag-photo-entry",
                                                photo.assetKey === representativePhotoKey &&
                                                    "tag-photo-entry--cover",
                                            ]}
                                            data-cover-key={photo.assetKey}
                                        >
                                            <Photo
                                                assetKey={photo.assetKey}
                                                caption={photo.caption}
                                                tags={photo.tags}
                                            />
                                            {isDev && mountain && (
                                                <button
                                                    class="mountain-cover-choice"
                                                    type="button"
                                                    disabled={photo.assetKey === representativePhotoKey}
                                                >
                                                    {photo.assetKey === representativePhotoKey
                                                        ? "Cover photo"
                                                        : "Set as cover"}
                                                </button>
                                            )}
                                        </div>
                                    ))}
                                </Row>
                            ))}
                        </div>

                        <div class="mt-8 flex justify-end items-center px-2">
                            <a
                                href={`/${album.sourceAlbumSlug}`}
                                class="text-[10px] text-zinc-400 hover:text-white transition-colors tracking-widest uppercase border-b border-transparent hover:border-white/40 pb-0.5"
                            >
                                View Full Album →
                            </a>
                        </div>
                    </div>
                ))
            }
        </div>

        {
            matchingPhotos.length === 0 && (
                <div class="text-center py-32">
                    <p class="text-zinc-500 font-light italic text-sm">
                        No captures found with this tag.
                    </p>
                    <a
                        href="/"
                        class="text-xs mt-8 inline-block text-zinc-400 hover:text-white border border-white/10 px-6 py-2 rounded-full transition-all hover:bg-white/5"
                    >
                        Return to Folders
                    </a>
                </div>
            )
        }
    </main>
</Layout>

<style>
    .mountain-representative-photo {
        position: relative;
        width: 100%;
        margin: -1.5rem 0 4rem;
        overflow: hidden;
        background: #1a1a1a;
    }

    .mountain-cover-choice {
        border: 1px solid rgb(255 255 255 / 0.2);
        border-radius: 999px;
        background: rgb(18 18 18 / 0.82);
        color: rgb(228 228 231);
        font-size: 0.68rem;
        letter-spacing: 0.08em;
        transition: border-color 0.2s ease, background 0.2s ease;
    }

    .mountain-cover-choice:hover {
        border-color: rgb(255 255 255 / 0.45);
        background: rgb(18 18 18 / 0.95);
    }

    .mountain-cover-status {
        min-height: 1.25rem;
        margin: -3rem 0 2rem;
        color: rgb(161 161 170);
        font-size: 0.72rem;
        text-align: center;
    }

    .mountain-cover-status:empty {
        display: none;
    }

    .tag-photo-entry {
        position: relative;
        min-width: 0;
    }

    .mountain-cover-choice {
        position: absolute;
        top: 0.75rem;
        right: 0.75rem;
        z-index: 20;
        display: block;
        padding: 0.45rem 0.7rem;
    }

    .tag-photo-entry--cover .mountain-cover-choice {
        border-color: rgb(212 175 55 / 0.95);
        background: rgb(18 18 18 / 0.9);
        color: rgb(254 240 138);
        cursor: default;
    }

    .mountain-representative-photo img {
        display: block;
        width: 100%;
        height: auto;
    }

    .tag-photos {
        width: 100%;
    }

    .tag-album-group {
        opacity: 0;
        animation: fadeInUp 0.8s ease forwards;
    }

    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Staggered animation for entries */
    .tag-album-group:nth-child(1) {
        animation-delay: 0.1s;
    }
    .tag-album-group:nth-child(2) {
        animation-delay: 0.2s;
    }
    .tag-album-group:nth-child(3) {
        animation-delay: 0.3s;
    }
    .tag-album-group:nth-child(4) {
        animation-delay: 0.4s;
    }
    .tag-album-group:nth-child(5) {
        animation-delay: 0.5s;
    }

    @media (max-width: 767px) {
        .mountain-representative-photo {
            margin-top: -1rem;
            margin-bottom: 3rem;
        }
    }
</style>

<script>
    const COVER_SCROLL_RESET_KEY = "riverbed:mountain-cover:scroll-top";

    const setCoverScrollReset = (enabled: boolean) => {
        try {
            if (enabled) sessionStorage.setItem(COVER_SCROLL_RESET_KEY, "true");
            else sessionStorage.removeItem(COVER_SCROLL_RESET_KEY);
        } catch {
            // Cover selection still works if session storage is unavailable.
        }
    };

    const resetCoverSaveScrollPosition = () => {
        try {
            if (sessionStorage.getItem(COVER_SCROLL_RESET_KEY) !== "true") return;
        } catch {
            return;
        }

        history.scrollRestoration = "manual";
        const forcePageTop = () => window.scrollTo(0, 0);
        forcePageTop();
        window.addEventListener("pageshow", forcePageTop, { once: true });
        requestAnimationFrame(forcePageTop);
        window.setTimeout(forcePageTop, 100);
        window.setTimeout(() => {
            forcePageTop();
            setCoverScrollReset(false);
            history.scrollRestoration = "auto";
        }, 500);
    };

    const initMountainCoverChooser = () => {
        const page = document.querySelector<HTMLElement>(".tag-page[data-tag-name]");
        if (!page) return;

        const status = page.querySelector<HTMLElement>(".mountain-cover-status");
        const choiceButtons = page.querySelectorAll<HTMLButtonElement>(
            ".mountain-cover-choice",
        );

        choiceButtons.forEach((button) => {
            button.addEventListener("click", async () => {
                const entry = button.closest<HTMLElement>("[data-cover-key]");
                const coverKey = entry?.dataset.coverKey;
                const mountainName = page.dataset.tagName;
                if (!coverKey || !mountainName) return;

                choiceButtons.forEach((candidate) => (candidate.disabled = true));
                if (status) status.textContent = "Saving cover…";
                setCoverScrollReset(true);

                try {
                    const response = await fetch("/api/mountain-cover", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ mountainName, coverKey }),
                    });
                    const result = await response.json();
                    if (!response.ok) {
                        throw new Error(result.error || "Unable to save cover");
                    }
                    if (status) status.textContent = "Cover saved.";

                    choiceButtons.forEach((candidate) => {
                        const candidateEntry = candidate.closest<HTMLElement>(
                            ".tag-photo-entry",
                        );
                        const isCover = candidateEntry === entry;
                        candidateEntry?.classList.toggle(
                            "tag-photo-entry--cover",
                            isCover,
                        );
                        candidate.disabled = isCover;
                        candidate.textContent = isCover
                            ? "Cover photo"
                            : "Set as cover";
                    });

                    const sourceImage = entry.querySelector<HTMLImageElement>("img");
                    const sourceUrl = sourceImage?.currentSrc || sourceImage?.src;
                    if (sourceUrl) {
                        let figure = page.querySelector<HTMLElement>(
                            ".mountain-representative-photo",
                        );
                        if (!figure) {
                            figure = document.createElement("figure");
                            figure.className = "mountain-representative-photo";
                            const image = document.createElement("img");
                            image.alt = `${mountainName} cover photo`;
                            image.loading = "eager";
                            figure.append(image);
                            status?.before(figure);
                        }
                        const coverImage = figure.querySelector<HTMLImageElement>("img");
                        if (coverImage) coverImage.src = sourceUrl;
                    }

                    history.scrollRestoration = "manual";
                    window.scrollTo(0, 0);
                    requestAnimationFrame(() => window.scrollTo(0, 0));
                    window.setTimeout(() => {
                        setCoverScrollReset(false);
                        history.scrollRestoration = "auto";
                    }, 3_000);
                } catch (error) {
                    setCoverScrollReset(false);
                    choiceButtons.forEach((candidate) => {
                        candidate.disabled = Boolean(
                            candidate.closest(".tag-photo-entry--cover"),
                        );
                    });
                    if (status) {
                        status.textContent =
                            error instanceof Error
                                ? error.message
                                : "Unable to save cover";
                    }
                }
            });
        });
    };

    resetCoverSaveScrollPosition();
    initMountainCoverChooser();
    document.addEventListener("astro:after-swap", initMountainCoverChooser);

    const handleScroll = () => {
        const backToTop = document.getElementById("back-to-top");
        const scrollToBottom = document.getElementById("scroll-to-bottom");

        if (backToTop) {
            if (window.scrollY > 300) {
                backToTop.classList.remove("opacity-0", "translate-y-4", "pointer-events-none");
                backToTop.classList.add("opacity-100", "translate-y-0", "pointer-events-auto");
            } else {
                backToTop.classList.add("opacity-0", "translate-y-4", "pointer-events-none");
                backToTop.classList.remove("opacity-100", "translate-y-0", "pointer-events-auto");
            }
        }

        if (scrollToBottom) {
            const isNearBottom = (window.scrollY + window.innerHeight) >= (document.documentElement.scrollHeight - 300);
            if (!isNearBottom) {
                scrollToBottom.classList.remove("opacity-0", "translate-y-4", "pointer-events-none");
                scrollToBottom.classList.add("opacity-100", "translate-y-0", "pointer-events-auto");
            } else {
                scrollToBottom.classList.add("opacity-0", "translate-y-4", "pointer-events-none");
                scrollToBottom.classList.remove("opacity-100", "translate-y-0", "pointer-events-auto");
            }
        }
    };

    window.addEventListener("scroll", handleScroll);
    document.addEventListener("astro:after-swap", handleScroll);
    handleScroll();
</script>
