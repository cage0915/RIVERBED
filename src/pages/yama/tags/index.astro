---
import Layout from "../../../layouts/Layout.astro";
import MountainTagGrid from "../../../components/MountainTagGrid.astro";
import {
    allMountains,
    MOUNTAIN_REGION_DEFINITIONS,
} from "../../../lib/mountains";
import { sanitizeMountainViewSettings } from "../../../lib/mountain-view-settings";
import mountainViewSettingsData from "../../../mountain-view-settings.json";

const mountainViewSettings = sanitizeMountainViewSettings(mountainViewSettingsData);
const mountainGroups = MOUNTAIN_REGION_DEFINITIONS.map((region) => ({
    ...region,
    mountains: allMountains
        .filter(
            (mountain) =>
                mountain.region === region.id &&
                mountain.elevation !== null &&
                mountain.location !== undefined &&
                Number.isFinite(mountain.location.latitude) &&
                Number.isFinite(mountain.location.longitude),
        )
        .map((mountain) => ({
            name: mountain.name,
            elevation: mountain.elevation as number,
            latitude: mountain.location!.latitude,
            longitude: mountain.location!.longitude,
            coverKey: mountain.coverKey,
        })),
}));
---

<Layout title="Mountains - RIVERBED">
    <div class="fixed bottom-8 right-8 z-40">
        <a
            href="/yama"
            title="Switch to trips"
            aria-label="Switch to trip view"
            class="group text-zinc-500 hover:text-white transition-all duration-300"
        >
            <div class="w-8 h-8 rounded-full border border-white/10 flex items-center justify-center group-hover:border-white/30 transition-colors bg-white/20 backdrop-blur-sm">
                <svg width="16" height="16" viewBox="0 -960 960 960" fill="currentColor" aria-hidden="true">
                    <path d="m40-240 240-320 195 260h325L560-619 435-453l-38-50 163-217 360 480H40Zm510-60Zm-390 0h240L280-460 160-300Zm0 0h240-240Z" />
                </svg>
            </div>
        </a>
    </div>
    <div class="py-8">
        <MountainTagGrid
            groups={mountainGroups}
            tagColumns={mountainViewSettings.tagColumns}
        />
    </div>
</Layout>
