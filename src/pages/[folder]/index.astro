---
import Layout from "../../layouts/Layout.astro";
import { getAlbumSummaries } from "../../lib/albums/catalog";
import { getFolderTitle, getFolderCols, getImageUrl, R2_DOMAIN, FOLDER_METADATA } from "../../lib/constants";
import { folderPathParams } from "../../lib/static-paths";

export async function getStaticPaths() {
    const albums = await getAlbumSummaries();
    return folderPathParams(
        albums.map((album) => album.slug),
        Object.keys(FOLDER_METADATA),
    );
}

const { folder } = Astro.params;

// Get all albums in this folder by checking the slug prefix
const allAlbums = await getAlbumSummaries();
const folderAlbums = allAlbums.filter((album) => album.folder === folder);

const isExistentFolder = folder && (folder in FOLDER_METADATA || folderAlbums.length > 0);

if (!isExistentFolder) {
    return Astro.redirect("/404");
}

const folderTitle = getFolderTitle(folder!);
const folderCols = getFolderCols(folder!);
const isDev = import.meta.env.DEV;
const isYama = folder === "yama";
---

<Layout title={`${folderTitle} - RIVERBED`}>
    <div class="py-8">
        {
            isYama && (
                <div class="fixed bottom-8 right-8 z-40">
                    <a
                        href={"/yama/tags"}
                        title="Switch to mountains"
                        aria-label="Switch to mountain view"
                        class="group text-zinc-500 hover:text-white transition-all duration-300"
                    >
                        <div class="w-8 h-8 rounded-full border border-white/10 flex items-center justify-center group-hover:border-white/30 transition-colors bg-white/20 backdrop-blur-sm">
                            <svg
                                width="16"
                                height="16"
                                viewBox="0 -960 960 960"
                                fill="currentColor"
                                aria-hidden="true"
                            >
                                <path d="M260-860q-52 0-86 51t-34 129q0 78 23 131.5t32 67.5l144-30q14-38 27.5-84t13.5-85q0-67-31.5-123.5T260-860Zm55 560q28 0 46.5-20.5T380-373q0-20-9-41.5T351-453l-131 27q-1 43 21.5 84.5T315-300Zm385-360q-57 0-88.5 56.5T580-480q0 40 14 85.5t28 83.5l143 29q10-15 32.5-68T820-480q0-78-34-129t-86-51Zm-55 560q51 0 73-42t22-85l-131-26q-10 17-19.5 38.5T580-173q0 32 18.5 52.5T645-100ZM315-240q-77 0-117-57t-38-128l-18-27q-11-17-36.5-77T80-680q0-103 51-171.5T260-920q85 0 132.5 75.5T440-680q0 58-16 107t-28 79l8 13q8 14 22 44.5t14 63.5q0 57-35.5 95T315-240ZM645-40q-54 0-89.5-38T520-173q0-33 14-63.5t22-44.5l8-13q-12-30-28-79t-16-107q0-89 47.5-164.5T700-720q78 0 129 68.5T880-480q0 91-25.5 150.5T818-253l-18 28q1 71-38.5 128T645-40Z" />
                            </svg>
                        </div>
                    </a>
                </div>
            )
        }

        <div class="albums-grid" style={`--cols: ${folderCols}`}>
            {
                folderAlbums.length > 0 ? (
                    folderAlbums.map((album) => {
                        const albumSlug = album.slug.split("/")[1];
                        const resolvedCoverKey = album.cover.assetKey;
                        const coverUrl = getImageUrl(resolvedCoverKey);
                        const fallbackUrl = `${R2_DOMAIN}/${resolvedCoverKey}`;
                        return (
                            <div
                                class="album-card group"
                                data-album-slug={album.slug}
                                data-cover-key={resolvedCoverKey}
                                data-cover-zoom={album.cover.zoom}
                                data-cover-offset-x={album.cover.offset.x}
                                data-cover-offset-y={album.cover.offset.y}
                            >
                                <a
                                    href={`/${folder}/${albumSlug}`}
                                    class="album-link"
                                >
                                    <div class="album-cover">
                                        <img
                                            src={coverUrl}
                                            alt={album.title}
                                            loading="lazy"
                                            style={`--zoom: ${album.cover.zoom}; --ox: ${album.cover.offset.x}%; --oy: ${album.cover.offset.y}%;`}
                                            onerror={
                                                isDev
                                                    ? `this.onerror=null; this.src='${fallbackUrl}';`
                                                    : undefined
                                            }
                                        />
                                        <div class="album-overlay">
                                            <h2 class="album-title">
                                                {album.title}
                                            </h2>
                                            {album.info && (
                                                <p class="album-info">{album.info}</p>
                                            )}
                                        </div>
                                    </div>
                                </a>
                            </div>
                        );
                    })
                ) : (
                    <div class="col-span-full py-40 text-center opacity-30 text-sm tracking-[0.2em] uppercase">
                        Coming Soon
                    </div>
                )
            }
        </div>
    </div>
</Layout>

<script>
    const initAlbumCards = () => {
        const cards = document.querySelectorAll(".album-card");

        cards.forEach((card) => {
            const link = card.querySelector(".album-link");

            card.addEventListener("click", (e) => {
                const isMobile = window.matchMedia(
                    "(max-width: 768px) and (hover: none)",
                ).matches;
                if (!isMobile) return;

                if (!card.classList.contains("show-info")) {
                    // First tap: show info
                    e.preventDefault();

                    // Close other cards
                    cards.forEach((c) => c.classList.remove("show-info"));

                    card.classList.add("show-info");
                } else {
                    // Second tap: follow link (natural behavior)
                }
            });
        });

        // Close when clicking outside
        document.addEventListener("click", (e) => {
            if (!(e.target as Element).closest(".album-card")) {
                cards.forEach((c) => c.classList.remove("show-info"));
            }
        });
    };

    initAlbumCards();
    document.addEventListener("astro:after-swap", initAlbumCards);
</script>

<style>
    .albums-grid {
        display: grid;
        grid-template-columns: repeat(var(--cols, 3), 1fr);
        gap: 0.5rem;
        margin: 0 auto;
    }

    @media (max-width: 1024px) {
        .albums-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 640px) {
        .albums-grid {
            grid-template-columns: 1fr;
        }
    }

    .album-card {
        position: relative;
    }

    .album-link {
        text-decoration: none;
        color: inherit;
        display: block;
    }

    .album-cover {
        position: relative;
        width: 100%;
        aspect-ratio: 177/100;
        overflow: hidden;
        background: #1a1a1a;
    }

    .album-cover img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: var(--ox) var(--oy);
        transform-origin: var(--ox) var(--oy);
        transform: scale(var(--zoom));
        transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), object-position 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .album-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
        transition: all 0.4s ease;
        background: rgba(255, 255, 255, 0);
        opacity: 0;
        z-index: 10;
        pointer-events: none;
    }

    .album-title {
        font-family: "Noto Sans TC", "Noto Sans JP", sans-serif;
        font-size: 1.25rem;
        font-weight: 400;
        letter-spacing: 0.05em;
        text-align: center;
        color: #111827;
        transform: translateY(10px);
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        z-index: 20;
    }

    .album-info {
        font-size: 0.875rem;
        font-weight: 300;
        letter-spacing: 0.05em;
        text-align: center;
        color: #111827;
        margin-top: 0.5rem;
        transform: translateY(10px);
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        z-index: 20;
    }

    .album-card.show-info .album-overlay {
        opacity: 1;
        background: rgba(255, 255, 255, 0.7);
    }

    .album-card.show-info .album-title,
    .album-card.show-info .album-info {
        opacity: 1;
        transform: translateY(0);
    }

    @media (hover: hover) {
        .album-card:hover .album-cover img {
            transform: scale(calc(var(--zoom) * 1.05));
        }

        .album-card:hover .album-overlay {
            opacity: 1;
            background: rgba(255, 255, 255, 0.6);
        }

        .album-card:hover .album-title,
        .album-card:hover .album-info {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
