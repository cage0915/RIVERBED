---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import MountainTagGrid from "../../components/MountainTagGrid.astro";
import { getFolderTitle, getFolderCols, getImageUrl, R2_DOMAIN, FOLDER_METADATA } from "../../lib/constants";
import mountainsData from "../../mountains.json";
import type { Mountain } from "../../components/MountainProfile.astro";

const { folder } = Astro.params;

// Get all albums in this folder by checking the slug prefix
const allAlbums = await getCollection("albums");
let folderAlbums = allAlbums.filter((album) => album.slug.startsWith(`${folder}/`));

// Load external order using import.meta.glob (works in production/Cloudflare)
const orderFiles = import.meta.glob("../../content/albums/**/_order.json", { eager: true });
const targetOrderPath = `../../content/albums/${folder}/_order.json`;
const orderData = orderFiles[targetOrderPath] as { default: string[] } | undefined;
const order = orderData ? orderData.default : [];

if (order.length > 0) {
    folderAlbums.sort((a, b) => {
        const slugA = a.slug.split("/")[1];
        const slugB = b.slug.split("/")[1];
        const idxA = order.indexOf(slugA);
        const idxB = order.indexOf(slugB);

        if (idxA !== -1 && idxB !== -1) return idxA - idxB;
        if (idxA !== -1) return -1;
        if (idxB !== -1) return 1;
        return (b.data.order ?? 0) - (a.data.order ?? 0);
    });
} else {
    folderAlbums.sort((a, b) => (b.data.order ?? 0) - (a.data.order ?? 0));
}

const isExistentFolder = folder && (folder in FOLDER_METADATA || folderAlbums.length > 0);

if (!isExistentFolder) {
    return Astro.redirect("/404");
}

const folderTitle = getFolderTitle(folder!);
const folderCols = getFolderCols(folder!);
const isDev = import.meta.env.DEV;
const isYama = folder === "yama";
const currentView =
    isYama && Astro.url.searchParams.get("view") === "tags"
        ? "tags"
        : "posts";

const mountainCards = (mountainsData as Mountain[])
    .filter(
        (mountain) =>
            mountain.elevation !== null &&
            mountain.location !== undefined &&
            Number.isFinite(mountain.location.latitude) &&
            Number.isFinite(mountain.location.longitude),
    )
    .map((mountain) => ({
        name: mountain.name,
        elevation: mountain.elevation as number,
        coverKey: mountain.coverKey,
    }));
---

<Layout title={`${folderTitle} - RIVERBED`}>
    <div class="py-8">
        {
            isYama && (
                <div class="fixed bottom-8 right-8 z-40">
                    <a
                        href={currentView === "posts" ? "/yama?view=tags" : "/yama"}
                        title={currentView === "posts" ? "切換至山岳" : "切換至行程"}
                        aria-label={currentView === "posts" ? "切換至山岳檢視" : "切換至行程檢視"}
                        class="group text-zinc-500 hover:text-white transition-all duration-300"
                    >
                        <div class="w-8 h-8 rounded-full border border-white/10 flex items-center justify-center group-hover:border-white/30 transition-colors bg-white/20 backdrop-blur-sm">
                            {currentView === "posts" ? (
                                <svg
                                    width="16"
                                    height="16"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.8"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    aria-hidden="true"
                                >
                                    <circle cx="10" cy="4.5" r="2" />
                                    <path d="m9 7-2.5 5 3 2 1.5 6M9 9l4 3 3-1M6.5 12 4 19M13 8l2 12M8 8H5.5" />
                                </svg>
                            ) : (
                                <svg
                                    width="16"
                                    height="16"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.8"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    aria-hidden="true"
                                >
                                    <path d="m3 19 6.5-11 3.2 5.2L15.5 9 21 19Z" />
                                    <path d="m7.7 11 1.8 1.5 1.3-1.1" />
                                </svg>
                            )}
                        </div>
                    </a>
                </div>
            )
        }

        {currentView === "tags" ? (
            <MountainTagGrid mountains={mountainCards} />
        ) : (
        <div class="albums-grid" style={`--cols: ${folderCols}`}>
            {
                folderAlbums.length > 0 ? (
                    folderAlbums.map((album) => {
                        const albumSlug = album.slug.split("/")[1];
                        const resolvedCoverKey = album.data.coverKey.includes("/")
                            ? album.data.coverKey
                            : `${album.slug}/${album.data.coverKey}`;
                        const coverUrl = getImageUrl(resolvedCoverKey);
                        const fallbackUrl = `${R2_DOMAIN}/${resolvedCoverKey}`;
                        return (
                            <div class="album-card group">
                                <a
                                    href={`/${folder}/${albumSlug}`}
                                    class="album-link"
                                >
                                    <div class="album-cover">
                                        <img
                                            src={coverUrl}
                                            alt={album.data.title}
                                            loading="lazy"
                                            style={`--zoom: ${album.data.coverZoom ?? 1}; --ox: ${album.data.coverOffset?.x ?? 50}%; --oy: ${album.data.coverOffset?.y ?? 50}%;`}
                                            onerror={
                                                isDev
                                                    ? `this.onerror=null; this.src='${fallbackUrl}';`
                                                    : undefined
                                            }
                                        />
                                        <div class="album-overlay">
                                            <h2 class="album-title">
                                                {album.data.title}
                                            </h2>
                                            {album.data.info && (
                                                <p class="album-info">{album.data.info}</p>
                                            )}
                                        </div>
                                    </div>
                                </a>
                            </div>
                        );
                    })
                ) : (
                    <div class="col-span-full py-40 text-center opacity-30 text-sm tracking-[0.2em] uppercase">
                        Coming Soon
                    </div>
                )
            }
        </div>
        )}
    </div>
</Layout>

<script>
    const initAlbumCards = () => {
        const cards = document.querySelectorAll(".album-card");

        cards.forEach((card) => {
            const link = card.querySelector(".album-link");

            card.addEventListener("click", (e) => {
                const isMobile = window.matchMedia(
                    "(max-width: 768px) and (hover: none)",
                ).matches;
                if (!isMobile) return;

                if (!card.classList.contains("show-info")) {
                    // First tap: show info
                    e.preventDefault();

                    // Close other cards
                    cards.forEach((c) => c.classList.remove("show-info"));

                    card.classList.add("show-info");
                } else {
                    // Second tap: follow link (natural behavior)
                }
            });
        });

        // Close when clicking outside
        document.addEventListener("click", (e) => {
            if (!(e.target as Element).closest(".album-card")) {
                cards.forEach((c) => c.classList.remove("show-info"));
            }
        });
    };

    initAlbumCards();
    document.addEventListener("astro:after-swap", initAlbumCards);
</script>

<style>
    .albums-grid {
        display: grid;
        grid-template-columns: repeat(var(--cols, 3), 1fr);
        gap: 0.5rem;
        margin: 0 auto;
    }

    @media (max-width: 1024px) {
        .albums-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 640px) {
        .albums-grid {
            grid-template-columns: 1fr;
        }
    }

    .album-card {
        position: relative;
    }

    .album-link {
        text-decoration: none;
        color: inherit;
        display: block;
    }

    .album-cover {
        position: relative;
        width: 100%;
        aspect-ratio: 177/100;
        overflow: hidden;
        background: #1a1a1a;
    }

    .album-cover img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: var(--ox) var(--oy);
        transform-origin: var(--ox) var(--oy);
        transform: scale(var(--zoom));
        transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), object-position 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .album-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
        transition: all 0.4s ease;
        background: rgba(255, 255, 255, 0);
        opacity: 0;
        z-index: 10;
        pointer-events: none;
    }

    .album-title {
        font-family: "Noto Sans TC", "Noto Sans JP", sans-serif;
        font-size: 1.25rem;
        font-weight: 400;
        letter-spacing: 0.05em;
        text-align: center;
        color: #111827;
        transform: translateY(10px);
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        z-index: 20;
    }

    .album-info {
        font-size: 0.875rem;
        font-weight: 300;
        letter-spacing: 0.05em;
        text-align: center;
        color: #111827;
        margin-top: 0.5rem;
        transform: translateY(10px);
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        z-index: 20;
    }

    .album-card.show-info .album-overlay {
        opacity: 1;
        background: rgba(255, 255, 255, 0.7);
    }

    .album-card.show-info .album-title,
    .album-card.show-info .album-info {
        opacity: 1;
        transform: translateY(0);
    }

    @media (hover: hover) {
        .album-card:hover .album-cover img {
            transform: scale(calc(var(--zoom) * 1.05));
        }

        .album-card:hover .album-overlay {
            opacity: 1;
            background: rgba(255, 255, 255, 0.6);
        }

        .album-card:hover .album-title,
        .album-card:hover .album-info {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
