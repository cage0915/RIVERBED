---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Row from "../../components/Row.astro";
import AlbumPhoto from "../../components/AlbumPhoto.astro";
import PhotoCarousel from "../../components/PhotoCarousel.astro";
import Text from "../../components/Text.astro";
import AlbumPagination from "../../components/AlbumPagination.astro";
import { albumPathParams } from "../../lib/static-paths";
import { getAlbumBySlug, getAlbumSummaries } from "../../lib/albums/catalog";

export async function getStaticPaths() {
    const albums = await getCollection("albums");
    return albumPathParams(albums.map((album) => album.slug));
}

const slugifySectionTitle = (value: string) => value
    .toLowerCase()
    .normalize("NFKD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[^a-z0-9\s-]/g, "")
    .trim()
    .replace(/\s+/g, "-") || "section";

const extractTitleSections = (body: string) => {
    const sections: Array<{ id: string; label: string }> = [];
    const slugCounts = new Map<string, number>();
    const titleBlockPattern = /<Text\b(?=[^>]*\bsize="title")[^>]*>([\s\S]*?)<\/Text>/g;

    for (const match of body.matchAll(titleBlockPattern)) {
        const label = match[1]
            .replace(/\[([^\]\n]+)\]\([^)]+\)/g, "$1")
            .replace(/<[^>]+>/g, " ")
            .replace(/\s+/g, " ")
            .trim();

        if (!label) {
            continue;
        }

        const baseSlug = slugifySectionTitle(label);
        const nextCount = (slugCounts.get(baseSlug) ?? 0) + 1;
        slugCounts.set(baseSlug, nextCount);

        sections.push({
            id: nextCount === 1 ? baseSlug : `${baseSlug}-${nextCount}`,
            label,
        });
    }

    return sections;
};

const { folder, album } = Astro.params;

// Get all albums and find the matching one by its combined slug
const allAlbums = await getCollection("albums");
const albumEntry = allAlbums.find((a) => a.slug === `${folder}/${album}`);

if (!albumEntry) {
    return Astro.redirect("/404");
}

const albumRecord = await getAlbumBySlug(albumEntry.slug);
if (!albumRecord) {
    throw new Error(`Album manifest record not found: ${albumEntry.slug}`);
}

const folderAlbums = (await getAlbumSummaries())
    .filter((candidate) => candidate.folder === folder)
    .sort((left, right) => left.order - right.order || left.slug.localeCompare(right.slug));
const albumIndex = folderAlbums.findIndex((candidate) => candidate.slug === albumEntry.slug);
const previousAlbum = albumIndex > 0 ? folderAlbums[albumIndex - 1] : undefined;
const nextAlbum = albumIndex >= 0 && albumIndex < folderAlbums.length - 1
    ? folderAlbums[albumIndex + 1]
    : undefined;
Astro.locals.albumPhotoContext = {
    sourceAlbumSlug: albumRecord.slug,
    photos: new Map(albumRecord.photos.map((photo) => [photo.filename, photo])),
};

// Get the Content component from the entry
let Content;
try {
    console.log("Rendering album:", albumEntry.id, "Folder:", folder);
    const rendered = await albumEntry.render();
    Content = rendered.Content;
} catch (e) {
    console.error("Error rendering album:", e);
    throw e;
}

const titleSections = extractTitleSections(albumEntry.body);
---

<Layout title={`${albumRecord.title} - RIVERBED`}>
    <div class="fixed bottom-8 right-8 z-40 flex flex-col gap-3">
        <button
            onclick="window.scrollTo({top: 0, behavior: 'smooth'})"
            class="group text-zinc-500 hover:text-white transition-all duration-300 opacity-0 translate-y-4 pointer-events-none"
            id="back-to-top"
            aria-label="Scroll to top"
        >
            <div
                class="w-8 h-8 rounded-full border border-white/10 flex items-center justify-center group-hover:border-white/30 transition-colors bg-white/20 backdrop-blur-sm"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="m18 15-6-6-6 6"></path></svg
                >
            </div>
        </button>
        <button
            class="album-grid-toggle group text-zinc-500 hover:text-white transition-all duration-300"
            id="toggle-photo-grid"
            aria-label="Show photo grid"
            aria-pressed="false"
            data-active="false"
            type="button"
        >
            <div
                class="w-8 h-8 rounded-full border border-white/10 flex items-center justify-center group-hover:border-white/30 transition-colors bg-white/20 backdrop-blur-sm"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <rect width="7" height="7" x="3" y="3" rx="1"></rect>
                    <rect width="7" height="7" x="14" y="3" rx="1"></rect>
                    <rect width="7" height="7" x="3" y="14" rx="1"></rect>
                    <rect width="7" height="7" x="14" y="14" rx="1"></rect>
                </svg>
            </div>
        </button>
        <button
            class="album-tags-toggle group text-zinc-500 hover:text-white transition-all duration-300"
            id="toggle-all-tags"
            aria-label="Toggle all photo tags"
            data-active="false"
            data-visible="false"
            type="button"
        >
            <div
                class="w-8 h-8 rounded-full border border-white/10 flex items-center justify-center group-hover:border-white/30 transition-colors bg-white/20 backdrop-blur-sm"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg
                >
            </div>
        </button>
        <button
            onclick="window.scrollTo({top: document.body.scrollHeight, behavior: 'smooth'})"
            class="group text-zinc-500 hover:text-white transition-all duration-300 opacity-0 translate-y-4 pointer-events-none"
            id="scroll-to-bottom"
            aria-label="Scroll to bottom"
        >
            <div
                class="w-8 h-8 rounded-full border border-white/10 flex items-center justify-center group-hover:border-white/30 transition-colors bg-white/20 backdrop-blur-sm"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="m6 9l6 6 6-6"></path></svg
                >
            </div>
        </button>
    </div>

    <div
        class="album-page relative py-4"
        data-album-page
        data-has-breadcrumb={titleSections.length > 0 ? "true" : undefined}
    >
        {titleSections.length > 0 && (
            <div
                class="pointer-events-none fixed left-8 top-28 z-30 hidden xl:block"
                data-album-breadcrumb-rail
            >
                <nav
                    aria-label="Album sections"
                    class="pointer-events-auto flex max-w-28 flex-col items-start gap-2 text-left"
                >
                    {titleSections.map((section) => (
                        <a
                            href={`#${section.id}`}
                            data-album-breadcrumb={section.id}
                            class="album-breadcrumb-link text-xs uppercase tracking-[0.18em] text-zinc-600 transition-colors duration-200 hover:text-zinc-200"
                        >
                            {section.label}
                        </a>
                    ))}
                </nav>
            </div>
        )}

        <div class="mb-8 text-center">
            <h1
                class="text-xl font-sans tracking-widest uppercase mb-1"
            >
                {albumRecord.title}
            </h1>
            {albumRecord.info && (
                <p class="text-sm text-zinc-500 font-light tracking-wider uppercase">
                    {albumRecord.info}
                </p>
            )}
        </div>

        <article
            class="album-content"
            style={albumRecord.gap ? `--album-block-gap: ${albumRecord.gap}` : undefined}
        >
            <Content components={{ Row, Photo: AlbumPhoto, Text, PhotoCarousel }} />
        </article>

        <AlbumPagination previous={previousAlbum} next={nextAlbum} />
    </div>
</Layout>

<style>
    /*
     * Keep the fixed breadcrumb rail separate from album media. Near the xl
     * breakpoint the centred layout reaches into that rail; browser zoom can
     * put the page in exactly that range. Reserve only the space needed to
     * keep album content to the right of the 10rem boundary.
     */
    @media (min-width: 1280px) {
        .album-page[data-has-breadcrumb="true"] {
            padding-left: clamp(
                0px,
                calc(42.375rem - 50vw),
                2.5rem
            );
        }
    }

    .album-content {
        width: 100%;
        /*
         * Keep blocks in normal flow so adjacent vertical margins collapse to
         * the larger value instead of being added together. flow-root keeps
         * the first/last child margins contained by the album.
         */
        display: flow-root;
    }

    /* Apply the gap to all blocks except the last one */
    .album-content > :global(*) {
        margin-bottom: var(--album-block-gap, 0.5rem);
    }

    .album-content > :global(*:last-child) {
        margin-bottom: 0;
    }

    .album-content :global(h2) {
        font-size: 1.5rem;
        font-weight: 600;
        margin: 2rem 0 1rem;
    }

    .album-content :global(.text-block--title) {
        scroll-margin-top: 7rem;
    }

    .album-content :global(p) {
        margin: 0.5rem 0;
        line-height: 1.6;
    }

    .album-breadcrumb-link[data-active="true"] {
        color: rgba(255, 255, 255, 0.9);
    }

    .album-grid-toggle[data-active="true"] > div {
        background: rgba(37, 99, 235, 0.8);
        color: white;
        border-color: rgba(37, 99, 235, 0.95);
    }

    .album-tags-toggle {
        display: none;
    }

    .album-tags-toggle[data-grid-hidden="true"] {
        display: none !important;
    }

    .album-tags-toggle[data-active="true"] > div {
        background: rgba(37, 99, 235, 0.8);
        color: white;
        border-color: rgba(37, 99, 235, 0.95);
    }

    .album-page[data-grid-active="true"] [data-album-breadcrumb-rail] {
        display: none !important;
    }

    .album-content[data-grid-active="true"] > :global(:not([data-album-photo-grid])) {
        display: none !important;
    }

    .album-content :global(.album-photo-grid) {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
        width: 100%;
    }

    .album-content :global(.album-photo-grid__row) {
        display: flex;
        align-items: flex-start;
        gap: 0.3rem;
        width: 100%;
    }

    .album-content :global(.album-photo-grid__row > .photo-container) {
        flex: var(--album-grid-ratio, 1) 1 0% !important;
        min-width: 0;
    }

    .album-content :global(.album-photo-grid__spacer) {
        flex: 1 1 0%;
        min-width: 0;
    }

    .album-content :global(.album-photo-grid .photo-wrapper) {
        aspect-ratio: var(--album-grid-ratio, 1);
        overflow: hidden;
        border-radius: 0;
        background: #1a1a1a;
    }

    .album-content :global(.album-photo-grid .pswp-link) {
        width: 100%;
        height: 100%;
    }

    .album-content :global(.album-photo-grid .photo-img) {
        width: 100%;
        height: 100% !important;
        object-fit: contain;
        border-radius: 0 !important;
    }

    .album-content :global(.album-photo-grid .tags-overlay),
    .album-content :global(.album-photo-grid .photo-caption) {
        display: none !important;
    }

    .album-content :global(.album-photo-grid [data-photo-lightbox-link]) {
        cursor: pointer;
    }

    @media (max-width: 768px) and (hover: none) {
        .album-tags-toggle[data-visible="true"] {
            display: block;
        }
    }

    @media (max-width: 767px) {
        .album-content :global(.album-photo-grid) {
            gap: 2px;
        }

        .album-content :global(.album-photo-grid__row) {
            gap: 2px;
        }
    }
</style>

<script>
    import { installPageLifecycle } from "../../lib/client-page-lifecycle";

    let areAllTagsVisible = false;

    const slugifySectionTitle = (value: string) => value
        .toLowerCase()
        .normalize("NFKD")
        .replace(/[\u0300-\u036f]/g, "")
        .replace(/[^a-z0-9\s-]/g, "")
        .trim()
        .replace(/\s+/g, "-") || "section";

    const initAlbumBreadcrumbs = () => {
        const titleNodes = Array.from(document.querySelectorAll(".album-content .text-block--title"));
        const breadcrumbLinks = Array.from(document.querySelectorAll("[data-album-breadcrumb]"));

        if (titleNodes.length === 0 || breadcrumbLinks.length === 0) {
            return;
        }

        const slugCounts = new Map();

        titleNodes.forEach((node, index) => {
            const label = node.textContent?.replace(/\s+/g, " ").trim() || `section-${index + 1}`;
            const baseSlug = slugifySectionTitle(label);
            const nextCount = (slugCounts.get(baseSlug) ?? 0) + 1;
            slugCounts.set(baseSlug, nextCount);

            node.id = nextCount === 1 ? baseSlug : `${baseSlug}-${nextCount}`;
        });

        const updateActiveBreadcrumb = (activeId: string) => {
            breadcrumbLinks.forEach((link) => {
                const isActive = link.getAttribute("data-album-breadcrumb") === activeId;
                link.toggleAttribute("data-active", isActive);
                link.setAttribute("aria-current", isActive ? "true" : "false");
            });
        };

        const breadcrumbObserver = new IntersectionObserver(
            (entries) => {
                const visibleEntry = entries
                    .filter((entry) => entry.isIntersecting)
                    .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

                if (visibleEntry?.target instanceof HTMLElement) {
                    updateActiveBreadcrumb(visibleEntry.target.id);
                }
            },
            {
                rootMargin: "-20% 0px -60% 0px",
                threshold: [0.2, 0.6, 1],
            }
        );

        titleNodes.forEach((node) => breadcrumbObserver?.observe(node));
        if (titleNodes[0] instanceof HTMLElement) {
            updateActiveBreadcrumb(titleNodes[0].id);
        }
        return breadcrumbObserver;
    };

    const syncAlbumTagToggle = () => {
        const toggleButton = document.getElementById("toggle-all-tags") as HTMLButtonElement | null;
        if (!toggleButton) return;

        const wrappers = Array.from(document.querySelectorAll(".photo-wrapper[data-has-tags='true']")) as HTMLElement[];
        const hasTags = wrappers.length > 0;

        toggleButton.dataset.visible = hasTags ? "true" : "false";
        if (!hasTags) {
            areAllTagsVisible = false;
            toggleButton.dataset.active = "false";
            return;
        }

        wrappers.forEach((wrapper) => {
            wrapper.classList.toggle("show-info", areAllTagsVisible);
        });
        toggleButton.dataset.active = areAllTagsVisible ? "true" : "false";
    };

    const initAlbumTagToggle = (signal: AbortSignal) => {
        const toggleButton = document.getElementById("toggle-all-tags") as HTMLButtonElement | null;
        if (!toggleButton) return;

        toggleButton.addEventListener("click", (event) => {
            event.preventDefault();
            areAllTagsVisible = !areAllTagsVisible;
            syncAlbumTagToggle();
        }, { signal });

        syncAlbumTagToggle();
    };

    const initAlbumPhotoGrid = (signal: AbortSignal) => {
        const page = document.querySelector<HTMLElement>("[data-album-page]");
        const article = page?.querySelector<HTMLElement>(".album-content");
        const toggleButton = document.getElementById(
            "toggle-photo-grid",
        ) as HTMLButtonElement | null;
        const tagToggleButton = document.getElementById(
            "toggle-all-tags",
        ) as HTMLButtonElement | null;
        if (!page || !article || !toggleButton) return;

        const photos = Array.from(
            article.querySelectorAll<HTMLElement>(".photo-container"),
        );
        if (photos.length === 0) {
            toggleButton.hidden = true;
            return;
        }

        const mobileQuery = window.matchMedia("(max-width: 767px)");
        const placeholders = new Map<HTMLElement, Comment>();
        let grid: HTMLElement | undefined;
        let gridActive = false;
        let readingScrollY = 0;
        let scrollFrame: number | undefined;
        let scrollFollowFrame: number | undefined;
        let scrollFollowDelay: number | undefined;
        let scrollFollowTimer: number | undefined;
        let scrollObserver: ResizeObserver | undefined;

        const stopScrollTracking = () => {
            if (scrollFrame !== undefined) cancelAnimationFrame(scrollFrame);
            if (scrollFollowFrame !== undefined) {
                cancelAnimationFrame(scrollFollowFrame);
            }
            if (scrollFollowDelay !== undefined) {
                window.clearTimeout(scrollFollowDelay);
            }
            if (scrollFollowTimer !== undefined) {
                window.clearTimeout(scrollFollowTimer);
            }
            scrollObserver?.disconnect();
            scrollFrame = undefined;
            scrollFollowFrame = undefined;
            scrollFollowDelay = undefined;
            scrollFollowTimer = undefined;
            scrollObserver = undefined;
        };

        const targetScrollTop = (photo: HTMLElement) => {
            const rect = photo.getBoundingClientRect();
            const navigation = document.querySelector<HTMLElement>(
                "[data-site-navigation]",
            );
            const navigationBottom = Math.max(
                0,
                navigation?.getBoundingClientRect().bottom ?? 0,
            );
            const topInset = Math.max(16, navigationBottom + 16);
            const availableHeight = Math.max(
                0,
                window.innerHeight - topInset - 16,
            );
            const offset = rect.height < availableHeight
                ? (availableHeight - rect.height) / 2
                : 0;
            return Math.max(
                0,
                window.scrollY + rect.top - topInset - offset,
            );
        };

        const scrollInstantly = (top: number) => {
            const root = document.documentElement;
            const previousBehavior = root.style.scrollBehavior;
            root.style.scrollBehavior = "auto";
            window.scrollTo({ top, behavior: "auto" });
            root.style.scrollBehavior = previousBehavior;
        };

        const followPhotoPosition = (photo: HTMLElement) => {
            stopScrollTracking();
            window.scrollTo({
                top: targetScrollTop(photo),
                behavior: "smooth",
            });

            scrollFollowDelay = window.setTimeout(() => {
                const keepPhotoPositioned = () => {
                    if (scrollFollowFrame !== undefined) return;
                    scrollFollowFrame = requestAnimationFrame(() => {
                        scrollFollowFrame = undefined;
                        scrollInstantly(targetScrollTop(photo));
                    });
                };

                scrollObserver = new ResizeObserver(keepPhotoPositioned);
                scrollObserver.observe(article);
                keepPhotoPositioned();
                scrollFollowTimer = window.setTimeout(
                    stopScrollTracking,
                    1400,
                );
            }, 450);
        };

        const syncGridRatio = (photo: HTMLElement) => {
            const image = photo.querySelector<HTMLImageElement>(".photo-img");
            if (!image?.naturalWidth || !image.naturalHeight) return;
            photo.style.setProperty(
                "--album-grid-ratio",
                String(image.naturalWidth / image.naturalHeight),
            );
        };

        photos.forEach((photo) => {
            const image = photo.querySelector<HTMLImageElement>(".photo-img");
            if (!image) return;
            if (image.complete) syncGridRatio(photo);
            image.addEventListener("load", () => syncGridRatio(photo), {
                signal,
            });
        });

        const renderGridRows = () => {
            if (!grid) return;
            const photosPerRow = mobileQuery.matches ? 3 : 5;
            const rows: HTMLElement[] = [];

            for (let index = 0; index < photos.length; index += photosPerRow) {
                const row = document.createElement("div");
                row.className = "album-photo-grid__row";
                row.dataset.keyboardNavigationTarget = "";
                const chunk = photos.slice(index, index + photosPerRow);
                row.append(...chunk);

                if (!mobileQuery.matches && chunk.length < photosPerRow) {
                    for (
                        let spacerIndex = chunk.length;
                        spacerIndex < photosPerRow;
                        spacerIndex += 1
                    ) {
                        const spacer = document.createElement("span");
                        spacer.className = "album-photo-grid__spacer";
                        spacer.setAttribute("aria-hidden", "true");
                        row.append(spacer);
                    }
                }
                rows.push(row);
            }
            grid.replaceChildren(...rows);
        };

        const syncGridControls = () => {
            toggleButton.dataset.active = gridActive ? "true" : "false";
            toggleButton.setAttribute(
                "aria-pressed",
                gridActive ? "true" : "false",
            );
            toggleButton.setAttribute(
                "aria-label",
                gridActive ? "Return to album layout" : "Show photo grid",
            );
            if (tagToggleButton) {
                tagToggleButton.dataset.gridHidden = gridActive
                    ? "true"
                    : "false";
            }
        };

        const restoreAlbumLayout = (
            targetPhoto?: HTMLElement,
            restoreScroll = true,
        ) => {
            if (!gridActive) return;
            gridActive = false;

            photos.forEach((photo) => {
                const placeholder = placeholders.get(photo);
                placeholder?.parentNode?.insertBefore(photo, placeholder);
                placeholder?.remove();
                photo.style.removeProperty("--album-grid-ratio");
            });
            placeholders.clear();
            grid?.remove();
            grid = undefined;
            article.removeAttribute("data-grid-active");
            page.removeAttribute("data-grid-active");
            syncGridControls();

            if (!restoreScroll) return;
            scrollFrame = requestAnimationFrame(() => {
                scrollFrame = requestAnimationFrame(() => {
                    scrollFrame = undefined;
                    if (targetPhoto) {
                        followPhotoPosition(targetPhoto);
                    } else {
                        window.scrollTo({
                            top: readingScrollY,
                            behavior: "smooth",
                        });
                    }
                });
            });
        };

        const showPhotoGrid = () => {
            if (gridActive) return;
            stopScrollTracking();
            readingScrollY = window.scrollY;
            gridActive = true;
            grid = document.createElement("div");
            grid.className = "album-photo-grid";
            grid.dataset.albumPhotoGrid = "";

            photos.forEach((photo) => {
                const placeholder = document.createComment("album-photo-grid");
                photo.parentNode?.insertBefore(placeholder, photo);
                placeholders.set(photo, placeholder);
                syncGridRatio(photo);
            });

            renderGridRows();
            article.append(grid);
            article.dataset.gridActive = "true";
            page.dataset.gridActive = "true";
            syncGridControls();
            window.scrollTo({ top: 0, behavior: "smooth" });
        };

        toggleButton.addEventListener("click", () => {
            if (gridActive) restoreAlbumLayout();
            else showPhotoGrid();
        }, { signal });

        article.addEventListener("click", (event) => {
            if (!gridActive || !grid) return;
            const eventTarget = event.target instanceof Element
                ? event.target
                : null;
            const link = eventTarget?.closest<HTMLAnchorElement>(
                "[data-photo-lightbox-link]",
            );
            const targetPhoto = link?.closest<HTMLElement>(".photo-container");
            if (!link || !targetPhoto || !grid.contains(targetPhoto)) return;

            event.preventDefault();
            event.stopPropagation();
            restoreAlbumLayout(targetPhoto);
        }, { capture: true, signal });

        mobileQuery.addEventListener("change", () => {
            if (gridActive) renderGridRows();
        }, { signal });

        syncGridControls();

        return () => {
            stopScrollTracking();
            restoreAlbumLayout(undefined, false);
            photos.forEach((photo) => {
                photo.style.removeProperty("--album-grid-ratio");
            });
            toggleButton.hidden = false;
            toggleButton.dataset.active = "false";
            toggleButton.setAttribute("aria-pressed", "false");
            toggleButton.setAttribute("aria-label", "Show photo grid");
            if (tagToggleButton) {
                tagToggleButton.dataset.gridHidden = "false";
            }
        };
    };

    const handleScroll = () => {
        const backToTop = document.getElementById("back-to-top");
        const scrollToBottom = document.getElementById("scroll-to-bottom");

        if (backToTop) {
            if (window.scrollY > 300) {
                backToTop.classList.remove("opacity-0", "translate-y-4", "pointer-events-none");
                backToTop.classList.add("opacity-100", "translate-y-0", "pointer-events-auto");
            } else {
                backToTop.classList.add("opacity-0", "translate-y-4", "pointer-events-none");
                backToTop.classList.remove("opacity-100", "translate-y-0", "pointer-events-auto");
            }
        }

        if (scrollToBottom) {
            const isNearBottom = (window.scrollY + window.innerHeight) >= (document.documentElement.scrollHeight - 300);
            if (!isNearBottom) {
                scrollToBottom.classList.remove("opacity-0", "translate-y-4", "pointer-events-none");
                scrollToBottom.classList.add("opacity-100", "translate-y-0", "pointer-events-auto");
            } else {
                scrollToBottom.classList.add("opacity-0", "translate-y-4", "pointer-events-none");
                scrollToBottom.classList.remove("opacity-100", "translate-y-0", "pointer-events-auto");
            }
        }
    };

    installPageLifecycle(document, () => {
        const page = document.querySelector<HTMLElement>(
            "[data-album-page]",
        );
        if (!page) return;

        const controller = new AbortController();
        areAllTagsVisible = false;
        const breadcrumbObserver = initAlbumBreadcrumbs();
        initAlbumTagToggle(controller.signal);
        const cleanupPhotoGrid = initAlbumPhotoGrid(controller.signal);
        handleScroll();
        window.addEventListener("scroll", handleScroll, {
            passive: true,
            signal: controller.signal,
        });

        return () => {
            controller.abort();
            breadcrumbObserver?.disconnect();
            cleanupPhotoGrid?.();
            areAllTagsVisible = false;
        };
    });
</script>
