<script>
    import { installPageLifecycle } from "../lib/client-page-lifecycle";

    // The pageable block with the most on-screen height, if at least half of it
    // (or half the viewport, for blocks taller than the screen) is visible.
    const findMainPager = (navbarHeight: number) => {
        const viewportHeight = window.innerHeight - navbarHeight;
        let best: HTMLElement | null = null;
        let bestVisible = 0;
        document
            .querySelectorAll<HTMLElement>("[data-carousel], [data-photo-panorama]")
            .forEach((section) => {
                const rect = section.getBoundingClientRect();
                if (rect.height === 0) return;
                const visible = Math.min(rect.bottom, window.innerHeight) - Math.max(rect.top, navbarHeight);
                if (visible < Math.min(rect.height, viewportHeight) / 2) return;
                if (visible > bestVisible) {
                    best = section;
                    bestVisible = visible;
                }
            });
        return best as HTMLElement | null;
    };

    installPageLifecycle(document, () => {
        const controller = new AbortController();

        window.addEventListener("keydown", (e) => {
            if (
                e.key !== "ArrowRight" &&
                e.key !== "ArrowLeft" &&
                e.key !== "ArrowDown" &&
                e.key !== "ArrowUp"
            )
                return;

            const eventElement = e.target instanceof Element ? e.target : null;
            if (
                eventElement?.closest(
                    "dialog, input, textarea, select, [role='textbox']",
                )
            ) {
                return;
            }

            const editableElement = eventElement instanceof HTMLElement
                ? eventElement
                : eventElement?.parentElement;
            if (editableElement?.isContentEditable) return;

            const navbarHeight = 110;

            // Left/Right page the carousel or panorama filling the screen; Up/Down
            // (and Left/Right when nothing can page) keep jumping between blocks.
            if (
                (e.key === "ArrowLeft" || e.key === "ArrowRight") &&
                !e.altKey && !e.metaKey && !e.ctrlKey &&
                !document.querySelector(".pswp--open")
            ) {
                const pager = findMainPager(navbarHeight);
                const pageEvent = new CustomEvent("keyboard-page", {
                    cancelable: true,
                    detail: { direction: e.key === "ArrowRight" ? 1 : -1 },
                });
                // The component cancels the event when it handles the page turn.
                if (pager && !pager.dispatchEvent(pageEvent)) {
                    e.preventDefault();
                    return;
                }
            }

            const targets = Array.from(
                document.querySelectorAll<HTMLElement>(
                    "[data-keyboard-navigation-target]",
                ),
            ).filter((target) => target.getClientRects().length > 0);
            if (targets.length === 0) return;

            const scrollPadding = 20;
            const currentPos = window.scrollY + navbarHeight + scrollPadding;

            const nextIndex = targets.findIndex((t) => {
                const rect = t.getBoundingClientRect();
                return window.scrollY + rect.top > currentPos;
            });

            let target;
            if (e.key === "ArrowRight" || e.key === "ArrowDown") {
                if (nextIndex !== -1) target = targets[nextIndex];
            } else if (e.key === "ArrowLeft" || e.key === "ArrowUp") {
                const currentIndex = nextIndex === -1 ? targets.length : nextIndex;
                if (currentIndex > 1) {
                    target = targets[currentIndex - 2];
                } else if (currentIndex === 1) {
                    window.scrollTo({ top: 0, behavior: "smooth" });
                    return;
                }
            }

            if (target) {
                const targetTop = window.scrollY + target.getBoundingClientRect().top - navbarHeight + 10;
                window.scrollTo({ top: targetTop, behavior: "smooth" });
                e.preventDefault();
            }
        }, { signal: controller.signal });

        return () => {
            controller.abort();
        };
    });
</script>
