---
import MountainMap from "./MountainMap.astro";
import {
    buildPeakFinderEmbedUrl,
    type PeakFinderPanorama,
} from "../lib/mountain-panorama";
import type { MapBounds, MapContextId } from "../lib/mountain-map";

interface Props {
    latitude: number;
    longitude: number;
    contextId: MapContextId;
    mountainName: string;
    elevation: number | null;
    panorama?: PeakFinderPanorama;
    initialBounds?: MapBounds;
    peakFinderEnabled?: boolean;
}

const {
    latitude,
    longitude,
    contextId,
    mountainName,
    elevation,
    panorama,
    initialBounds,
    peakFinderEnabled = true,
} = Astro.props;
const hasPanorama = peakFinderEnabled && panorama?.provider === "peakfinder";
const panoramaUrl = hasPanorama
    ? buildPeakFinderEmbedUrl({
          latitude,
          longitude,
          mountainName,
          elevation,
          panorama,
      })
    : null;
const viewerId = `mountain-viewer-${contextId}`;
const locationTabId = `${viewerId}-location-tab`;
const locationPanelId = `${viewerId}-location-panel`;
const panoramaTabId = `${viewerId}-panorama-tab`;
const panoramaPanelId = `${viewerId}-panorama-panel`;
---

<section
    class="mountain-viewer"
    data-mountain-viewer
    data-initialized="false"
    aria-label={`${mountainName}位置與視野`}
>
    {
        hasPanorama && (
            <div
                class="mountain-viewer__tabs"
                role="tablist"
                aria-label={`${mountainName}顯示方式`}
            >
                <button
                    id={locationTabId}
                    class="mountain-viewer__tab"
                    type="button"
                    role="tab"
                    aria-selected="true"
                    aria-controls={locationPanelId}
                    data-viewer-tab="location"
                >
                    位置
                </button>
                <button
                    id={panoramaTabId}
                    class="mountain-viewer__tab"
                    type="button"
                    role="tab"
                    aria-selected="false"
                    aria-controls={panoramaPanelId}
                    tabindex="-1"
                    data-viewer-tab="panorama"
                >
                    視野
                </button>
            </div>
        )
    }

    <div
        id={locationPanelId}
        class="mountain-viewer__panel"
        role={hasPanorama ? "tabpanel" : undefined}
        aria-labelledby={hasPanorama ? locationTabId : undefined}
        data-viewer-panel="location"
    >
        <MountainMap
            latitude={latitude}
            longitude={longitude}
            contextId={contextId}
            mountainName={mountainName}
            initialBounds={initialBounds}
        />
    </div>

    {
        panoramaUrl && (
            <div
                id={panoramaPanelId}
                class="mountain-viewer__panel"
                role="tabpanel"
                aria-labelledby={panoramaTabId}
                data-viewer-panel="panorama"
                hidden
            >
                <div class="mountain-viewer__panorama-shell">
                    <iframe
                        class="mountain-viewer__panorama"
                        data-peakfinder-src={panoramaUrl}
                        title={`從${mountainName}眺望的山岳全景`}
                        loading="lazy"
                        allow="fullscreen"
                        allowfullscreen
                        referrerpolicy="strict-origin-when-cross-origin"
                    ></iframe>
                </div>
                <div class="mountain-viewer__footer">
                    <a
                        href={panoramaUrl}
                        target="_blank"
                        rel="noreferrer"
                    >
                        PeakFinder
                    </a>
                </div>
            </div>
        )
    }
</section>

<style>
    .mountain-viewer {
        min-width: 0;
    }

    .mountain-viewer__tabs {
        display: flex;
        justify-content: flex-end;
        gap: 1.25rem;
        min-height: 1.75rem;
        margin-bottom: 0.5rem;
        border-bottom: 1px solid rgb(255 255 255 / 0.07);
    }

    .mountain-viewer__tab {
        position: relative;
        padding: 0 0 0.45rem;
        border: 0;
        background: transparent;
        color: rgb(113 113 122);
        font: inherit;
        font-size: 0.6875rem;
        letter-spacing: 0.12em;
        cursor: pointer;
        transition: color 160ms ease;
    }

    .mountain-viewer__tab::after {
        position: absolute;
        right: 0;
        bottom: -1px;
        left: 0;
        height: 1px;
        background: transparent;
        content: "";
        transition: background-color 160ms ease;
    }

    .mountain-viewer__tab:hover,
    .mountain-viewer__tab[aria-selected="true"] {
        color: rgb(228 228 231);
    }

    .mountain-viewer__tab[aria-selected="true"]::after {
        background: rgb(228 228 231 / 0.72);
    }

    .mountain-viewer__tab:focus-visible {
        outline: 1px solid rgb(255 255 255 / 0.55);
        outline-offset: 3px;
    }

    .mountain-viewer__panel[hidden] {
        display: none;
    }

    .mountain-viewer__panorama-shell {
        overflow: hidden;
        border: 1px solid rgb(255 255 255 / 0.07);
        background: rgb(255 255 255 / 0.012);
    }

    .mountain-viewer__panorama {
        display: block;
        width: 100%;
        border: 0;
        aspect-ratio: 16 / 10;
        background: rgb(24 24 27);
    }

    .mountain-viewer__footer {
        margin-top: 0.5rem;
        color: rgb(82 82 91);
        font-size: 0.5625rem;
        letter-spacing: 0.04em;
        text-align: right;
    }

    .mountain-viewer__footer a {
        color: inherit;
        transition: color 160ms ease;
    }

    .mountain-viewer__footer a:hover {
        color: rgb(161 161 170);
    }
</style>

<script>
    type ViewerMode = "location" | "panorama";

    function initMountainViewers() {
        document
            .querySelectorAll<HTMLElement>("[data-mountain-viewer]")
            .forEach((root) => {
                if (root.dataset.initialized === "true") return;

                const tabs = Array.from(
                    root.querySelectorAll<HTMLButtonElement>("[data-viewer-tab]"),
                );
                const panels = Array.from(
                    root.querySelectorAll<HTMLElement>("[data-viewer-panel]"),
                );

                if (tabs.length === 0) {
                    root.dataset.initialized = "true";
                    return;
                }

                const activate = (mode: ViewerMode, moveFocus = false) => {
                    tabs.forEach((tab) => {
                        const selected = tab.dataset.viewerTab === mode;
                        tab.setAttribute("aria-selected", String(selected));
                        tab.tabIndex = selected ? 0 : -1;
                        if (selected && moveFocus) tab.focus();
                    });

                    panels.forEach((panel) => {
                        panel.hidden = panel.dataset.viewerPanel !== mode;
                    });

                    if (mode === "panorama") {
                        const frame = root.querySelector<HTMLIFrameElement>(
                            "iframe[data-peakfinder-src]",
                        );
                        if (frame && !frame.hasAttribute("src")) {
                            frame.src = frame.dataset.peakfinderSrc ?? "";
                        }
                    }
                };

                tabs.forEach((tab, index) => {
                    tab.addEventListener("click", () => {
                        activate(tab.dataset.viewerTab as ViewerMode);
                    });

                    tab.addEventListener("keydown", (event) => {
                        let nextIndex: number | null = null;
                        if (event.key === "ArrowRight") {
                            nextIndex = (index + 1) % tabs.length;
                        } else if (event.key === "ArrowLeft") {
                            nextIndex = (index - 1 + tabs.length) % tabs.length;
                        } else if (event.key === "Home") {
                            nextIndex = 0;
                        } else if (event.key === "End") {
                            nextIndex = tabs.length - 1;
                        }

                        if (nextIndex === null) return;
                        event.preventDefault();
                        activate(
                            tabs[nextIndex].dataset.viewerTab as ViewerMode,
                            true,
                        );
                    });
                });

                root.dataset.initialized = "true";
            });
    }

    initMountainViewers();
    document.addEventListener("astro:page-load", initMountainViewers);
</script>
