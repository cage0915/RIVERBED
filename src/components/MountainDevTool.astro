---
// DEV-ONLY mountain profile editor. Rendered by Layout.astro in development.
---

<button
    id="dev-mountain-manager-button"
    class="dev-mountain-manager-button"
    type="button"
    title="Mountain Manager"
    aria-label="Open Mountain Manager"
>
    <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="m3 19 6.5-11 3.2 5.2L15.5 9 21 19Z"></path>
        <path d="m7.7 11 1.8 1.5 1.3-1.1"></path>
    </svg>
</button>

<dialog id="dev-mountain-manager" class="dev-mountain-manager">
    <form id="dev-mountain-form" class="dev-mountain-manager__surface">
        <header class="dev-mountain-manager__header">
            <h3>Mountain Manager</h3>
            <div class="dev-mountain-manager__header-actions">
                <button
                    id="dev-mountain-save"
                    class="dev-mountain-icon-button dev-mountain-icon-button--save"
                    type="submit"
                    title="Save Mountain"
                    aria-label="Save Mountain"
                >
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"></path></svg>
                </button>
                <button id="dev-mountain-close" class="dev-mountain-icon-button" type="button" aria-label="Close">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"></path></svg>
                </button>
            </div>
        </header>

        <div class="dev-mountain-manager__body">
            <div class="dev-mountain-manager__form-column">
                <section class="dev-mountain-section" data-preview-target="location">
                    <h3>Basic Data</h3>
                    <div class="dev-mountain-grid dev-mountain-grid--lookup">
                        <label class="dev-mountain-field">
                            <span>Region</span>
                            <select id="dev-mountain-region"></select>
                        </label>
                        <div class="dev-mountain-field">
                            <span>Mountain</span>
                            <div id="dev-mountain-picker" class="dev-mountain-context-picker">
                                <button
                                    id="dev-mountain-trigger"
                                    class="dev-mountain-context-trigger"
                                    type="button"
                                    aria-haspopup="listbox"
                                    aria-expanded="false"
                                    aria-controls="dev-mountain-menu"
                                >
                                    <span id="dev-mountain-trigger-label">Choose a mountain</span>
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 9 5 5 5-5"></path></svg>
                                </button>
                                <div id="dev-mountain-menu" class="dev-mountain-context-menu" role="listbox" hidden></div>
                                <select id="dev-mountain-select" tabindex="-1" aria-hidden="true"></select>
                            </div>
                        </div>
                        <button
                            id="dev-mountain-lookup-button"
                            class="dev-mountain-secondary-button dev-mountain-grid-action"
                            type="button"
                            title="Search Wikidata"
                            aria-label="Search Wikidata"
                        >
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <circle cx="11" cy="11" r="6"></circle>
                                <path d="m16 16 4 4"></path>
                            </svg>
                        </button>
                    </div>
                    <div id="dev-mountain-lookup-status" class="dev-mountain-help"></div>
                    <div id="dev-mountain-candidates" class="dev-mountain-candidates"></div>
                    <div class="dev-mountain-grid dev-mountain-grid--location">
                        <label class="dev-mountain-field">
                            <span>Elevation (m)</span>
                            <input id="dev-mountain-elevation" type="number" min="-500" max="9000" step="1" />
                        </label>
                        <label class="dev-mountain-field">
                            <span>Latitude</span>
                            <input id="dev-mountain-latitude" type="number" min="-90" max="90" step="0.000001" />
                        </label>
                        <label class="dev-mountain-field">
                            <span>Longitude</span>
                            <input id="dev-mountain-longitude" type="number" min="-180" max="180" step="0.000001" />
                        </label>
                        <button
                            id="dev-mountain-refresh-location"
                            class="dev-mountain-secondary-button dev-mountain-grid-action"
                            type="button"
                            title="Refresh Location Preview"
                            aria-label="Refresh Location Preview"
                        >
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M20 6v5h-5M4 18v-5h5"></path>
                                <path d="M6.2 9a7 7 0 0 1 11.5-2.6L20 9M4 15l2.3 2.6A7 7 0 0 0 17.8 15"></path>
                            </svg>
                        </button>
                    </div>
                    <label class="dev-mountain-field">
                        <span>Description</span>
                        <textarea id="dev-mountain-description" rows="4"></textarea>
                    </label>
                    <p id="dev-mountain-source" class="dev-mountain-help"></p>
                    <p class="dev-mountain-help">
                        Refresh the location preview before saving. Click <strong>Save</strong> in the header to write elevation, coordinates, and description to the selected region file.
                    </p>
                </section>

                <section class="dev-mountain-section" data-preview-target="location">
                    <h3>Map Context</h3>
                    <div class="dev-mountain-field">
                        <span>Context</span>
                        <div id="dev-mountain-context-picker" class="dev-mountain-context-picker">
                            <button
                                id="dev-mountain-context-trigger"
                                class="dev-mountain-context-trigger"
                                type="button"
                                aria-haspopup="listbox"
                                aria-expanded="false"
                                aria-controls="dev-mountain-context-menu"
                            >
                                <span id="dev-mountain-context-trigger-label">Choose a context</span>
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 9 5 5 5-5"></path></svg>
                            </button>
                            <div id="dev-mountain-context-menu" class="dev-mountain-context-menu" role="listbox" hidden></div>
                            <select id="dev-mountain-context" tabindex="-1" aria-hidden="true"></select>
                        </div>
                    </div>
                    <div class="dev-mountain-context-editor">
                        <div class="dev-mountain-grid dev-mountain-grid--context">
                            <label class="dev-mountain-field">
                                <span>Context ID</span>
                                <input id="dev-mountain-new-context-id" type="text" placeholder="jp-hakuba-area" pattern="[a-z0-9][a-z0-9-]+" />
                            </label>
                            <label class="dev-mountain-field">
                                <span>Display Name</span>
                                <input id="dev-mountain-new-context-label" type="text" placeholder="Hakuba Area" />
                            </label>
                            <button
                                id="dev-mountain-save-context"
                                class="dev-mountain-secondary-button dev-mountain-grid-action"
                                type="button"
                                title="Update Range"
                                aria-label="Update Range"
                            >
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M5 4h12l2 2v14H5zM8 4v6h8V4M8 20v-6h8v6"></path>
                                </svg>
                            </button>
                        </div>
                        <p id="dev-mountain-context-help" class="dev-mountain-help">
                            Edit the fields and map viewport, then update this context.
                        </p>
                    </div>
                </section>

                <section class="dev-mountain-section" data-preview-target="panorama">
                    <label class="dev-mountain-check">
                        <input id="dev-mountain-panorama-enabled" type="checkbox" checked />
                        <span>Enable PeakFinder Panorama</span>
                    </label>
                    <div id="dev-mountain-panorama-fields" class="dev-mountain-panorama-fields" hidden>
                        <div class="dev-mountain-grid dev-mountain-grid--panorama">
                            <label class="dev-mountain-field">
                                <span>Azimuth (azi)</span>
                                <input id="dev-mountain-azimuth" type="number" min="0" max="360" step="1" placeholder="Default" />
                            </label>
                            <label class="dev-mountain-field">
                                <span>Altitude (alt)</span>
                                <input id="dev-mountain-altitude" type="number" min="-25" max="25" step="0.5" placeholder="Default" />
                            </label>
                            <label class="dev-mountain-field">
                                <span>Field of View (fov)</span>
                                <input id="dev-mountain-fov" type="number" min="8" max="90" step="1" placeholder="Default" />
                            </label>
                            <button
                                id="dev-mountain-refresh-panorama"
                                class="dev-mountain-secondary-button dev-mountain-grid-action"
                                type="button"
                                title="Refresh Panorama Preview"
                                aria-label="Refresh Panorama Preview"
                            >
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M20 6v5h-5M4 18v-5h5"></path>
                                    <path d="M6.2 9a7 7 0 0 1 11.5-2.6L20 9M4 15l2.3 2.6A7 7 0 0 0 17.8 15"></path>
                                </svg>
                            </button>
                        </div>
                        <p class="dev-mountain-help">Changes made inside the iframe cannot be read back. Adjust the values above, then refresh the preview.</p>
                    </div>
                </section>
            </div>

            <div class="dev-mountain-manager__preview-column">
                <section class="dev-mountain-preview-card dev-mountain-preview-viewer">
                    <div class="dev-mountain-preview-toolbar">
                        <strong id="dev-mountain-map-label">—</strong>
                        <div class="dev-mountain-preview-tabs" role="tablist" aria-label="Preview mode">
                            <button
                                id="dev-mountain-location-tab"
                                type="button"
                                role="tab"
                                aria-selected="true"
                                aria-controls="dev-mountain-location-panel"
                                data-preview-tab="location"
                            >Location</button>
                            <button
                                id="dev-mountain-panorama-tab"
                                type="button"
                                role="tab"
                                aria-selected="false"
                                aria-controls="dev-mountain-panorama-panel"
                                data-preview-tab="panorama"
                                disabled
                            >Panorama</button>
                        </div>
                    </div>

                    <div
                        id="dev-mountain-location-panel"
                        role="tabpanel"
                        aria-labelledby="dev-mountain-location-tab"
                        data-preview-panel="location"
                    >
                        <div id="dev-mountain-map-shell" class="dev-mountain-map-shell">
                            <svg id="dev-mountain-map" viewBox="0 0 100 100" aria-label="Location map editor preview">
                                <g id="dev-mountain-map-features" aria-hidden="true"></g>
                                <g id="dev-mountain-map-marker" aria-hidden="true">
                                    <circle class="dev-mountain-map-marker-halo" r="3"></circle>
                                    <circle class="dev-mountain-map-marker-core" r="1.25"></circle>
                                </g>
                            </svg>
                        </div>
                        <div id="dev-mountain-no-map" class="dev-mountain-no-map" hidden>
                            <strong>No Map Context</strong>
                            <span>Choose a valid context to restore the location map.</span>
                        </div>
                        <p id="dev-mountain-bounds-output" class="dev-mountain-bounds-output"></p>
                    </div>

                    <div
                        id="dev-mountain-panorama-panel"
                        role="tabpanel"
                        aria-labelledby="dev-mountain-panorama-tab"
                        data-preview-panel="panorama"
                        hidden
                    >
                        <div class="dev-mountain-panorama-shell">
                            <iframe
                                id="dev-mountain-panorama-preview"
                                title="PeakFinder editor preview"
                                allow="fullscreen"
                                referrerpolicy="strict-origin-when-cross-origin"
                            ></iframe>
                        </div>
                    </div>
                </section>
            </div>
        </div>

        <footer class="dev-mountain-manager__footer">
            <span id="dev-mountain-save-status"></span>
        </footer>
    </form>
</dialog>

<style is:global>
    .dev-mountain-manager-button {
        position: fixed;
        right: 2rem;
        bottom: 7.5rem;
        z-index: 60;
        display: grid;
        width: 2rem;
        height: 2rem;
        padding: 0;
        place-items: center;
        border: 1px solid rgb(255 255 255 / 0.1);
        border-radius: 999px;
        background: rgb(255 255 255 / 0.2);
        color: rgb(161 161 170 / 0.8);
        backdrop-filter: blur(4px);
        cursor: pointer;
        transition: 180ms ease;
    }

    .dev-mountain-manager-button:hover {
        border-color: rgb(255 255 255 / 0.3);
        background: rgb(16 185 129 / 0.8);
        color: white;
    }

    .dev-mountain-manager-button svg,
    .dev-mountain-icon-button svg {
        width: 1.1rem;
        fill: none;
        stroke: currentColor;
        stroke-linecap: round;
        stroke-linejoin: round;
        stroke-width: 1.7;
    }

    .dev-mountain-manager {
        width: min(1180px, 94vw);
        max-width: none;
        height: min(860px, 90vh);
        max-height: none;
        padding: 0;
        overflow: hidden;
        border: 0;
        border-radius: 12px;
        background: #f8fafc;
        box-shadow: 0 24px 80px rgb(0 0 0 / 0.55);
        color: #0f172a;
        font-family: "Noto Sans TC", "Noto Sans JP", sans-serif;
    }

    .dev-mountain-manager::backdrop {
        background: rgb(0 0 0 / 0.72);
        backdrop-filter: blur(5px);
    }

    .dev-mountain-manager__surface {
        display: grid;
        height: 100%;
        grid-template-rows: auto minmax(0, 1fr) auto;
    }

    .dev-mountain-manager__header,
    .dev-mountain-manager__footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 1.35rem;
        border-color: #e2e8f0;
        background: white;
    }

    .dev-mountain-manager__header {
        border-bottom: 1px solid #e2e8f0;
        background: #fafafa;
    }
    .dev-mountain-manager__footer { border-top: 1px solid #e2e8f0; }

    .dev-mountain-manager__header-actions {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .dev-mountain-manager__header h3 {
        margin: 0;
        color: #333;
        font-size: 1rem;
        font-weight: 600;
    }

    .dev-mountain-preview-card__header p {
        margin: 0;
        color: #94a3b8;
        font-size: 0.625rem;
        letter-spacing: 0.16em;
    }

    .dev-mountain-icon-button {
        display: grid;
        width: 2rem;
        height: 2rem;
        padding: 0;
        place-items: center;
        border: 0;
        border-radius: 6px;
        background: transparent;
        color: #64748b;
        cursor: pointer;
    }

    .dev-mountain-icon-button:hover { background: #f1f5f9; color: #0f172a; }

    .dev-mountain-icon-button--save {
        border: 1px solid #198754;
        background: #198754;
        color: #fff;
    }

    .dev-mountain-icon-button--save:hover {
        border-color: #146c43;
        background: #157347;
        color: #fff;
    }

    .dev-mountain-manager__body {
        display: grid;
        min-height: 0;
        grid-template-columns: minmax(340px, 0.78fr) minmax(460px, 1.22fr);
        overflow: hidden;
    }

    .dev-mountain-manager__form-column,
    .dev-mountain-manager__preview-column {
        min-height: 0;
        padding: 1.15rem;
        overflow-y: auto;
    }

    .dev-mountain-manager__form-column { border-right: 1px solid #e2e8f0; }
    .dev-mountain-manager__preview-column { background: #eef2f7; }

    .dev-mountain-section,
    .dev-mountain-preview-card {
        padding: 1rem;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        background: white;
    }

    .dev-mountain-section + .dev-mountain-section,
    .dev-mountain-preview-card + .dev-mountain-preview-card { margin-top: 0.9rem; }

    .dev-mountain-section h3 {
        margin: 0 0 0.75rem;
        color: #334155;
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.04em;
    }

    .dev-mountain-section__heading,
    .dev-mountain-preview-card__header,
    .dev-mountain-actions,
    .dev-mountain-check {
        display: flex;
        align-items: center;
    }

    .dev-mountain-section__heading,
    .dev-mountain-preview-card__header { justify-content: space-between; }
    .dev-mountain-section__heading h3 { margin-bottom: 0; }
    .dev-mountain-actions { gap: 0.5rem; }

    .dev-mountain-grid {
        display: grid;
        gap: 0.65rem;
    }

    .dev-mountain-grid--lookup { grid-template-columns: minmax(0, 0.65fr) minmax(0, 1.35fr) 2.25rem; }
    .dev-mountain-grid--location { grid-template-columns: minmax(0, 0.72fr) repeat(2, minmax(0, 1fr)) 2.25rem; }
    .dev-mountain-grid--context { grid-template-columns: repeat(2, minmax(0, 1fr)) 2.25rem; }
    .dev-mountain-grid--panorama { grid-template-columns: repeat(3, minmax(0, 1fr)) 2.25rem; }

    .dev-mountain-field {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
        margin-top: 0.7rem;
        color: #64748b;
        font-size: 0.7rem;
    }

    .dev-mountain-field:first-child { margin-top: 0; }
    .dev-mountain-grid > .dev-mountain-field { margin-top: 0; }

    .dev-mountain-help strong { color: #64748b; font-weight: 600; }

    .dev-mountain-field input,
    .dev-mountain-field select,
    .dev-mountain-field textarea {
        width: 100%;
        box-sizing: border-box;
        padding: 0.5rem 0.6rem;
        border: 1px solid #cbd5e1;
        border-radius: 5px;
        background: white;
        color: #0f172a;
        font: inherit;
        font-size: 0.78rem;
    }

    .dev-mountain-field textarea { resize: vertical; line-height: 1.55; }

    .dev-mountain-secondary-button,
    .dev-mountain-primary-button {
        padding: 0.5rem 0.75rem;
        border-radius: 5px;
        font: inherit;
        font-size: 0.72rem;
        cursor: pointer;
    }

    .dev-mountain-secondary-button {
        border: 1px solid #cbd5e1;
        background: white;
        color: #475569;
    }

    .dev-mountain-secondary-button:hover { border-color: #64748b; color: #0f172a; }
    .dev-mountain-secondary-button:disabled { opacity: 0.5; cursor: wait; }

    .dev-mountain-grid-action {
        display: grid;
        width: 2.25rem;
        height: 2.25rem;
        padding: 0;
        align-self: end;
        place-items: center;
    }

    .dev-mountain-grid-action svg {
        width: 1rem;
        height: 1rem;
        fill: none;
        stroke: currentColor;
        stroke-linecap: round;
        stroke-linejoin: round;
        stroke-width: 1.7;
    }

    .dev-mountain-context-picker {
        position: relative;
    }

    .dev-mountain-context-picker > select { display: none; }

    .dev-mountain-context-trigger {
        display: flex;
        width: 100%;
        min-height: 2.25rem;
        box-sizing: border-box;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        padding: 0.5rem 0.6rem;
        border: 1px solid #cbd5e1;
        border-radius: 5px;
        background: white;
        color: #0f172a;
        font: inherit;
        font-size: 0.78rem;
        text-align: left;
        cursor: pointer;
    }

    .dev-mountain-context-trigger:hover,
    .dev-mountain-context-trigger[aria-expanded="true"] { border-color: #64748b; }

    .dev-mountain-context-trigger > span {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .dev-mountain-context-trigger > svg,
    .dev-mountain-context-action svg {
        width: 1rem;
        height: 1rem;
        flex: 0 0 auto;
        fill: none;
        stroke: currentColor;
        stroke-linecap: round;
        stroke-linejoin: round;
        stroke-width: 1.7;
    }

    .dev-mountain-context-menu {
        position: absolute;
        z-index: 5;
        top: calc(100% + 0.3rem);
        right: 0;
        left: 0;
        max-height: 15rem;
        padding: 0.3rem;
        overflow-y: auto;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        background: white;
        box-shadow: 0 10px 28px rgb(15 23 42 / 0.16);
    }

    .dev-mountain-context-menu[hidden] { display: none; }

    .dev-mountain-context-option {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 2rem;
        align-items: center;
        border-radius: 4px;
    }

    .dev-mountain-context-option:hover,
    .dev-mountain-context-option:focus-within { background: #f1f5f9; }

    .dev-mountain-context-choice {
        min-width: 0;
        padding: 0.48rem 0.55rem;
        overflow: hidden;
        border: 0;
        background: transparent;
        color: #334155;
        font: inherit;
        font-size: 0.72rem;
        text-align: left;
        text-overflow: ellipsis;
        white-space: nowrap;
        cursor: pointer;
    }

    .dev-mountain-context-choice[aria-selected="true"] {
        color: #0f172a;
        font-weight: 600;
    }

    .dev-mountain-complete-check {
        display: grid;
        width: 2rem;
        height: 2rem;
        place-items: center;
        color: #16a34a;
    }

    .dev-mountain-complete-check svg {
        width: 1rem;
        height: 1rem;
        fill: none;
        stroke: currentColor;
        stroke-linecap: round;
        stroke-linejoin: round;
        stroke-width: 2.2;
    }

    .dev-mountain-context-action {
        display: grid;
        width: 2rem;
        height: 2rem;
        padding: 0;
        border: 0;
        border-radius: 4px;
        background: transparent;
        color: #64748b;
        place-items: center;
        cursor: pointer;
    }

    .dev-mountain-context-action:hover { background: #e2e8f0; color: #0f172a; }
    .dev-mountain-context-action:disabled { opacity: 0.5; cursor: wait; }

    .dev-mountain-context-action--danger:hover {
        background: #fee2e2;
        color: #dc2626;
    }

    .dev-mountain-primary-button {
        border: 1px solid #1d4ed8;
        background: #2563eb;
        color: white;
    }

    .dev-mountain-primary-button:hover { background: #1d4ed8; }
    .dev-mountain-primary-button:disabled { opacity: 0.55; cursor: wait; }

    .dev-mountain-help,
    .dev-mountain-manager__footer span {
        margin: 0.45rem 0 0;
        color: #94a3b8;
        font-size: 0.65rem;
        line-height: 1.5;
    }

    .dev-mountain-context-editor { margin-top: 0.75rem; padding: 0.75rem; border-radius: 6px; background: #f8fafc; }

    .dev-mountain-check { gap: 0.55rem; color: #334155; font-size: 0.78rem; cursor: pointer; }
    .dev-mountain-check input { width: 1rem; height: 1rem; }
    .dev-mountain-panorama-fields { margin-top: 0.8rem; }

    .dev-mountain-candidates { display: grid; gap: 0.45rem; margin-top: 0.6rem; }
    .dev-mountain-candidate { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 0.7rem; padding: 0.65rem; border: 1px solid #e2e8f0; border-radius: 6px; }
    .dev-mountain-candidate strong { display: block; color: #1e293b; font-size: 0.75rem; }
    .dev-mountain-candidate p { margin: 0.2rem 0 0; color: #64748b; font-size: 0.65rem; line-height: 1.45; }
    .dev-mountain-candidate a { color: #2563eb; text-decoration: none; }

    .dev-mountain-preview-toolbar {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        min-height: 1.75rem;
        margin-bottom: 0.85rem;
        border-bottom: 1px solid #e2e8f0;
    }

    .dev-mountain-preview-toolbar > strong {
        padding-bottom: 0.45rem;
        color: #334155;
        font-size: 0.78rem;
        font-weight: 600;
    }

    .dev-mountain-preview-tabs {
        display: flex;
        gap: 1.25rem;
    }

    .dev-mountain-preview-tabs button {
        position: relative;
        padding: 0 0 0.45rem;
        border: 0;
        background: transparent;
        color: #94a3b8;
        font: inherit;
        font-size: 0.6875rem;
        letter-spacing: 0.08em;
        cursor: pointer;
    }

    .dev-mountain-preview-tabs button::after {
        position: absolute;
        right: 0;
        bottom: -1px;
        left: 0;
        height: 1px;
        background: transparent;
        content: "";
    }

    .dev-mountain-preview-tabs button:hover,
    .dev-mountain-preview-tabs button[aria-selected="true"] { color: #334155; }
    .dev-mountain-preview-tabs button[aria-selected="true"]::after { background: #64748b; }
    .dev-mountain-preview-tabs button:disabled { color: #cbd5e1; cursor: not-allowed; }
    .dev-mountain-preview-viewer [data-preview-panel][hidden] { display: none; }

    .dev-mountain-map-shell,
    .dev-mountain-panorama-shell {
        overflow: hidden;
        border: 1px solid #d7dee8;
        background: #18181b;
        aspect-ratio: 16 / 10;
    }

    .dev-mountain-no-map {
        display: grid;
        place-content: center;
        gap: 0.35rem;
        border: 1px solid #d7dee8;
        background: #18181b;
        color: #71717a;
        text-align: center;
        aspect-ratio: 16 / 10;
    }

    .dev-mountain-no-map strong { color: #a1a1aa; font-size: 0.8rem; font-weight: 500; }
    .dev-mountain-no-map span { font-size: 0.65rem; }
    .dev-mountain-no-map[hidden] { display: none; }

    #dev-mountain-map {
        display: block;
        width: 100%;
        height: 100%;
        cursor: grab;
        touch-action: none;
        user-select: none;
    }

    #dev-mountain-map[data-dragging="true"] { cursor: grabbing; }
    #dev-mountain-map use {
        fill: #27272a;
        stroke: rgb(113 113 122 / 0.72);
        stroke-width: var(--mountain-map-feature-stroke-width, 0.75);
        stroke-linecap: round;
        stroke-linejoin: round;
    }
    .dev-mountain-map-marker-halo { fill: rgb(255 255 255 / 0.2); }
    .dev-mountain-map-marker-core { fill: white; stroke: #18181b; stroke-width: 1; vector-effect: non-scaling-stroke; }

    .dev-mountain-bounds-output {
        margin: 0.65rem 0 0;
        overflow-x: auto;
        color: #64748b;
        font-family: ui-monospace, monospace;
        font-size: 0.62rem;
        white-space: nowrap;
    }

    #dev-mountain-panorama-preview { display: block; width: 100%; height: 100%; border: 0; background: white; }

    @media (max-width: 820px) {
        .dev-mountain-manager__body { grid-template-columns: 1fr; overflow-y: auto; }
        .dev-mountain-manager__form-column,
        .dev-mountain-manager__preview-column { overflow: visible; }
        .dev-mountain-manager__form-column { border-right: 0; }
        .dev-mountain-grid--lookup,
        .dev-mountain-grid--location,
        .dev-mountain-grid--context,
        .dev-mountain-grid--panorama { grid-template-columns: minmax(0, 1fr); }
        .dev-mountain-grid-action { width: 100%; }
    }
</style>

<script>
    import type { EditableMountain } from "../lib/mountain-editor";
    import type { MountainWithRegion } from "../lib/mountains";
    import {
        boundsToViewBox,
        constrainMapViewBox,
        projectCoordinates,
        viewBoxToBounds,
        zoomMapViewBoxAt,
        type MapBounds,
        type SvgViewBox,
    } from "../lib/mountain-map";
    import { buildPeakFinderEmbedUrl } from "../lib/mountain-panorama";
    import type { MountainLookupCandidate } from "../lib/wikidata-mountain";

    type ContextConfig = {
        id: string;
        label: string;
        level: "country" | "admin1" | "region";
        source: string;
        bounds: MapBounds;
        visibleFeatures?: string[];
        protected?: boolean;
    };
    type SourceConfig = {
        id: string;
        asset: string;
        featureIds: string[];
        extent: SvgViewBox;
    };
    type ManagerData = {
        mountains: MountainWithRegion[];
        regions: { id: string; label: string }[];
        contexts: Record<string, ContextConfig>;
        sources: Record<string, SourceConfig>;
    };
    type PreviewMode = "location" | "panorama";

    const NEW_CONTEXT_VALUE = "__new_context__";
    const REOPEN_MANAGER_KEY = "riverbed:mountain-manager:reopen";
    const RESTORE_MANAGER_KEY = "riverbed:mountain-manager:restore";

    const byId = <T extends Element>(id: string) =>
        document.getElementById(id) as unknown as T | null;

    const numberOrUndefined = (input: HTMLInputElement) => {
        if (!input.value.trim()) return undefined;
        const value = Number(input.value);
        return Number.isFinite(value) ? value : undefined;
    };

    const escapeHtml = (value: string) =>
        value
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#39;");

    function initMountainManager() {
        const button = byId<HTMLButtonElement>("dev-mountain-manager-button");
        const dialog = byId<HTMLDialogElement>("dev-mountain-manager");
        if (!button || !dialog || button.dataset.initialized === "true") return;

        const form = byId<HTMLFormElement>("dev-mountain-form")!;
        const closeButton = byId<HTMLButtonElement>("dev-mountain-close")!;
        const regionSelect = byId<HTMLSelectElement>("dev-mountain-region")!;
        const mountainSelect = byId<HTMLSelectElement>("dev-mountain-select")!;
        const mountainPicker = byId<HTMLElement>("dev-mountain-picker")!;
        const mountainTrigger = byId<HTMLButtonElement>("dev-mountain-trigger")!;
        const mountainTriggerLabel = byId<HTMLElement>("dev-mountain-trigger-label")!;
        const mountainMenu = byId<HTMLElement>("dev-mountain-menu")!;
        const lookupButton = byId<HTMLButtonElement>("dev-mountain-lookup-button")!;
        const lookupStatus = byId<HTMLElement>("dev-mountain-lookup-status")!;
        const candidatesRoot = byId<HTMLElement>("dev-mountain-candidates")!;
        const elevationInput = byId<HTMLInputElement>("dev-mountain-elevation")!;
        const latitudeInput = byId<HTMLInputElement>("dev-mountain-latitude")!;
        const longitudeInput = byId<HTMLInputElement>("dev-mountain-longitude")!;
        const refreshLocationButton = byId<HTMLButtonElement>("dev-mountain-refresh-location")!;
        const descriptionInput = byId<HTMLTextAreaElement>("dev-mountain-description")!;
        const sourceOutput = byId<HTMLElement>("dev-mountain-source")!;
        const contextSelect = byId<HTMLSelectElement>("dev-mountain-context")!;
        const contextPicker = byId<HTMLElement>("dev-mountain-context-picker")!;
        const contextTrigger = byId<HTMLButtonElement>("dev-mountain-context-trigger")!;
        const contextTriggerLabel = byId<HTMLElement>("dev-mountain-context-trigger-label")!;
        const contextMenu = byId<HTMLElement>("dev-mountain-context-menu")!;
        const newContextIdInput = byId<HTMLInputElement>("dev-mountain-new-context-id")!;
        const newContextLabelInput = byId<HTMLInputElement>("dev-mountain-new-context-label")!;
        const saveContextButton = byId<HTMLButtonElement>("dev-mountain-save-context")!;
        const contextHelp = byId<HTMLElement>("dev-mountain-context-help")!;
        const panoramaEnabled = byId<HTMLInputElement>("dev-mountain-panorama-enabled")!;
        const panoramaFields = byId<HTMLElement>("dev-mountain-panorama-fields")!;
        const azimuthInput = byId<HTMLInputElement>("dev-mountain-azimuth")!;
        const altitudeInput = byId<HTMLInputElement>("dev-mountain-altitude")!;
        const fovInput = byId<HTMLInputElement>("dev-mountain-fov")!;
        const refreshPanoramaButton = byId<HTMLButtonElement>("dev-mountain-refresh-panorama")!;
        const panoramaFrame = byId<HTMLIFrameElement>("dev-mountain-panorama-preview")!;
        const previewTabs = Array.from(dialog.querySelectorAll<HTMLButtonElement>("[data-preview-tab]"));
        const previewPanels = Array.from(dialog.querySelectorAll<HTMLElement>("[data-preview-panel]"));
        const panoramaTab = byId<HTMLButtonElement>("dev-mountain-panorama-tab")!;
        const map = byId<SVGSVGElement>("dev-mountain-map")!;
        const mapShell = byId<HTMLElement>("dev-mountain-map-shell")!;
        const noMapMessage = byId<HTMLElement>("dev-mountain-no-map")!;
        const mapFeatures = byId<SVGGElement>("dev-mountain-map-features")!;
        const mapMarker = byId<SVGGElement>("dev-mountain-map-marker")!;
        const markerHalo = mapMarker.querySelector<SVGCircleElement>(".dev-mountain-map-marker-halo")!;
        const markerCore = mapMarker.querySelector<SVGCircleElement>(".dev-mountain-map-marker-core")!;
        const mapLabel = byId<HTMLElement>("dev-mountain-map-label")!;
        const boundsOutput = byId<HTMLElement>("dev-mountain-bounds-output")!;
        const saveButton = byId<HTMLButtonElement>("dev-mountain-save")!;
        const saveStatus = byId<HTMLElement>("dev-mountain-save-status")!;

        let managerData: ManagerData | null = null;
        let currentMountain: MountainWithRegion | null = null;
        let currentViewBox: SvgViewBox = [0, 0, 100, 100];
        let initialConstraintViewBox: SvgViewBox = [0, 0, 100, 100];
        let sourceViewBox: SvgViewBox = [0, 0, 100, 100];
        let lastExistingContextId = "";
        let isCreatingContext = false;
        const mapPointers = new Map<number, { x: number; y: number }>();
        let lastPinchDistance: number | null = null;
        let lastPinchCentre: { x: number; y: number } | null = null;
        let lookupCandidates: MountainLookupCandidate[] = [];

        const setStatus = (message: string, isError = false) => {
            saveStatus.textContent = message;
            saveStatus.style.color = isError ? "#dc2626" : "#64748b";
        };

        const preserveManagerState = (contextId: string) => {
            try {
                sessionStorage.setItem(REOPEN_MANAGER_KEY, "true");
                sessionStorage.setItem(RESTORE_MANAGER_KEY, JSON.stringify({
                    mountainName: currentMountain?.name,
                    contextId,
                }));
            } catch {
                // Saving still works if session storage is unavailable.
            }
        };

        const clearPreservedManagerState = () => {
            try {
                sessionStorage.removeItem(REOPEN_MANAGER_KEY);
                sessionStorage.removeItem(RESTORE_MANAGER_KEY);
            } catch {
                // Nothing else is required if session storage is unavailable.
            }
        };

        const getContextParts = (contextId = contextSelect.value) => {
            if (!managerData) return null;
            const resolvedContextId = isCreatingContext ? lastExistingContextId : contextId;
            const context = managerData.contexts[resolvedContextId];
            const source = context && managerData.sources[context.source];
            return context && source ? { context, source } : null;
        };

        const updateMapMarker = () => {
            const latitude = numberOrUndefined(latitudeInput);
            const longitude = numberOrUndefined(longitudeInput);
            if (latitude === undefined || longitude === undefined) {
                mapMarker.style.display = "none";
                return;
            }
            const marker = projectCoordinates(latitude, longitude);
            mapMarker.style.display = "";
            mapMarker.setAttribute("transform", `translate(${marker.x} ${marker.y})`);
        };

        const renderViewBox = (nextViewBox: SvgViewBox) => {
            currentViewBox = constrainMapViewBox(
                nextViewBox,
                initialConstraintViewBox,
                sourceViewBox,
            );
            map.setAttribute("viewBox", currentViewBox.map((value) => value.toFixed(4)).join(" "));
            const unitsPerPixel = Math.max(
                currentViewBox[2] / map.clientWidth,
                currentViewBox[3] / map.clientHeight,
            );
            map.style.setProperty(
                "--mountain-map-feature-stroke-width",
                String(Math.min(0.75, 2 * unitsPerPixel)),
            );
            const radius = Math.min(currentViewBox[2], currentViewBox[3]) * 0.015;
            markerHalo.setAttribute("r", String(radius * 2.35));
            markerCore.setAttribute("r", String(radius));
            const bounds = viewBoxToBounds(currentViewBox);
            boundsOutput.textContent = [
                `N ${bounds.north.toFixed(6)}`,
                `E ${bounds.east.toFixed(6)}`,
                `S ${bounds.south.toFixed(6)}`,
                `W ${bounds.west.toFixed(6)}`,
            ].join("  ·  ");
        };

        const renderMapContext = (bounds?: MapBounds) => {
            const parts = getContextParts();
            if (!parts) return;
            const { context, source } = parts;
            sourceViewBox = [...source.extent];
            initialConstraintViewBox = boundsToViewBox(bounds ?? context.bounds);
            currentViewBox = [...initialConstraintViewBox];
            mapFeatures.innerHTML = source.featureIds
                .map((featureId) => `<use href="${escapeHtml(source.asset)}#${escapeHtml(featureId)}"></use>`)
                .join("");
            mapLabel.textContent = context.label;
            mapShell.hidden = false;
            noMapMessage.hidden = true;
            boundsOutput.hidden = false;
            updateMapMarker();
            renderViewBox(currentViewBox);
        };

        const renderMountainMenu = () => {
            if (!managerData) return;
            mountainMenu.innerHTML = managerData.mountains
                .filter((mountain) => mountain.region === regionSelect.value)
                .map((mountain) => {
                const hasCompleteData = Boolean(
                    typeof mountain.elevation === "number" &&
                    Number.isFinite(mountain.elevation) &&
                    mountain.location &&
                    Number.isFinite(mountain.location.latitude) &&
                    Number.isFinite(mountain.location.longitude) &&
                    managerData!.contexts[mountain.location.mapContext],
                );
                const check = hasCompleteData
                    ? `<span class="dev-mountain-complete-check" title="Elevation, coordinates, and Map Context set" aria-label="Elevation, coordinates, and Map Context set"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"></path></svg></span>`
                    : "<span></span>";
                return `<div class="dev-mountain-context-option"><button class="dev-mountain-context-choice" type="button" role="option" aria-selected="${String(mountainSelect.value === mountain.name)}" data-mountain-name="${escapeHtml(mountain.name)}">${escapeHtml(mountain.name)}</button>${check}</div>`;
            }).join("");
        };

        const populateMountainSelect = (preferredName = "") => {
            if (!managerData) return;
            const mountains = managerData.mountains.filter(
                (mountain) => mountain.region === regionSelect.value,
            );
            mountainSelect.innerHTML = mountains
                .map(
                    (mountain) =>
                        `<option value="${escapeHtml(mountain.name)}">${escapeHtml(mountain.name)}</option>`,
                )
                .join("");
            if (mountains.some((mountain) => mountain.name === preferredName)) {
                mountainSelect.value = preferredName;
            }
            renderMountainMenu();
        };

        const renderContextMenu = () => {
            if (!managerData) return;
            const contexts = Object.values(managerData.contexts)
                .sort((left, right) => Number(Boolean(right.protected)) - Number(Boolean(left.protected)) || left.label.localeCompare(right.label));
            contextMenu.innerHTML = contexts.map((context) => {
                const action = context.protected
                    ? `<button class="dev-mountain-context-action" type="button" data-context-action="add" data-context-id="${escapeHtml(context.id)}" title="Create Context from ${escapeHtml(context.label)}" aria-label="Create Context from ${escapeHtml(context.label)}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg></button>`
                    : `<button class="dev-mountain-context-action dev-mountain-context-action--danger" type="button" data-context-action="delete" data-context-id="${escapeHtml(context.id)}" title="Delete ${escapeHtml(context.label)}" aria-label="Delete ${escapeHtml(context.label)}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M9 7V4h6v3M7 7l1 13h8l1-13M10 11v5M14 11v5"></path></svg></button>`;
                return `<div class="dev-mountain-context-option"><button class="dev-mountain-context-choice" type="button" role="option" aria-selected="${String(!isCreatingContext && contextSelect.value === context.id)}" data-context-id="${escapeHtml(context.id)}">${escapeHtml(context.label)} (${escapeHtml(context.id)})</button>${action}</div>`;
            }).join("");

            if (contextSelect.value && !managerData.contexts[contextSelect.value]) {
                contextMenu.insertAdjacentHTML(
                    "beforeend",
                    `<div class="dev-mountain-context-option"><button class="dev-mountain-context-choice" type="button" role="option" aria-selected="true" data-context-id="${escapeHtml(contextSelect.value)}">Missing Context (${escapeHtml(contextSelect.value)})</button><span></span></div>`,
                );
            }
        };

        const updateContextActionButtons = () => {
            const context = managerData?.contexts[contextSelect.value];
            const selectedOption = contextSelect.selectedOptions[0]?.textContent;
            contextTriggerLabel.textContent = isCreatingContext
                ? `New Context from ${managerData?.contexts[lastExistingContextId]?.label ?? "full map"}`
                : selectedOption || (context ? `${context.label} (${context.id})` : "Choose a context");
            renderContextMenu();
        };

        const populateContextSelect = () => {
            if (!managerData) return;
            const selectedValue = contextSelect.value;
            contextSelect.innerHTML = Object.values(managerData.contexts)
                .sort((left, right) => Number(Boolean(right.protected)) - Number(Boolean(left.protected)) || left.label.localeCompare(right.label))
                .map((context) => `<option value="${escapeHtml(context.id)}">${escapeHtml(context.label)} (${escapeHtml(context.id)})</option>`)
                .join("");
            if (managerData.contexts[selectedValue]) {
                contextSelect.value = selectedValue;
            }
            updateContextActionButtons();
        };

        const renderMissingContext = (contextId: string) => {
            if (!contextSelect.querySelector(`option[value="${CSS.escape(contextId)}"]`)) {
                contextSelect.insertAdjacentHTML(
                    "beforeend",
                    `<option value="${escapeHtml(contextId)}">Missing Context (${escapeHtml(contextId)})</option>`,
                );
            }
            isCreatingContext = false;
            contextSelect.value = contextId;
            newContextIdInput.value = contextId;
            newContextLabelInput.value = "";
            saveContextButton.disabled = true;
            mapLabel.textContent = "No Map Context";
            mapShell.hidden = true;
            noMapMessage.hidden = false;
            boundsOutput.hidden = true;
            contextHelp.textContent = "This context no longer exists. Choose a valid full or custom context to restore the map.";
            updateContextActionButtons();
        };

        const loadContextEditor = (contextId: string) => {
            if (!managerData) return;
            if (contextId === NEW_CONTEXT_VALUE) {
                isCreatingContext = true;
                newContextIdInput.value = "";
                newContextLabelInput.value = "";
                saveContextButton.disabled = false;
                saveContextButton.title = "Save Range as New Context";
                saveContextButton.setAttribute("aria-label", "Save Range as New Context");
                contextHelp.textContent = `Enter an ID and name, adjust the map viewport, then save it from ${managerData.contexts[lastExistingContextId]?.label ?? "the full map"}.`;
                mapLabel.textContent = "New Context";
                updateContextActionButtons();
                return;
            }
            const parts = getContextParts(contextId);
            if (!parts) return renderMissingContext(contextId);
            isCreatingContext = false;
            lastExistingContextId = contextId;
            contextSelect.value = contextId;
            newContextIdInput.value = parts.context.id;
            newContextLabelInput.value = parts.context.label;
            saveContextButton.disabled = false;
            saveContextButton.title = "Update Range";
            saveContextButton.setAttribute("aria-label", "Update Range");
            contextHelp.textContent = "Edit the ID, name, or map viewport, then update this context.";
            renderMapContext();
            updateContextActionButtons();
        };

        const pointInsideViewBox = (point: { x: number; y: number }, viewBox: SvgViewBox) =>
            point.x >= viewBox[0] &&
            point.x <= viewBox[0] + viewBox[2] &&
            point.y >= viewBox[1] &&
            point.y <= viewBox[1] + viewBox[3];

        const refreshLocationPreview = () => {
            const latitude = numberOrUndefined(latitudeInput);
            const longitude = numberOrUndefined(longitudeInput);
            if (
                latitude === undefined || longitude === undefined ||
                latitude < -90 || latitude > 90 || longitude < -180 || longitude > 180
            ) {
                setStatus("Enter valid latitude and longitude first", true);
                return;
            }

            const marker = projectCoordinates(latitude, longitude);
            const wasNewContext = isCreatingContext;
            let parts = getContextParts();
            if (!parts || !pointInsideViewBox(marker, parts.source.extent as SvgViewBox)) {
                const compatibleContext = managerData && Object.values(managerData.contexts).find((context) => {
                    const source = managerData!.sources[context.source];
                    return source && pointInsideViewBox(marker, source.extent);
                });
                if (!compatibleContext) {
                    updateMapMarker();
                    setStatus("No existing map source contains these coordinates", true);
                    return;
                }
                loadContextEditor(compatibleContext.id);
                if (wasNewContext) loadContextEditor(NEW_CONTEXT_VALUE);
                parts = getContextParts();
            }
            if (!parts) return;

            updateMapMarker();
            renderViewBox([
                marker.x - currentViewBox[2] / 2,
                marker.y - currentViewBox[3] / 2,
                currentViewBox[2],
                currentViewBox[3],
            ]);
            activatePreview("location");
            setStatus("Location preview refreshed. Changes are not saved yet.");
        };

        const activatePreview = (mode: PreviewMode, moveFocus = false) => {
            if (mode === "panorama" && !panoramaEnabled.checked) return;
            previewTabs.forEach((tab) => {
                const selected = tab.dataset.previewTab === mode;
                tab.setAttribute("aria-selected", String(selected));
                tab.tabIndex = selected ? 0 : -1;
                if (selected && moveFocus) tab.focus();
            });
            previewPanels.forEach((panel) => {
                panel.hidden = panel.dataset.previewPanel !== mode;
            });
        };

        const updatePanoramaVisibility = () => {
            const enabled = panoramaEnabled.checked;
            panoramaFields.hidden = !enabled;
            panoramaTab.disabled = !enabled;
            if (!enabled) {
                panoramaFrame.removeAttribute("src");
                activatePreview("location");
            }
        };

        const refreshPanorama = () => {
            if (!panoramaEnabled.checked || !currentMountain) return;
            const latitude = numberOrUndefined(latitudeInput);
            const longitude = numberOrUndefined(longitudeInput);
            if (latitude === undefined || longitude === undefined) {
                setStatus("Enter valid latitude and longitude first", true);
                return;
            }
            panoramaFrame.src = buildPeakFinderEmbedUrl({
                latitude,
                longitude,
                mountainName: currentMountain.name,
                elevation: numberOrUndefined(elevationInput) ?? null,
                panorama: {
                    provider: "peakfinder",
                    azimuth: numberOrUndefined(azimuthInput),
                    altitude: numberOrUndefined(altitudeInput),
                    fieldOfView: numberOrUndefined(fovInput),
                },
            });
            activatePreview("panorama");
        };

        const loadMountain = (name: string) => {
            if (!managerData) return;
            const mountain = managerData.mountains.find((entry) => entry.name === name);
            if (!mountain) return;
            regionSelect.value = mountain.region;
            populateMountainSelect(mountain.name);
            mountainSelect.value = mountain.name;
            mountainTriggerLabel.textContent = mountain.name;
            renderMountainMenu();
            currentMountain = structuredClone(mountain);
            elevationInput.value = mountain.elevation === null ? "" : String(mountain.elevation);
            descriptionInput.value = mountain.description;
            latitudeInput.value = mountain.location ? String(mountain.location.latitude) : "";
            longitudeInput.value = mountain.location ? String(mountain.location.longitude) : "";
            const contextId = mountain.location?.mapContext;
            panoramaEnabled.checked =
                !mountain.panorama || mountain.panorama.provider === "peakfinder";
            azimuthInput.value = mountain.panorama?.azimuth === undefined ? "" : String(mountain.panorama.azimuth);
            altitudeInput.value = mountain.panorama?.altitude === undefined ? "" : String(mountain.panorama.altitude);
            fovInput.value = mountain.panorama?.fieldOfView === undefined ? "" : String(mountain.panorama.fieldOfView);
            sourceOutput.innerHTML = mountain.dataSource?.wikidataId
                ? `Source: <a href="https://www.wikidata.org/wiki/${escapeHtml(mountain.dataSource.wikidataId)}" target="_blank" rel="noreferrer">${escapeHtml(mountain.dataSource.wikidataId)}</a>`
                : "No lookup source recorded";
            candidatesRoot.innerHTML = "";
            lookupStatus.textContent = "";
            panoramaFrame.removeAttribute("src");
            updatePanoramaVisibility();
            if (contextId && managerData.contexts[contextId]) {
                loadContextEditor(contextId);
            } else {
                renderMissingContext(contextId || "unassigned");
            }
            activatePreview("location");
            setStatus("");
        };

        const loadManagerData = async () => {
            setStatus("Loading mountain data…");
            const response = await fetch("/api/mountains", { cache: "no-store" });
            const data = await response.json();
            if (!response.ok) throw new Error(data.error || "Unable to load mountain data");
            managerData = data as ManagerData;
            regionSelect.innerHTML = managerData.regions
                .map(
                    (region) =>
                        `<option value="${escapeHtml(region.id)}">${escapeHtml(region.label)}</option>`,
                )
                .join("");
            let restoreState: { mountainName?: string; contextId?: string } | null = null;
            try {
                const storedState = sessionStorage.getItem(RESTORE_MANAGER_KEY);
                restoreState = storedState ? JSON.parse(storedState) : null;
                sessionStorage.removeItem(RESTORE_MANAGER_KEY);
            } catch {
                restoreState = null;
            }
            populateContextSelect();
            const pathParts = location.pathname.split("/").filter(Boolean);
            const tagName = pathParts[0] === "tags" && pathParts[1]
                ? decodeURIComponent(pathParts[1])
                : "";
            const initialMountain = managerData.mountains.find((mountain) => mountain.name === restoreState?.mountainName)
                ?? managerData.mountains.find((mountain) => mountain.name === tagName)
                ?? managerData.mountains.find((mountain) => mountain.location)
                ?? managerData.mountains[0];
            if (initialMountain) {
                regionSelect.value = initialMountain.region;
                populateMountainSelect(initialMountain.name);
                loadMountain(initialMountain.name);
            }
            if (restoreState?.contextId && managerData.contexts[restoreState.contextId]) {
                loadContextEditor(restoreState.contextId);
            }
            setStatus("");
        };

        const suggestContext = (latitude: number, longitude: number) => {
            if (!managerData) return;
            const matches = Object.values(managerData.contexts)
                .filter((context) =>
                    latitude >= context.bounds.south && latitude <= context.bounds.north &&
                    longitude >= context.bounds.west && longitude <= context.bounds.east,
                )
                .sort((left, right) => {
                    const leftArea = (left.bounds.east - left.bounds.west) * (left.bounds.north - left.bounds.south);
                    const rightArea = (right.bounds.east - right.bounds.west) * (right.bounds.north - right.bounds.south);
                    return leftArea - rightArea;
                });
            if (matches[0]) contextSelect.value = matches[0].id;
        };

        const renderCandidates = () => {
            candidatesRoot.innerHTML = lookupCandidates.map((candidate, index) => {
                const coordinates = candidate.latitude !== null && candidate.longitude !== null
                    ? `${candidate.latitude.toFixed(6)}, ${candidate.longitude.toFixed(6)}`
                    : "No coordinates";
                const elevation = candidate.elevation === null ? "No elevation" : `${candidate.elevation} m`;
                return `
                    <article class="dev-mountain-candidate">
                        <div>
                            <strong>${escapeHtml(candidate.name)}・${escapeHtml(candidate.id)}</strong>
                            <p>${escapeHtml(candidate.description || "No description")}</p>
                            <p>${escapeHtml(elevation)}・${escapeHtml(coordinates)}・<a href="${escapeHtml(candidate.sourceUrl)}" target="_blank" rel="noreferrer">Wikidata</a></p>
                        </div>
                        <button class="dev-mountain-secondary-button" type="button" data-candidate-index="${index}">Apply</button>
                    </article>`;
            }).join("");
            candidatesRoot.querySelectorAll<HTMLButtonElement>("[data-candidate-index]").forEach((candidateButton) => {
                candidateButton.addEventListener("click", () => {
                    const candidate = lookupCandidates[Number(candidateButton.dataset.candidateIndex)];
                    if (!candidate || !currentMountain) return;
                    if (candidate.elevation !== null) elevationInput.value = String(candidate.elevation);
                    if (candidate.latitude !== null && candidate.longitude !== null) {
                        latitudeInput.value = String(candidate.latitude);
                        longitudeInput.value = String(candidate.longitude);
                        suggestContext(candidate.latitude, candidate.longitude);
                        loadContextEditor(contextSelect.value);
                    }
                    currentMountain.dataSource = {
                        wikidataId: candidate.id,
                    };
                    sourceOutput.innerHTML = `Source: <a href="${escapeHtml(candidate.sourceUrl)}" target="_blank" rel="noreferrer">${escapeHtml(candidate.id)}</a> · Pending save`;
                    lookupStatus.textContent = `Applied ${candidate.name}. Review the values, then save.`;
                    lookupCandidates = [];
                    candidatesRoot.innerHTML = "";
                });
            });
        };

        const collectMountainDraft = (mapContext = contextSelect.value): EditableMountain => {
            if (!currentMountain) throw new Error("No mountain selected");
            const latitude = numberOrUndefined(latitudeInput);
            const longitude = numberOrUndefined(longitudeInput);
            if ((latitude === undefined) !== (longitude === undefined)) {
                throw new Error("Latitude and longitude must be entered together");
            }

            const mountain: EditableMountain = {
                name: currentMountain.name,
                elevation: numberOrUndefined(elevationInput) ?? null,
                description: descriptionInput.value.trim(),
                ...(currentMountain.coverKey
                    ? { coverKey: currentMountain.coverKey }
                    : {}),
                ...(currentMountain.dataSource
                    ? { dataSource: currentMountain.dataSource }
                    : {}),
            };
            if (latitude !== undefined && longitude !== undefined) {
                mountain.location = {
                    latitude,
                    longitude,
                    mapContext,
                };
            }
            if (panoramaEnabled.checked) {
                mountain.panorama = {
                    provider: "peakfinder",
                    azimuth: numberOrUndefined(azimuthInput),
                    altitude: numberOrUndefined(altitudeInput),
                    fieldOfView: numberOrUndefined(fovInput),
                };
            }
            return mountain;
        };

        button.addEventListener("click", async () => {
            dialog.showModal();
            if (!managerData) {
                try {
                    await loadManagerData();
                } catch (error) {
                    setStatus(error instanceof Error ? error.message : "Unable to load data", true);
                }
            } else {
                renderViewBox(currentViewBox);
            }
        });
        closeButton.addEventListener("click", () => dialog.close());
        dialog.addEventListener("click", (event) => {
            if (event.target === dialog) dialog.close();
        });

        const closeMountainMenu = (restoreFocus = false) => {
            mountainMenu.hidden = true;
            mountainTrigger.setAttribute("aria-expanded", "false");
            if (restoreFocus) mountainTrigger.focus();
        };

        mountainTrigger.addEventListener("click", () => {
            const willOpen = mountainMenu.hidden;
            mountainMenu.hidden = !willOpen;
            mountainTrigger.setAttribute("aria-expanded", String(willOpen));
            if (willOpen) {
                renderMountainMenu();
                mountainMenu.querySelector<HTMLButtonElement>('[aria-selected="true"]')?.focus();
            }
        });

        mountainMenu.addEventListener("click", (event) => {
            const target = (event.target as Element).closest<HTMLButtonElement>("button[data-mountain-name]");
            const mountainName = target?.dataset.mountainName;
            if (!mountainName) return;
            mountainSelect.value = mountainName;
            closeMountainMenu(true);
            mountainSelect.dispatchEvent(new Event("change"));
        });

        mountainPicker.addEventListener("keydown", (event) => {
            if (event.key !== "Escape" || mountainMenu.hidden) return;
            event.preventDefault();
            closeMountainMenu(true);
        });

        document.addEventListener("click", (event) => {
            if (!mountainMenu.hidden && !mountainPicker.contains(event.target as Node)) closeMountainMenu();
        });

        mountainSelect.addEventListener("change", () => {
            const mountainName = mountainSelect.value;
            loadMountain(mountainName);
            const pathParts = location.pathname.split("/").filter(Boolean);
            const currentTag = pathParts[0] === "tags" && pathParts[1]
                ? decodeURIComponent(pathParts[1])
                : "";
            if (currentTag === mountainName) return;
            try {
                sessionStorage.setItem(REOPEN_MANAGER_KEY, "true");
            } catch {
                // Navigation still works if session storage is unavailable.
            }
            location.assign(`/tags/${encodeURIComponent(mountainName)}`);
        });

        regionSelect.addEventListener("change", () => {
            populateMountainSelect();
            const nextMountain = managerData?.mountains.find(
                (mountain) =>
                    mountain.region === regionSelect.value &&
                    mountain.name === mountainSelect.value,
            );
            if (nextMountain) loadMountain(nextMountain.name);
        });

        previewTabs.forEach((tab) => {
            tab.addEventListener("click", () => {
                const mode = tab.dataset.previewTab as PreviewMode;
                if (mode === "panorama" && !panoramaFrame.hasAttribute("src")) {
                    refreshPanorama();
                    return;
                }
                activatePreview(mode);
            });
            tab.addEventListener("keydown", (event) => {
                if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
                const availableTabs = previewTabs.filter((candidate) => !candidate.disabled);
                const availableIndex = availableTabs.indexOf(tab);
                if (availableIndex < 0) return;
                event.preventDefault();
                const offset = event.key === "ArrowRight" ? 1 : -1;
                const nextTab = availableTabs[(availableIndex + offset + availableTabs.length) % availableTabs.length];
                const mode = nextTab.dataset.previewTab as PreviewMode;
                if (mode === "panorama" && !panoramaFrame.hasAttribute("src")) {
                    refreshPanorama();
                }
                activatePreview(mode, true);
            });
        });

        dialog.querySelectorAll<HTMLElement>("[data-preview-target]").forEach((section) => {
            section.addEventListener("focusin", () => {
                const mode = section.dataset.previewTarget as PreviewMode;
                if (mode === "panorama" && panoramaEnabled.checked && !panoramaFrame.hasAttribute("src")) {
                    refreshPanorama();
                    return;
                }
                activatePreview(mode);
            });
        });

        lookupButton.addEventListener("click", async () => {
            const query = currentMountain?.name.trim() || mountainSelect.value.trim();
            if (!query) return;
            lookupButton.disabled = true;
            lookupStatus.textContent = "Searching Wikidata…";
            candidatesRoot.innerHTML = "";
            try {
                const response = await fetch(`/api/mountain-lookup?q=${encodeURIComponent(query)}`);
                const data = await response.json();
                if (!response.ok) throw new Error(data.error || "Lookup failed");
                lookupCandidates = (data.candidates ?? []).filter((candidate: MountainLookupCandidate) =>
                    candidate.elevation !== null ||
                    (candidate.latitude !== null && candidate.longitude !== null),
                );
                lookupStatus.textContent = lookupCandidates.length
                    ? `Found ${lookupCandidates.length} candidates. Confirm the name and location.`
                    : "No candidates found. Enter the values manually.";
                renderCandidates();
            } catch (error) {
                lookupStatus.textContent = error instanceof Error ? error.message : "Lookup failed";
            } finally {
                lookupButton.disabled = false;
            }
        });

        latitudeInput.addEventListener("input", updateMapMarker);
        longitudeInput.addEventListener("input", updateMapMarker);
        refreshLocationButton.addEventListener("click", refreshLocationPreview);
        newContextLabelInput.addEventListener("input", () => {
            mapLabel.textContent = newContextLabelInput.value.trim() ||
                (isCreatingContext ? "New Context" : "Untitled Context");
        });

        const closeContextMenu = (restoreFocus = false) => {
            contextMenu.hidden = true;
            contextTrigger.setAttribute("aria-expanded", "false");
            if (restoreFocus) contextTrigger.focus();
        };

        const startAddingContext = (contextId: string) => {
            const baseContext = managerData?.contexts[contextId];
            if (!baseContext?.protected) return;
            contextSelect.value = baseContext.id;
            lastExistingContextId = baseContext.id;
            loadContextEditor(NEW_CONTEXT_VALUE);
            closeContextMenu();
            setStatus(`Creating a new context from ${baseContext.label}. Changes are not saved yet.`);
        };

        const deleteContext = async (contextId: string, actionButton: HTMLButtonElement) => {
            if (!managerData) return;
            const context = managerData.contexts[contextId];
            if (!context || context.protected) return;
            const affectedMountains = managerData.mountains.filter(
                (mountain) => mountain.location?.mapContext === contextId,
            );
            const affectedMessage = affectedMountains.length
                ? `${affectedMountains.length} mountain${affectedMountains.length === 1 ? "" : "s"} currently reference this context. Their coordinates will remain, but their Location maps will be hidden until another context is assigned.`
                : "No mountains currently reference this context.";
            const confirmed = window.confirm(
                `Delete "${context.label}" (${context.id})?\n\n${affectedMessage}\n\nThis writes map-contexts.json immediately and cannot be undone from DevTool.`,
            );
            if (!confirmed) {
                setStatus("Context deletion cancelled.");
                return;
            }

            actionButton.disabled = true;
            try {
                const response = await fetch("/api/mountain-contexts", {
                    method: "DELETE",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ id: contextId }),
                });
                const data = await response.json();
                if (!response.ok) throw new Error(data.error || "Unable to delete context");
                delete managerData.contexts[contextId];
                populateContextSelect();
                renderMissingContext(contextId);
                setStatus(`Deleted ${context.label}. ${Number(data.affectedCount) || 0} mountain reference${Number(data.affectedCount) === 1 ? "" : "s"} now have no map context.`);
            } catch (error) {
                setStatus(error instanceof Error ? error.message : "Unable to delete context", true);
            } finally {
                actionButton.disabled = false;
            }
        };

        contextTrigger.addEventListener("click", () => {
            const willOpen = contextMenu.hidden;
            contextMenu.hidden = !willOpen;
            contextTrigger.setAttribute("aria-expanded", String(willOpen));
            if (willOpen) {
                renderContextMenu();
                contextMenu.querySelector<HTMLButtonElement>('[aria-selected="true"]')?.focus();
            }
        });

        contextMenu.addEventListener("click", (event) => {
            const target = (event.target as Element).closest<HTMLButtonElement>("button[data-context-id]");
            if (!target) return;
            const contextId = target.dataset.contextId;
            if (!contextId) return;
            if (target.dataset.contextAction === "add") {
                startAddingContext(contextId);
                return;
            }
            if (target.dataset.contextAction === "delete") {
                closeContextMenu();
                void deleteContext(contextId, target);
                return;
            }
            contextSelect.value = contextId;
            loadContextEditor(contextId);
            closeContextMenu(true);
        });

        contextPicker.addEventListener("keydown", (event) => {
            if (event.key !== "Escape" || contextMenu.hidden) return;
            event.preventDefault();
            closeContextMenu(true);
        });

        document.addEventListener("click", (event) => {
            if (!contextMenu.hidden && !contextPicker.contains(event.target as Node)) closeContextMenu();
        });

        saveContextButton.addEventListener("click", async () => {
            const id = newContextIdInput.value.trim();
            const label = newContextLabelInput.value.trim();
            if (!id || !label) return setStatus("Enter a Context ID and display name", true);
            const isNewContext = isCreatingContext;
            if (isNewContext && !lastExistingContextId) {
                return setStatus("Select an existing context before creating the first new context", true);
            }
            if (!isNewContext) {
                const idChangeNotice = id !== lastExistingContextId
                    ? `\n\nThe Context ID will change from "${lastExistingContextId}" to "${id}", and all mountain references will be migrated.`
                    : "";
                const confirmed = window.confirm(
                    `Update the range for "${label}"?\n\nThis writes map-contexts.json immediately and also saves the current mountain draft.${idChangeNotice}`,
                );
                if (!confirmed) {
                    setStatus("Context update cancelled.");
                    return;
                }
            }
            saveContextButton.disabled = true;
            preserveManagerState(id);
            try {
                const originalContextId = lastExistingContextId;
                const mountain = collectMountainDraft(id);
                const response = await fetch("/api/mountain-contexts", {
                    method: isNewContext ? "POST" : "PUT",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        id,
                        label,
                        ...(isNewContext
                            ? { baseContextId: originalContextId }
                            : { originalId: originalContextId }),
                        bounds: viewBoxToBounds(currentViewBox),
                        ...(mountain.location
                            ? {
                                originalName: currentMountain?.name,
                                region: currentMountain?.region,
                                mountain,
                            }
                            : {}),
                    }),
                });
                const data = await response.json();
                if (!response.ok) throw new Error(data.error || "Unable to save context");
                if (managerData) {
                    if (!isNewContext && id !== originalContextId) {
                        delete managerData.contexts[originalContextId];
                        for (const entry of managerData.mountains) {
                            if (entry.location?.mapContext !== originalContextId) continue;
                            entry.location.mapContext = id;
                            delete entry.location.initialBounds;
                        }
                    }
                    managerData.contexts[id] = data.context;
                    if (data.mountain) {
                        const savedMountain = data.mountain as MountainWithRegion;
                        const mountainIndex = managerData.mountains.findIndex(
                            (entry) => entry.name === savedMountain.name,
                        );
                        if (mountainIndex >= 0) managerData.mountains[mountainIndex] = savedMountain;
                        currentMountain = savedMountain;
                    }
                    lastExistingContextId = id;
                    populateContextSelect();
                    loadContextEditor(id);
                }
                const affected = Number(data.affectedMountains) || 0;
                setStatus(isNewContext
                    ? `Created ${label}${data.mountain ? " and saved the current mountain" : ""}.`
                    : `Updated ${label}${affected ? ` and migrated ${affected} mountain reference${affected === 1 ? "" : "s"}` : ""}.`);
                window.setTimeout(clearPreservedManagerState, 2000);
            } catch (error) {
                clearPreservedManagerState();
                setStatus(error instanceof Error ? error.message : "Unable to save context", true);
            } finally {
                saveContextButton.disabled = false;
            }
        });

        panoramaEnabled.addEventListener("change", () => {
            updatePanoramaVisibility();
            if (panoramaEnabled.checked) refreshPanorama();
        });
        refreshPanoramaButton.addEventListener("click", refreshPanorama);

        map.addEventListener("wheel", (event) => {
            event.preventDefault();
            const matrix = map.getScreenCTM();
            if (!matrix) return;
            const point = new DOMPoint(event.clientX, event.clientY).matrixTransform(matrix.inverse());
            const delta = Math.max(-120, Math.min(120, event.deltaY));
            renderViewBox(
                zoomMapViewBoxAt(
                    currentViewBox,
                    Math.exp(delta * 0.0025),
                    point,
                    initialConstraintViewBox,
                    sourceViewBox,
                ),
            );
        }, { passive: false });

        map.addEventListener("pointerdown", (event) => {
            if (event.button !== 0) return;
            mapPointers.set(event.pointerId, { x: event.clientX, y: event.clientY });
            map.setPointerCapture(event.pointerId);
            map.dataset.dragging = "true";
            if (mapPointers.size === 2) {
                const [first, second] = [...mapPointers.values()];
                lastPinchDistance = Math.hypot(second.x - first.x, second.y - first.y);
                lastPinchCentre = {
                    x: (first.x + second.x) / 2,
                    y: (first.y + second.y) / 2,
                };
            }
        });
        map.addEventListener("pointermove", (event) => {
            const previousPosition = mapPointers.get(event.pointerId);
            if (!previousPosition) return;
            mapPointers.set(event.pointerId, { x: event.clientX, y: event.clientY });
            const matrix = map.getScreenCTM();
            if (!matrix || matrix.a === 0 || matrix.d === 0) return;

            if (mapPointers.size >= 2) {
                const [first, second] = [...mapPointers.values()];
                const distance = Math.hypot(second.x - first.x, second.y - first.y);
                const centre = {
                    x: (first.x + second.x) / 2,
                    y: (first.y + second.y) / 2,
                };
                if (lastPinchDistance && lastPinchCentre && distance > 0) {
                    renderViewBox([
                        currentViewBox[0] - (centre.x - lastPinchCentre.x) / matrix.a,
                        currentViewBox[1] - (centre.y - lastPinchCentre.y) / matrix.d,
                        currentViewBox[2],
                        currentViewBox[3],
                    ]);
                    const updatedMatrix = map.getScreenCTM();
                    if (updatedMatrix) {
                        const mapCentre = new DOMPoint(centre.x, centre.y).matrixTransform(
                            updatedMatrix.inverse(),
                        );
                        renderViewBox(zoomMapViewBoxAt(
                            currentViewBox,
                            lastPinchDistance / distance,
                            mapCentre,
                            initialConstraintViewBox,
                            sourceViewBox,
                        ));
                    }
                }
                lastPinchDistance = distance;
                lastPinchCentre = centre;
                return;
            }

            renderViewBox([
                currentViewBox[0] - (event.clientX - previousPosition.x) / matrix.a,
                currentViewBox[1] - (event.clientY - previousPosition.y) / matrix.d,
                currentViewBox[2],
                currentViewBox[3],
            ]);
        });
        const finishDragging = (event: PointerEvent) => {
            if (!mapPointers.has(event.pointerId)) return;
            mapPointers.delete(event.pointerId);
            lastPinchDistance = null;
            lastPinchCentre = null;
            map.dataset.dragging = String(mapPointers.size > 0);
            if (map.hasPointerCapture(event.pointerId)) map.releasePointerCapture(event.pointerId);
        };
        map.addEventListener("pointerup", finishDragging);
        map.addEventListener("pointercancel", finishDragging);

        form.addEventListener("submit", async (event) => {
            event.preventDefault();
            if (!currentMountain) return;
            if (isCreatingContext) {
                return setStatus("Save the new context before saving mountain data", true);
            }
            if (!managerData?.contexts[contextSelect.value] && currentMountain.location) {
                return setStatus("Choose a valid map context before saving mountain data", true);
            }
            let mountain: EditableMountain;
            try {
                mountain = collectMountainDraft();
            } catch (error) {
                return setStatus(
                    error instanceof Error ? error.message : "Invalid field data",
                    true,
                );
            }

            saveButton.disabled = true;
            setStatus("Saving…");
            try {
                const response = await fetch("/api/mountains", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        originalName: currentMountain.name,
                        region: currentMountain.region,
                        mountain,
                    }),
                });
                const data = await response.json();
                if (!response.ok) throw new Error(data.error || "Save failed");
                const savedMountain = data.mountain as MountainWithRegion;
                currentMountain = savedMountain;
                if (managerData) {
                    const index = managerData.mountains.findIndex((entry) => entry.name === savedMountain.name);
                    if (index >= 0) managerData.mountains[index] = savedMountain;
                    renderMountainMenu();
                }
                setStatus("Saved. The dev server may refresh the page.", false);
            } catch (error) {
                setStatus(error instanceof Error ? error.message : "Save failed", true);
            } finally {
                saveButton.disabled = false;
            }
        });

        button.dataset.initialized = "true";
        try {
            if (sessionStorage.getItem(REOPEN_MANAGER_KEY) === "true") {
                sessionStorage.removeItem(REOPEN_MANAGER_KEY);
                button.click();
            }
        } catch {
            // The manager can still be opened manually if session storage is unavailable.
        }
    }

    initMountainManager();
    document.addEventListener("astro:after-swap", initMountainManager);
</script>
