---
import RssLink from "./RssLink.astro";
import { getAlbumSummaries } from "../lib/albums/catalog";
import { getFolderTitle, getFolderOrder, FOLDER_METADATA } from "../lib/constants";

// Use FOLDER_METADATA keys as the base for navigation
const metadataSlugs = Object.keys(FOLDER_METADATA);

// Fetch unique folders from album slugs to catch any folders missing from metadata
const albums = await getAlbumSummaries();
const albumFolderSlugs = albums.map((album) => album.folder);

// Combine and get unique slugs
const folderSlugs = [...new Set([...metadataSlugs, ...albumFolderSlugs])];

const sortedFolders = folderSlugs
	.map((slug) => ({
		id: slug,
		title: getFolderTitle(slug),
		order: getFolderOrder(slug),
		labelClass: [
			// Han glyphs fill the em box while Latin capitals reach 0.7em, so
			// shrink the one and grow the other to narrow that gap; at these
			// sizes both scripts also share the same vertical centre.
			/\p{Script=Han}/u.test(getFolderTitle(slug)) ? "nav-label-cjk" : "nav-label-latin",
			slug === "y" ? "nav-label-descender" : "",
		].filter(Boolean).join(" "),
	}))
	.sort((a, b) => a.order - b.order);

// Get the current path to highlight active link
const currentPath = Astro.url.pathname;
---

<nav
	id="navbar"
	data-site-navigation
	class="fixed top-0 left-0 right-0 z-50 bg-page/80 backdrop-blur-md transition-transform duration-(--duration-moderate) ease-emphasized"
>
	<div class="mx-auto max-w-[1100px] px-4 sm:px-8 h-24 flex items-center relative">
		<!-- Menu Toggle - Mobile Only -->
		<button
			id="menu-toggle"
			data-site-menu-toggle
			type="button"
			class="sm:hidden p-1 text-muted hover:text-fg-strong transition-colors"
			aria-label="Toggle menu"
			aria-controls="mobile-menu"
			aria-expanded="false"
		>
			<svg
				xmlns="http://www.w3.org/2000/svg"
				aria-hidden="true"
				width="20"
				height="20"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				class="menu-icon"
				><line x1="3" y1="12" x2="21" y2="12"></line><line
					x1="3"
					y1="6"
					x2="21"
					y2="6"></line><line x1="3" y1="18" x2="21" y2="18"
				></line></svg
			>
			<svg
				xmlns="http://www.w3.org/2000/svg"
				aria-hidden="true"
				width="20"
				height="20"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				class="close-icon hidden"
				><line x1="18" y1="6" x2="6" y2="18"></line><line
					x1="6"
					y1="6"
					x2="18"
					y2="18"></line></svg
			>
		</button>

		<!-- Navigation -->
		<div class="hidden sm:flex gap-8">
			{
				sortedFolders.map((folder) => {
					const isActive = currentPath === `/${folder.id}` || currentPath.startsWith(`/${folder.id}/`);
					return (
						<a
							href={`/${folder.id}`}
							class={`text-base font-sans tracking-wide transition-colors hover:text-fg-strong relative py-1 ${
								isActive
									? "text-fg-strong"
									: "text-muted"
							}`}
						>
							<span class={folder.labelClass}>
								{folder.title}
							</span>
							<span
								class={`absolute bottom-0 left-0 right-0 h-0.5 bg-fg-strong rounded-full transition-opacity duration-(--duration-moderate) ${isActive ? 'opacity-100' : 'opacity-0'}`}
							/>
						</a>
					);
				})
			}
		</div>

		<!-- Logo - Centered -->
		<div class="absolute left-1/2 -translate-x-1/2">
			<a
				href="/"
				class="text-3xl font-sans tracking-[0.2em] hover:text-fg-strong transition-colors"
			>
				RIVERBED
			</a>
		</div>

	</div>

	<!-- Mobile Navigation Dropdown -->
	<div
		id="mobile-menu"
		data-site-mobile-menu
		class="hidden sm:hidden border-t border-line-subtle bg-page/95 backdrop-blur-xl overflow-hidden transition-[max-height] duration-(--duration-moderate) ease-emphasized max-h-0"
	>
		<div class="flex items-center px-4">
			<div class="flex min-w-0 flex-1 flex-row items-center gap-6 overflow-x-auto py-4 scrollbar-none mask-linear-right">
				{
					sortedFolders.map((folder) => {
						const isActive = currentPath === `/${folder.id}` || currentPath.startsWith(`/${folder.id}/`);
						return (
							<a
								href={`/${folder.id}`}
								class={`text-base font-sans tracking-wide transition-all whitespace-nowrap relative py-1 ${
									isActive
										? "text-fg-strong"
										: "text-muted"
								}`}
							>
								<span class={folder.labelClass}>
									{folder.title}
								</span>
								<span
									class={`absolute bottom-0 left-0 right-0 h-0.5 bg-fg-strong rounded-full transition-opacity duration-(--duration-moderate) ${isActive ? 'opacity-100' : 'opacity-0'}`}
								/>
							</a>
						);
					})
				}
			</div>
			<RssLink class="ml-4 shrink-0" />
		</div>
	</div>
</nav>

<script>
	import { installPageLifecycle } from "../lib/client-page-lifecycle";

	installPageLifecycle(document, () => {
		const navbar = document.querySelector<HTMLElement>("[data-site-navigation]");
		if (!navbar) return;

		const menuToggle = navbar.querySelector<HTMLElement>("[data-site-menu-toggle]");
		const mobileMenu = navbar.querySelector<HTMLElement>("[data-site-mobile-menu]");
		if (!menuToggle || !mobileMenu) return;

		const controller = new AbortController();
		let closeTimer: number | undefined;
		let lastScrollY = window.scrollY;
		let menuOpen = !mobileMenu.classList.contains("hidden");

		const clearCloseTimer = () => {
			if (closeTimer === undefined) return;
			window.clearTimeout(closeTimer);
			closeTimer = undefined;
		};

		const setMenuOpen = (open: boolean) => {
			clearCloseTimer();
			menuOpen = open;
			menuToggle.setAttribute("aria-expanded", String(open));
			menuToggle.querySelector(".menu-icon")?.classList.toggle("hidden", open);
			menuToggle.querySelector(".close-icon")?.classList.toggle("hidden", !open);

			if (open) {
				mobileMenu.classList.remove("hidden");
				// Animate to the menu's real height: a larger cap would spend most of
				// the transition on invisible height, so closing would seem to stall.
				mobileMenu.style.maxHeight = `${mobileMenu.scrollHeight}px`;
			} else {
				mobileMenu.style.maxHeight = "0px";
				// Hide once the collapse has played; its length is the menu's
				// CSS transition (--duration-moderate).
				const closeDelay = parseFloat(getComputedStyle(mobileMenu).transitionDuration) * 1000 || 0;
				closeTimer = window.setTimeout(() => {
					if (!menuOpen) {
						mobileMenu.classList.add("hidden");
					}
					closeTimer = undefined;
				}, closeDelay);
			}
		};

		menuToggle.addEventListener("click", () => {
			setMenuOpen(!menuOpen);
		}, { signal: controller.signal });

		window.addEventListener("scroll", () => {
			const currentScrollY = window.scrollY;

			if (menuOpen) {
				setMenuOpen(false);
			}

			if (currentScrollY > lastScrollY && currentScrollY > 120) {
				navbar.classList.add("-translate-y-full");
			} else {
				navbar.classList.remove("-translate-y-full");
			}

			lastScrollY = currentScrollY;
		}, { passive: true, signal: controller.signal });

		return () => {
			controller.abort();
			clearCloseTimer();
		};
	});
</script>

<style>
	/* Han labels use Noto Sans TC (Adobe's Source Han Sans); Latin labels use
	   Source Sans 3, the Latin face Adobe drew to sit beside it, so both
	   scripts share a stroke weight while the Latin stays slender.

	   Han glyphs nearly fill the em box while Source Sans capitals reach only
	   0.656em; at these sizes both scripts share one vertical centre. */
	.nav-label-cjk {
		font-family: "Noto Sans TC", "Noto Sans JP", sans-serif;
		font-size: 0.95em;
		/* Draw 大林's two glyphs a touch closer than the link's tracking-wide. */
		letter-spacing: -0.03em;
	}

	.nav-label-latin {
		font-family: "Source Sans 3", "Noto Sans TC", sans-serif;
		font-size: 1.1em;
	}

	/* Lift the lowercase y until its x-height bowl centres on the capitals'
	   centre line; a full descender lift leaves the bowl floating. */
	.nav-label-descender {
		position: relative;
		top: -0.1em;
	}

	.mask-linear-right {
		mask-image: linear-gradient(to right, black 85%, transparent 100%);
	}
</style>
