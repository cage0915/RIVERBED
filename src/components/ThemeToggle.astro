---
/**
 * Switches between the dark and light themes. Clicks are handled once for
 * the whole site by the theme script in Layout, so every copy of this button
 * (navbar and phone menu) works without its own script. It shows the theme
 * in use: a moon in the dark theme, a sun in the light one.
 */
interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<button
	type="button"
	data-theme-toggle
	class:list={[
		"flex h-7 w-7 items-center justify-center rounded-full border border-line text-subtle transition-colors hover:border-line-strong hover:text-fg-strong",
		className,
	]}
	aria-label="切換深淺色"
	title="切換深淺色"
>
	<svg
		class="theme-toggle-sun"
		xmlns="http://www.w3.org/2000/svg"
		width="14"
		height="14"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
	>
		<circle cx="12" cy="12" r="4"></circle>
		<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
	</svg>
	<svg
		class="theme-toggle-moon"
		xmlns="http://www.w3.org/2000/svg"
		width="14"
		height="14"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
	>
		<path d="M20.99 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 20.99 12.79z"></path>
	</svg>
</button>

<style>
	.theme-toggle-sun {
		display: none;
	}

	:global(:root[data-theme="light"]) .theme-toggle-moon {
		display: none;
	}

	:global(:root[data-theme="light"]) .theme-toggle-sun {
		display: block;
	}
</style>
