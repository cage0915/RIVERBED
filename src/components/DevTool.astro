---
// DEV-ONLY component for album editing
---

<style is:global>
    .dev-manager-header-actions {
        display: flex;
        align-items: center;
        gap: 0.25rem;
    }
    .dev-manager-header-button {
        display: flex;
        width: 2rem;
        height: 2rem;
        padding: 0;
        align-items: center;
        justify-content: center;
        border: 0;
        border-radius: 6px;
        background: transparent;
        color: #64748b;
        cursor: pointer;
    }
    .dev-manager-header-button:hover {
        background: #f1f5f9;
        color: #0f172a;
    }
    .dev-manager-header-button--save {
        border: 1px solid #198754;
        background: #198754;
        color: #fff;
    }
    .dev-manager-header-button--save:hover {
        border-color: #146c43;
        background: #157347;
        color: #fff;
    }
    .dev-manager-header-button--save[disabled] {
        border-color: transparent;
        background: transparent;
        color: #94a3b8;
        cursor: default;
        opacity: 0.6;
    }
    .dev-page-inline-add-zone {
        position: absolute;
        right: 0;
        bottom: -0.65rem;
        left: 0;
        z-index: 70;
        display: flex;
        height: 1.3rem;
        align-items: center;
        justify-content: center;
        gap: 0.3rem;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: opacity 0.15s ease, visibility 0.15s ease;
    }
    .dev-page-inline-add-zone--before {
        top: -0.65rem;
        bottom: auto;
    }
    .dev-block-edit-mode .dev-block-overlay:hover > .dev-page-inline-add-zone,
    .dev-block-edit-mode .dev-block-overlay:focus-within > .dev-page-inline-add-zone {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
    }
    .dev-block-overlay:focus-within {
        z-index: 300;
    }
    .dev-page-inline-add-zone:focus-within {
        z-index: 1001;
    }
    .dev-page-inline-add-button,
    .dev-page-inline-more-button {
        display: flex;
        width: 2rem;
        height: 2rem;
        padding: 0;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 999px;
        background: rgba(255,255,255,0.2);
        backdrop-filter: blur(4px);
        color: rgba(161, 161, 170, 0.8);
        cursor: pointer;
        pointer-events: auto;
        transition: all 0.3s;
    }
    .dev-page-inline-add-button:hover,
    .dev-page-inline-add-button:focus-visible,
    .dev-page-inline-more-button:hover,
    .dev-page-inline-more-button:focus-visible {
        border-color: rgba(59, 130, 246, 0.8);
        background: rgba(59, 130, 246, 0.8);
        color: white;
        outline: none;
    }
    .dev-page-inline-add-zone .dev-inline-margin-control,
    .dev-page-inline-add-zone .dev-inline-block-type-control {
        position: relative;
        flex: 0 0 auto;
        margin: 0;
        overflow: visible;
        pointer-events: auto;
    }
    .dev-page-inline-add-zone .dev-inline-margin-control.is-open,
    .dev-page-inline-add-zone .dev-inline-block-type-control.is-open {
        width: 2rem;
        margin-left: 0;
    }
    .dev-page-inline-add-zone .dev-inline-block-type-control,
    .dev-page-inline-add-zone .dev-inline-block-type-control.is-open {
        width: auto;
    }
    .dev-page-inline-add-zone .dev-inline-block-type-options {
        position: absolute;
        top: calc(100% + 0.3rem);
        left: 50%;
        z-index: 1001;
        display: none;
        flex-direction: row;
        transform: translateX(-50%);
        overflow: hidden;
        border: 1px solid rgba(255,255,255,0.2);
        border-radius: 9999px;
        background: rgba(15, 23, 42, 0.92);
        backdrop-filter: blur(4px);
        white-space: nowrap;
    }
    .dev-page-inline-add-zone .dev-inline-block-type-control.is-open .dev-inline-block-type-options {
        display: flex;
    }
    .dev-page-inline-add-zone .dev-inline-block-type-control.is-open .dev-inline-block-type-current {
        display: flex;
    }
    .dev-page-inline-add-zone .dev-inline-block-type-current,
    .dev-page-inline-add-zone .dev-inline-block-type-control button {
        width: auto;
        min-width: 0;
        padding-inline: 0.55rem;
        font-size: 0.68rem;
    }
    .dev-page-inline-add-zone .dev-inline-block-type-current {
        border-left: 0 !important;
    }
    .dev-page-inline-add-menu {
        position: fixed;
        z-index: 1000;
        display: flex;
        gap: 0.25rem;
        padding: 0.4rem;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        background: #fff;
        box-shadow: 0 4px 16px rgba(0,0,0,.15);
        white-space: nowrap;
    }
    .dev-page-inline-add-menu button {
        padding: .35rem .6rem;
        border: 0;
        border-radius: 4px;
        background: none;
        color: #334155;
        cursor: pointer;
        font: inherit;
        font-size: .75rem;
    }
    .dev-page-inline-add-menu button:hover,
    .dev-page-inline-add-menu button:focus-visible {
        background: #f1f5f9;
        outline: none;
    }
    .dev-page-inline-action-menu [data-inline-action-confirm] {
        color: #dc2626;
    }
    .dev-page-inline-action-menu [data-inline-action-confirm]:disabled {
        color: #cbd5e1;
        cursor: default;
    }
    .dev-page-inline-action-menu [data-inline-action-confirm="initial"] {
        color: #2563eb;
    }
    .dev-page-inline-action-menu .dev-inline-number-label {
        display: flex;
        align-items: center;
        gap: .4rem;
        padding: 0 .35rem;
        color: #64748b;
        font-size: .75rem;
    }
    .dev-page-inline-action-menu .dev-inline-number-input {
        width: 3.5rem;
        padding: .25rem .35rem;
        border: 1px solid #e2e8f0;
        border-radius: 4px;
        background: #fff;
        color: #334155;
        font: inherit;
        font-size: .75rem;
        text-align: right;
    }
    .dev-page-inline-action-menu .dev-inline-number-input:focus {
        border-color: #2563eb;
        outline: none;
    }
    .dev-block-photo-action .photo-wrapper {
        cursor: pointer !important;
    }
    .dev-block-photo-action .photo-wrapper.dev-inline-photo-selected {
        z-index: 25;
        outline: 3px solid #dc2626;
        outline-offset: -3px;
    }
    .dev-block-photo-action--initial .photo-wrapper.dev-inline-photo-selected {
        outline-color: #2563eb;
    }
    .dev-import-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
        gap: 0.6rem;
        margin-top: 1rem;
    }
    .dev-import-sort-button {
        padding: 0.3rem 0.55rem;
        border: 1px solid #cbd5e1;
        border-radius: 5px;
        background: #fff;
        color: #475569;
        font: inherit;
        cursor: pointer;
    }
    .dev-import-sort-button:hover {
        border-color: #94a3b8;
        background: #f8fafc;
        color: #0f172a;
    }
    .dev-import-sort-button.is-active {
        border-color: #2563eb;
        background: #eff6ff;
        color: #1d4ed8;
    }
    .dev-import-photo {
        position: relative;
        padding: 0;
        overflow: hidden;
        border: 2px solid transparent;
        border-radius: 7px;
        background: #e2e8f0;
        cursor: pointer;
        aspect-ratio: 4 / 3;
    }
    .dev-import-photo img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .dev-import-photo:focus { outline: none; }
    .dev-import-photo.is-current { outline: 2px solid #2563eb; outline-offset: 2px; }
    .dev-import-photo.is-selected { border-color: #16a34a; }
    .dev-import-photo span {
        position: absolute;
        right: 0;
        bottom: 0;
        left: 0;
        overflow: hidden;
        padding: 0.25rem;
        background: rgba(15, 23, 42, 0.72);
        color: white;
        font-size: 0.62rem;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .dev-import-photo-checkbox {
        position: absolute;
        top: 0.4rem;
        right: 0.4rem;
        width: 1.15rem;
        height: 1.15rem;
        margin: 0;
        accent-color: #16a34a;
        cursor: pointer;
        filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.55));
    }
    .dev-import-staged-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(88px, 1fr));
        gap: 0.5rem;
        margin-top: 0.6rem;
    }
    .dev-import-staged-photo {
        position: relative;
        overflow: hidden;
        border-radius: 6px;
        background: #e2e8f0;
        aspect-ratio: 4 / 3;
    }
    .dev-import-staged-photo img { width: 100%; height: 100%; object-fit: cover; }
    .dev-import-staged-remove {
        position: absolute;
        top: 0.25rem;
        right: 0.25rem;
        display: flex;
        width: 1.4rem;
        height: 1.4rem;
        padding: 0;
        align-items: center;
        justify-content: center;
        border: 0;
        border-radius: 50%;
        background: rgba(220, 38, 38, 0.9);
        color: white;
        cursor: pointer;
    }
    .dev-import-preview {
        position: absolute;
        inset: 0;
        z-index: 20;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 1rem;
        background: rgba(2, 6, 23, 0.94);
    }
    .dev-import-preview[hidden] { display: none; }
    .dev-import-preview img { max-width: 100%; max-height: calc(100% - 3rem); object-fit: contain; }
    .dev-block-toolbar {
        position: absolute;
        bottom: 0;
        left: -2.75rem;
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        z-index: 50;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.2s ease;
    }
    .dev-block-edit-mode .dev-block-overlay:hover > .dev-block-toolbar,
    .dev-block-edit-mode .dev-block-toolbar:focus-within,
    .dev-block-toolbar.is-open {
        opacity: 1;
        pointer-events: auto;
    }
    .dev-toolbar-btn {
        width: 2rem;
        height: 2rem;
        border-radius: 9999px; /* rounded-full */
        border: 1px solid rgba(255,255,255,0.1); /* border-white/10 */
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255,255,255,0.2); /* bg-white/20 */
        backdrop-filter: blur(4px); /* backdrop-blur-xs */
        color: rgba(161, 161, 170, 0.8); /* subtle text-zinc */
        cursor: pointer;
        transition: all 0.3s;
    }
    .dev-toolbar-btn:hover {
        border-color: rgba(255,255,255,0.3);
        color: white;
    }
    .dev-toolbar-btn.active {
        background: rgba(59, 130, 246, 0.5); /* blue */
        color: white;
        border-color: rgba(59, 130, 246, 0.8);
    }
    .dev-toolbar-btn.has-data {
        background: rgba(255,255,255,0.2);
        border-color: rgba(255,255,255,0.3);
        color: white;
    }
    .dev-toolbar-btn.has-data:hover {
        background: rgba(59, 130, 246, 0.8);
    }
    .dev-block-toolbar .dev-toolbar-btn,
    .dev-block-toolbar .dev-inline-margin-control,
    .dev-block-toolbar .dev-inline-block-type-control {
        order: var(--dev-toolbar-order, 0);
    }
    .dev-block-toolbar .dev-btn-caption,
    .dev-block-toolbar .dev-btn-text { --dev-toolbar-order: 2; }
    .dev-block-toolbar .dev-inline-margin-control { --dev-toolbar-order: 3; }
    .dev-block-toolbar .dev-inline-block-type-control { --dev-toolbar-order: 4; }
    .dev-block-toolbar .dev-toolbar-btn:not(.has-data):not(.has-pending),
    .dev-block-toolbar .dev-inline-margin-control:not(.has-data):not(.has-pending),
    .dev-block-toolbar .dev-inline-block-type-control:not(.has-data):not(.has-pending) {
        display: none;
        order: 0;
    }
    .dev-block-edit-mode .dev-block-overlay:hover > .dev-block-toolbar .dev-toolbar-btn,
    .dev-block-edit-mode .dev-block-overlay:hover > .dev-block-toolbar .dev-inline-margin-control,
    .dev-block-edit-mode .dev-block-overlay:hover > .dev-block-toolbar .dev-inline-block-type-control,
    .dev-block-edit-mode .dev-block-overlay:focus-within > .dev-block-toolbar .dev-toolbar-btn,
    .dev-block-edit-mode .dev-block-overlay:focus-within > .dev-block-toolbar .dev-inline-margin-control,
    .dev-block-edit-mode .dev-block-overlay:focus-within > .dev-block-toolbar .dev-inline-block-type-control,
    .dev-block-toolbar:focus-within .dev-toolbar-btn,
    .dev-block-toolbar:focus-within .dev-inline-margin-control,
    .dev-block-toolbar:focus-within .dev-inline-block-type-control,
    .dev-block-toolbar.is-open .dev-toolbar-btn,
    .dev-block-toolbar.is-open .dev-inline-margin-control,
    .dev-block-toolbar.is-open .dev-inline-block-type-control {
        display: flex;
        opacity: 1;
        pointer-events: auto;
    }
    .dev-inline-margin-control {
        display: flex;
        width: 2rem;
        height: 2rem;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 9999px;
        background: rgba(255,255,255,0.2);
        backdrop-filter: blur(4px);
        transition: width 0.2s ease, margin-left 0.2s ease, opacity 0.2s ease;
    }
    .dev-inline-margin-control.has-data {
        background: rgba(255,255,255,0.2);
        border-color: rgba(255,255,255,0.3);
    }
    .dev-inline-margin-control:hover {
        border-color: rgba(255,255,255,0.3);
    }
    .dev-inline-margin-control.has-data:hover {
        background: rgba(59, 130, 246, 0.8);
    }
    .dev-toolbar-btn.has-pending,
    .dev-inline-margin-control.has-pending {
        background: rgba(234, 179, 8, 0.9);
        border-color: rgba(250, 204, 21, 0.95);
        color: #18181b;
    }
    .dev-toolbar-btn.has-pending:hover,
    .dev-inline-margin-control.has-pending:hover {
        background: rgba(250, 204, 21, 0.95);
        color: #18181b;
    }
    .dev-inline-margin-control.is-open {
        width: 6rem;
        margin-left: -4rem;
    }
    .dev-inline-margin-control input {
        width: 2rem;
        min-width: 2rem;
        padding: 0;
        border: 0;
        outline: 0;
        background: transparent;
        color: white;
        font: 0.7rem/1 sans-serif;
        text-align: center;
    }
    .dev-inline-margin-control input::-webkit-inner-spin-button,
    .dev-inline-margin-control input::-webkit-outer-spin-button {
        appearance: none;
        margin: 0;
    }
    .dev-inline-margin-control button {
        display: flex;
        width: 2rem;
        min-width: 2rem;
        height: 2rem;
        padding: 0;
        align-items: center;
        justify-content: center;
        border: 0;
        background: transparent;
        color: white;
        cursor: pointer;
    }
    .dev-inline-block-type-control {
        display: flex;
        justify-content: flex-end;
        width: 2rem;
        height: 2rem;
        margin-left: 0;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,0.3);
        border-radius: 9999px;
        background: rgba(255,255,255,0.2);
        backdrop-filter: blur(4px);
        transition: width 0.2s ease, margin-left 0.2s ease, opacity 0.2s ease;
    }
    .dev-inline-block-type-control:hover,
    .dev-inline-block-type-control.is-open {
        background: rgba(59, 130, 246, 0.8);
    }
    .dev-inline-block-type-control.has-pending {
        background: rgba(234, 179, 8, 0.9);
        border-color: rgba(250, 204, 21, 0.95);
        color: #18181b;
    }
    .dev-inline-block-type-control.is-open {
        width: 6rem;
        margin-left: -4rem;
    }
    .dev-inline-block-type-options {
        display: flex;
        flex: 0 0 auto;
    }
    .dev-inline-block-type-control button {
        display: flex;
        width: 2rem;
        min-width: 2rem;
        height: 2rem;
        padding: 0;
        align-items: center;
        justify-content: center;
        border: 0;
        background: transparent;
        color: inherit;
        cursor: pointer;
        font: 600 0.8rem/1 sans-serif;
    }
    .dev-inline-block-type-option[aria-pressed="true"] {
        background: rgba(255,255,255,0.3);
        color: white;
    }
    .dev-inline-block-type-current {
        flex: 0 0 auto;
        border-left: 1px solid rgba(255,255,255,0.18) !important;
    }
    .dev-inline-block-type-control.is-open .dev-inline-block-type-current {
        display: none;
    }
    .dev-block-overlay {
        position: relative;
    }
    /* Carousel tracks extend above their layout box for photo
       tag overflow. Keep editable Text above that transparent
       hit area so a title immediately before a carousel still
       receives hover and double-click events. */
    .dev-block-edit-mode .dev-block-overlay[data-dev-block="text"] {
        z-index: 1;
    }
    .dev-block-overlay::before {
        content: '';
        position: absolute;
        top: 0;
        bottom: 0;
        left: -3.25rem;
        width: 3.25rem;
    }
    .dev-caption-preview-hidden {
        display: none !important;
    }
    .dev-caption-live-preview {
        white-space: pre-line;
    }
    .dev-text-preview-hidden {
        display: none !important;
    }
    .dev-block-overlay.dev-text-pending-delete {
        min-height: 2rem;
    }
    .dev-toolbar-text-icon {
        font: 600 0.8rem/1 sans-serif;
    }
    .dev-page-structure-preview.row-wrapper,
    .dev-page-structure-preview.carousel-section,
    .dev-page-structure-preview.photo-panorama-section,
    .dev-page-structure-preview.text-block {
        width: 100%;
    }
    .dev-page-structure-preview.row-wrapper,
    .dev-page-structure-preview.carousel-section,
    .dev-page-structure-preview.photo-panorama-section {
        display: flex;
        flex-direction: column;
    }
    .dev-page-structure-preview.text-block {
        min-height: 2rem;
        font-family: "PT Sans", "Noto Sans TC", "Noto Sans JP", sans-serif;
    }
    .dev-page-structure-preview.text-block--caption {
        color: #898989;
        font-size: 0.875rem;
        font-weight: 300;
        letter-spacing: 0.05em;
    }
    .dev-page-structure-preview.text-block--title {
        color: rgba(255, 255, 255, 0.72);
        font-size: 1.125rem;
        font-weight: 400;
        letter-spacing: 0.05em;
    }
    .dev-page-structure-preview .photo-row,
    .dev-page-structure-preview .carousel-track,
    .dev-page-structure-preview .photo-panorama-track {
        display: flex;
        width: 100%;
    }
    .dev-page-structure-preview .photo-row { gap: 0.5rem; }
    .dev-page-structure-preview .photo-row > * {
        flex: 1 1 0%;
        min-width: 0;
    }
    .dev-page-structure-preview .carousel-track {
        flex-direction: row;
        gap: 0.5rem;
        padding-block: 3.5rem;
        margin-block: -3.5rem;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scroll-padding-inline: calc((100% - var(--slide-width, 100%)) / 2);
        scrollbar-width: none;
    }
    .dev-page-structure-preview .carousel-track::before,
    .dev-page-structure-preview .carousel-track::after {
        content: "";
        flex: 0 0 calc((100% - var(--slide-width, 100%)) / 2);
        pointer-events: none;
    }
    .dev-page-structure-preview .carousel-track::before {
        margin-inline-end: -0.5rem;
    }
    .dev-page-structure-preview .carousel-track::after {
        margin-inline-start: -0.5rem;
    }
    .dev-page-structure-preview .carousel-track::-webkit-scrollbar { display: none; }
    .dev-page-structure-preview .carousel-track > * {
        flex: 0 0 var(--slide-width, 100%);
        min-width: 0;
        opacity: 0.65;
        transform: scale(0.95);
        scroll-snap-align: center;
        transition: opacity 0.4s ease, transform 0.4s ease;
    }
    .dev-page-structure-preview .carousel-track > [data-active],
    .dev-page-structure-preview .carousel-track > :hover,
    .dev-page-structure-preview .carousel-track > :focus-within {
        opacity: 1;
        transform: scale(1);
    }
    .dev-page-structure-preview .carousel-dots {
        display: flex;
        min-height: 1.5rem;
        align-items: center;
        justify-content: center;
        gap: 0.35rem;
    }
    .dev-page-structure-preview .carousel-dot {
        width: 6px;
        height: 6px;
        padding: 0;
        border: 0;
        border-radius: 9999px;
        background: rgba(200, 200, 200, 0.25);
    }
    .dev-page-structure-preview .carousel-dot.active {
        width: 18px;
        background: rgba(255, 255, 255, 0.8);
    }
    .dev-page-structure-preview.photo-panorama-section .photo-panorama-track {
        display: flex;
        width: 100%;
        gap: 0;
        padding-block: 3.5rem;
        margin-block: -3.5rem;
        scrollbar-width: none;
    }
    .dev-page-structure-preview.photo-panorama-section[data-view="carousel"] .photo-panorama-track {
        overflow-x: auto;
        scroll-snap-type: x mandatory;
    }
    .dev-page-structure-preview.photo-panorama-section[data-view="carousel"] .photo-panorama-track > * {
        flex: 0 0 100%;
        min-width: 0;
        scroll-snap-align: start;
    }
    .dev-page-structure-preview.photo-panorama-section[data-view="panorama"] .photo-panorama-track {
        overflow: visible;
    }
    .dev-page-structure-preview.photo-panorama-section[data-view="panorama"] .photo-panorama-track > * {
        flex: var(--panorama-grow, 100) 1 0%;
        min-width: 0;
    }
    .dev-page-structure-preview[data-single-photo-sliced] .photo-panorama-single-source {
        display: none;
    }
    .dev-page-structure-preview .photo-panorama-slice .photo-wrapper {
        overflow: visible;
    }
    .dev-page-structure-preview .photo-panorama-slice .photo-wrapper > .pswp-link {
        width: var(--panorama-slice-width);
        max-width: none;
        transform: translateX(var(--panorama-slice-offset));
        clip-path: inset(0 var(--panorama-slice-clip-end) 0 var(--panorama-slice-clip-start));
    }
    @media (min-width: 768px) and (hover: hover) {
