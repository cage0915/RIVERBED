---
interface Props {
  align?: 'left' | 'center' | 'right';
  size?: 'caption' | 'title';
  mt?: string;
  mb?: string;
}

const { align = 'center', size = 'caption', mt = '2rem', mb = '0.5rem' } = Astro.props;

const style = [
  `margin-top: ${mt};`,
  `margin-bottom: ${mb};`,
  `text-align: ${align};`,
].join(' ');
---

<div class:list={["text-block", `text-block--${size}`]} style={style}>
  <slot />
</div>

<style>
  .text-block {
    width: 100%;
    font-family: "PT Sans", "Noto Sans TC", "Noto Sans JP", sans-serif;
  }

  /* caption size: same as photo-caption in Row.astro */
  .text-block--caption {
    font-size: 0.875rem;
    font-weight: 300;
    letter-spacing: 0.05em;
    color: white;
  }

  /* title size: slightly bigger, for section titles */
  .text-block--title {
    font-size: 1.125rem;
    font-weight: 400;
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.72);
  }

  .text-block :global(a) {
    color: inherit;
    text-decoration-line: underline;
    text-decoration-color: rgba(161, 161, 170, 0.7);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    transition: color 0.2s ease, text-decoration-color 0.2s ease;
  }

  .text-block :global(a:hover) {
    color: rgb(244 244 245);
    text-decoration-color: currentColor;
  }
</style>
