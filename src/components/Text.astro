---
interface Props {
  align?: 'left' | 'center' | 'right';
  size?: 'caption' | 'title';
  blockMargin?: string;
  mb?: string; // legacy alias
}

const { align = 'center', size = 'caption', blockMargin, mb } = Astro.props;
const finalBlockMargin = blockMargin || mb || '0.5rem';
const isDev = import.meta.env.DEV;

const style = [
  `margin-bottom: ${finalBlockMargin};`,
  `text-align: ${align};`,
].join(' ');
---

<div
  class:list={["text-block", `text-block--${size}`]}
  style={style}
  data-dev-block={isDev ? "text" : undefined}
  data-dev-text-align={isDev ? align : undefined}
  data-dev-text-type={isDev ? size : undefined}
  data-dev-block-margin={isDev && (blockMargin || mb) ? blockMargin || mb : undefined}
>
  <div class="text-block__content"><slot /></div>
</div>

<style>
  .text-block {
    width: 100%;
    font-family: "Noto Sans TC", "Noto Sans JP", sans-serif;
  }

  /* caption size: same as photo-caption in Row.astro */
  .text-block--caption {
    font-size: 0.875rem;
    font-weight: 300;
    letter-spacing: 0.05em;
    color: #898989;
  }

  /* title size: slightly bigger, for section titles */
  .text-block--title {
    font-size: 1.125rem;
    font-weight: 400;
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.72);
  }

  .text-block :global(a) {
    color: inherit;
    text-decoration-line: underline;
    text-decoration-color: rgba(161, 161, 170, 0.7);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    transition: color 0.2s ease, text-decoration-color 0.2s ease;
  }

  .text-block :global(a:hover) {
    color: rgb(244 244 245);
    text-decoration-color: currentColor;
  }
</style>
