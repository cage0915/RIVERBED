---
import MountainViewer from "./MountainViewer.astro";
import RichText from "./RichText.astro";
import { isMapContextId } from "../lib/mountain-map";
import type { Mountain } from "../lib/mountain-schema";
import { resolveFeatureFlag } from "../lib/feature-flags";

interface Props {
    mountain: Mountain;
}

const { mountain } = Astro.props;
const peakFinderEnabled = resolveFeatureFlag(
    import.meta.env.PEAKFINDER_ENABLED,
    true,
);
const description = mountain.description.trim();
const location = mountain.location;
const hasValidCoordinates =
    location !== undefined &&
    Number.isFinite(location.latitude) &&
    location.latitude >= -90 &&
    location.latitude <= 90 &&
    Number.isFinite(location.longitude) &&
    location.longitude >= -180 &&
    location.longitude <= 180;
const hasMap =
    hasValidCoordinates &&
    location !== undefined &&
    isMapContextId(location.mapContext);
---

<section
    class:list={[
        "mountain-profile",
        "mountain-profile--split",
        !hasMap && "mountain-profile--empty-map",
    ]}
    aria-label={`${mountain.name} basic information`}
>
    <div class="mountain-profile__details">
        <h1
            class:list={[
                "mountain-profile__name",
                mountain.alternateName && "mountain-profile__name--with-alternate",
            ]}
        >
            {mountain.name}
        </h1>
        {mountain.alternateName && (
            <p class="mountain-profile__alternate-name">
                {mountain.alternateName}
            </p>
        )}
        {mountain.elevation !== null && (
            <p class="mountain-profile__elevation">
                <span>{mountain.elevation.toLocaleString("en-US")}</span>
                <span class="mountain-profile__unit">m</span>
            </p>
        )}
        {description && (
            <p class="mountain-profile__description">
                <RichText text={description} />
            </p>
        )}
    </div>

    {hasMap && location && isMapContextId(location.mapContext) && (
        <MountainViewer
            latitude={location.latitude}
            longitude={location.longitude}
            contextId={location.mapContext}
            mountainName={mountain.name}
            elevation={mountain.elevation}
            panorama={mountain.panorama}
            initialBounds={location.initialBounds}
            peakFinderEnabled={peakFinderEnabled}
        />
    )}
    {!hasMap && (
        <div class="mountain-profile__viewer-placeholder" aria-hidden="true" />
    )}
</section>

<style>
    .mountain-profile {
        display: grid;
        gap: 2rem;
        margin: 0 auto 4rem;
        padding: 1.5rem 0;
        border-top: 1px solid rgb(255 255 255 / 0.07);
        border-bottom: 1px solid rgb(255 255 255 / 0.07);
    }

    .mountain-profile--split {
        grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
        align-items: start;
    }

    .mountain-profile--single {
        grid-template-columns: minmax(0, 1fr);
    }

    .mountain-profile__viewer-placeholder {
        min-width: 0;
        padding-top: 2.25rem;
        padding-bottom: 1rem;
    }

    .mountain-profile__viewer-placeholder::after {
        display: block;
        width: 100%;
        aspect-ratio: 16 / 10;
        content: "";
    }

    .mountain-profile__details {
        min-width: 0;
        padding: 0;
    }

    @media (min-width: 768px) {
        .mountain-profile--split:not(.mountain-profile--empty-map)
            .mountain-profile__details {
            display: flex;
            height: var(--mountain-details-height, auto);
            box-sizing: border-box;
            flex-direction: column;
            padding-top: var(--mountain-details-offset, 0);
        }

        .mountain-profile--split:not(.mountain-profile--empty-map)
            .mountain-profile__description {
            min-height: 0;
            max-height: none;
            flex: 1;
        }
    }

    .mountain-profile__name {
        margin: 0 0 1.5rem;
        color: rgb(244 244 245);
        font-family: "Noto Sans TC", "Noto Sans JP", sans-serif;
        font-size: clamp(1.75rem, 3.8vw, 2.5rem);
        font-weight: 400;
        line-height: 1;
        letter-spacing: 0.1em;
    }

    .mountain-profile__name--with-alternate {
        margin-bottom: 0.45rem;
    }

    .mountain-profile__alternate-name {
        margin: 0 0 1.5rem 0.35rem;
        color: rgb(113 113 122);
        font-family: "Noto Sans TC", "Noto Sans JP", sans-serif;
        font-size: 0.8125rem;
        font-weight: 300;
        letter-spacing: 0.08em;
    }

    .mountain-profile__elevation {
        display: flex;
        align-items: baseline;
        gap: 0.45rem;
        margin: 0;
        color: rgb(244 244 245);
        font-family: "PT Sans", sans-serif;
        font-size: clamp(1.25rem, 2.333vw, 1.833rem);
        font-weight: 400;
        line-height: 1;
        letter-spacing: -0.025em;
    }

    .mountain-profile__unit {
        color: rgb(113 113 122);
        font-size: 0.875rem;
        letter-spacing: 0.12em;
    }

    .mountain-profile__description {
        max-width: 32rem;
        max-height: min(18rem, 40vh);
        margin: 1.5rem 0 0;
        padding-right: 0.75rem;
        overflow-y: auto;
        overscroll-behavior: contain;
        scrollbar-color: rgb(113 113 122 / 0.65) transparent;
        scrollbar-width: thin;
        color: rgb(161 161 170);
        font-size: 0.8125rem;
        font-weight: 300;
        line-height: 1.9;
        letter-spacing: 0.035em;
    }

    .mountain-profile__description::-webkit-scrollbar {
        width: 4px;
    }

    .mountain-profile__description::-webkit-scrollbar-thumb {
        border-radius: 999px;
        background: rgb(113 113 122 / 0.65);
    }

    @media (max-width: 767px) {
        .mountain-profile,
        .mountain-profile--split {
            grid-template-columns: minmax(0, 1fr);
        }

        .mountain-profile {
            gap: 1.5rem;
            margin-bottom: 3rem;
            padding: 1.25rem 0;
        }

        .mountain-profile__details {
            padding: 0 0.25rem;
        }

        .mountain-profile__viewer-placeholder {
            display: none;
        }

        .mountain-profile__name {
            margin-bottom: 1.25rem;
        }

        .mountain-profile__name--with-alternate {
            margin-bottom: 0.4rem;
        }

        .mountain-profile__alternate-name {
            margin-bottom: 1.25rem;
        }
    }
</style>

<script>
    import { installPageLifecycle } from "../lib/client-page-lifecycle";

    installPageLifecycle(document, () => {
        const mountedProfiles: Array<{
            profile: HTMLElement;
            resizeObserver: ResizeObserver;
            panelObserver: MutationObserver;
            cancelFrame: () => void;
        }> = [];

        document
            .querySelectorAll<HTMLElement>(".mountain-profile--split")
            .forEach((profile) => {
                if (profile.dataset.sizingReady === "true") return;

                const details = profile.querySelector<HTMLElement>(
                    ".mountain-profile__details",
                );
                const viewer = profile.querySelector<HTMLElement>(
                    ".mountain-viewer",
                );
                if (!details || !viewer) return;
                profile.dataset.sizingReady = "true";

                let animationFrame = 0;
                const updateSizing = () => {
                    cancelAnimationFrame(animationFrame);
                    animationFrame = requestAnimationFrame(() => {
                        animationFrame = 0;
                        if (!window.matchMedia("(min-width: 768px)").matches) {
                            profile.style.removeProperty("--mountain-details-height");
                            profile.style.removeProperty("--mountain-details-offset");
                            return;
                        }

                        const frame = viewer.querySelector<HTMLElement>(
                            ".mountain-viewer__panel:not([hidden]) .mountain-map__frame, .mountain-viewer__panel:not([hidden]) .mountain-viewer__panorama-shell",
                        );
                        if (!frame) return;

                        const detailsRect = details.getBoundingClientRect();
                        const frameRect = frame.getBoundingClientRect();
                        const tabs = viewer.querySelector<HTMLElement>(
                            ".mountain-viewer__tabs",
                        );
                        const contentTop = tabs
                            ? tabs.getBoundingClientRect().bottom
                            : frameRect.top;
                        profile.style.setProperty(
                            "--mountain-details-offset",
                            `${Math.max(0, contentTop - detailsRect.top)}px`,
                        );
                        profile.style.setProperty(
                            "--mountain-details-height",
                            `${Math.max(0, frameRect.bottom - detailsRect.top)}px`,
                        );
                    });
                };

                const resizeObserver = new ResizeObserver(updateSizing);
                resizeObserver.observe(profile);
                resizeObserver.observe(viewer);

                const panelObserver = new MutationObserver(updateSizing);
                panelObserver.observe(viewer, {
                    attributes: true,
                    attributeFilter: ["hidden"],
                    subtree: true,
                });

                updateSizing();
                mountedProfiles.push({
                    profile,
                    resizeObserver,
                    panelObserver,
                    cancelFrame: () => cancelAnimationFrame(animationFrame),
                });
            });

        return () => {
            mountedProfiles.forEach(({
                profile,
                resizeObserver,
                panelObserver,
                cancelFrame,
            }) => {
                resizeObserver.disconnect();
                panelObserver.disconnect();
                cancelFrame();
                delete profile.dataset.sizingReady;
                profile.style.removeProperty("--mountain-details-height");
                profile.style.removeProperty("--mountain-details-offset");
            });
        };
    });
</script>
