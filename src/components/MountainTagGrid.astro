---
import { getThumbnailUrl, R2_DOMAIN } from "../lib/constants";
import {
    DEFAULT_MOUNTAIN_TAG_SORT,
    sortMountainTags,
} from "../lib/mountain-tag-sort";
import { DEFAULT_MOUNTAIN_VIEW_SETTINGS } from "../lib/mountain-view-settings";
import { getMountainContourAssetUrl } from "../lib/mountain-contours";

interface MountainTagCard {
    name: string;
    elevation: number;
    latitude: number;
    longitude: number;
    coverKey?: string;
}

interface MountainTagGroup {
    id: string;
    label: string;
    mountains: MountainTagCard[];
}

interface Props {
    groups: MountainTagGroup[];
    tagColumns?: number;
}

const {
    groups,
    tagColumns = DEFAULT_MOUNTAIN_VIEW_SETTINGS.tagColumns,
} = Astro.props;
const sortedGroups = groups.map((group) => ({
    ...group,
    mountains: sortMountainTags(group.mountains, DEFAULT_MOUNTAIN_TAG_SORT),
}));
---

<div
    class="mountain-tag-view"
    data-mountain-tag-sort
    data-mountain-tag-grid
    style={`--mountain-tag-columns: ${tagColumns}`}
>
    <div
        class="mountain-tag-sort-toolbar"
        role="group"
        aria-label="Mountain tag sorting"
    >
        <button
            class="mountain-tag-sort-badge is-active"
            type="button"
            data-sort-key="elevation"
            aria-pressed="true"
        >
            <span>高度</span>
            <span data-sort-icon aria-hidden="true">↓</span>
        </button>
        <button
            class="mountain-tag-sort-badge"
            type="button"
            data-sort-key="latitude"
            aria-pressed="false"
        >
            <span>緯度</span>
            <span data-sort-icon aria-hidden="true">↕</span>
        </button>
    </div>

    <div class="mountain-tag-groups">
    {
        sortedGroups.filter((group) => group.mountains.length > 0).map((group) => (
            <section class="mountain-tag-group" aria-labelledby={`mountain-region-${group.id}`}>
                <h2 id={`mountain-region-${group.id}`} class="mountain-tag-group__title">
                    {group.label}
                </h2>
                <div class="mountain-tag-grid">
                    {group.mountains.map((mountain) => {
                        const coverUrl = mountain.coverKey
                            ? getThumbnailUrl(mountain.coverKey, 480)
                            : undefined;
                        const fallbackUrl = mountain.coverKey
                            ? `${R2_DOMAIN}/${mountain.coverKey}`
                            : undefined;
                        const contourUrl = getMountainContourAssetUrl(
                            group.id,
                            mountain.name,
                        );

                        return (
                            <article
                                class:list={[
                                    "mountain-tag-card",
                                    !coverUrl && "mountain-tag-card--without-cover",
                                ]}
                                data-mountain-name={mountain.name}
                                data-mountain-elevation={mountain.elevation}
                                data-mountain-latitude={mountain.latitude}
                                data-mountain-longitude={mountain.longitude}
                            >
                                <a
                                    href={`/yama/tags/${encodeURIComponent(mountain.name)}`}
                                    class="mountain-tag-card__link"
                                >
                                    {coverUrl && (
                                        <img
                                            src={coverUrl}
                                            alt={`${mountain.name} cover photo`}
                                            loading="lazy"
                                            decoding="async"
                                            onerror={
                                                fallbackUrl
                                                    ? `this.onerror=null; this.src='${fallbackUrl}';`
                                                    : undefined
                                            }
                                        />
                                    )}
                                    <div class="mountain-tag-card__overlay">
                                        <img
                                            class="mountain-tag-card__contours"
                                            data-contour-src={contourUrl}
                                            alt=""
                                            aria-hidden="true"
                                            decoding="async"
                                        />
                                        <h3>{mountain.name}</h3>
                                        <p>
                                            {mountain.elevation.toLocaleString("en-US")}
                                            <span>m</span>
                                        </p>
                                    </div>
                                </a>
                            </article>
                        );
                    })}
                </div>
            </section>
        ))
    }
    </div>

    <p class="mountain-contour-attribution">
        等高線資料：<a href="https://data.gov.tw/dataset/35430/" target="_blank" rel="noreferrer">內政部 20m DTM</a>
        ・<a href="https://maps.gsi.go.jp/development/ichiran.html#dem" target="_blank" rel="noreferrer">日本國土地理院標高圖磚</a>
    </p>
</div>

<script>
    import {
        DEFAULT_MOUNTAIN_TAG_SORT,
        nextMountainTagSort,
        sortMountainTags,
        type MountainTagSort,
        type MountainTagSortKey,
    } from "../lib/mountain-tag-sort";
    import { installPageLifecycle } from "../lib/client-page-lifecycle";

    installPageLifecycle(document, () => {
        const root = document.querySelector<HTMLElement>(
            "[data-mountain-tag-grid]",
        );
        if (!root) return;

        const controller = new AbortController();
        root.dataset.sortReady = "true";
        let currentSort: MountainTagSort | null = {
            ...DEFAULT_MOUNTAIN_TAG_SORT,
        };
        const buttons = Array.from(
            root.querySelectorAll<HTMLButtonElement>("[data-sort-key]"),
        );
        const cards = Array.from(
            root.querySelectorAll<HTMLElement>(".mountain-tag-card"),
        );

        const loadContours = (card: HTMLElement) => {
            const image = card.querySelector<HTMLImageElement>(
                "img[data-contour-src]",
            );
            if (!image || image.dataset.contourLoading) return;
            image.dataset.contourLoading = "true";

            const markReady = () => {
                if (controller.signal.aborted) return;
                image.classList.add("is-ready");
            };
            const decodeAndMarkReady = () => {
                image.decode().then(markReady).catch(() => {
                    if (image.complete && image.naturalWidth > 0) {
                        markReady();
                    }
                });
            };
            image.addEventListener("load", decodeAndMarkReady, {
                once: true,
                signal: controller.signal,
            });
            image.src = image.dataset.contourSrc ?? "";
            decodeAndMarkReady();
        };

        let contourObserver: IntersectionObserver | undefined;
        if ("IntersectionObserver" in window) {
            contourObserver = new IntersectionObserver(
                (entries) => {
                    entries.forEach((entry) => {
                        if (!entry.isIntersecting) return;
                        const card = entry.target as HTMLElement;
                        loadContours(card);
                        contourObserver?.unobserve(card);
                    });
                },
                { rootMargin: "600px 0px" },
            );
            cards.forEach((card) => contourObserver?.observe(card));
        } else {
            cards.forEach(loadContours);
        }

        const updateButtons = () => {
            buttons.forEach((button) => {
                const key = button.dataset.sortKey as MountainTagSortKey;
                const isActive = currentSort?.key === key;
                button.classList.toggle("is-active", isActive);
                button.setAttribute("aria-pressed", String(isActive));
                const icon = button.querySelector<HTMLElement>(
                    "[data-sort-icon]",
                );
                if (icon) {
                    icon.textContent = isActive
                        ? currentSort?.direction === "desc"
                            ? "↓"
                            : "↑"
                        : "↕";
                }
            });
        };

        const sortGroups = () => {
            root.querySelectorAll<HTMLElement>(".mountain-tag-grid")
                .forEach((grid) => {
                    const cards = Array.from(
                        grid.querySelectorAll<HTMLElement>(
                            ":scope > .mountain-tag-card",
                        ),
                    ).map((element) => ({
                        element,
                        name: element.dataset.mountainName || "",
                        elevation: Number(element.dataset.mountainElevation),
                        latitude: Number(element.dataset.mountainLatitude),
                    }));

                    sortMountainTags(cards, currentSort).forEach(
                        ({ element }) => grid.appendChild(element),
                    );
                });
        };

        buttons.forEach((button) => {
            button.addEventListener("click", () => {
                currentSort = nextMountainTagSort(
                    currentSort,
                    button.dataset.sortKey as MountainTagSortKey,
                );
                sortGroups();
                updateButtons();
            }, { signal: controller.signal });
        });

        cards.forEach((card) => {
            card.addEventListener("pointerenter", () => loadContours(card), {
                signal: controller.signal,
            });
            card.addEventListener("focusin", () => loadContours(card), {
                signal: controller.signal,
            });
            card.addEventListener("click", (event) => {
                const isMobile = window.matchMedia(
                    "(max-width: 768px) and (hover: none)",
                ).matches;
                if (!isMobile || card.classList.contains("show-info")) {
                    return;
                }

                event.preventDefault();
                loadContours(card);
                cards.forEach((otherCard) =>
                    otherCard.classList.remove("show-info"),
                );
                card.classList.add("show-info");
            }, { signal: controller.signal });
        });

        document.addEventListener("click", (event) => {
            const target = event.target;
            if (target instanceof Element) {
                const targetCard = target.closest(".mountain-tag-card");
                if (targetCard && root.contains(targetCard)) return;
                cards.forEach((card) =>
                    card.classList.remove("show-info"),
                );
            }
        }, { signal: controller.signal });

        sortGroups();
        updateButtons();

        return () => {
            controller.abort();
            contourObserver?.disconnect();
            delete root.dataset.sortReady;
            cards.forEach((card) => {
                card.classList.remove("show-info");
                const image = card.querySelector<HTMLImageElement>(
                    "img[data-contour-src]",
                );
                if (image && !image.classList.contains("is-ready")) {
                    delete image.dataset.contourLoading;
                }
            });
        };
    });
</script>

<style>
    .mountain-tag-sort-toolbar {
        display: flex;
        justify-content: flex-end;
        gap: 0.45rem;
        margin-bottom: 1rem;
    }

    .mountain-tag-sort-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        padding: 0.2rem 0.5rem;
        border: 1px solid rgb(255 255 255 / 0.14);
        border-radius: 999px;
        background: rgb(255 255 255 / 0.04);
        color: rgb(161 161 170);
        font: inherit;
        font-size: 0.65rem;
        line-height: 1.2;
        cursor: pointer;
        transition:
            border-color 0.18s ease,
            background 0.18s ease,
            color 0.18s ease;
    }

    .mountain-tag-sort-badge:hover {
        border-color: rgb(255 255 255 / 0.3);
        color: rgb(228 228 231);
    }

    .mountain-tag-sort-badge.is-active {
        border-color: rgb(255 255 255 / 0.72);
        background: rgb(255 255 255 / 0.2);
        color: white;
        backdrop-filter: blur(4px);
    }

    .mountain-tag-groups {
        display: flex;
        flex-direction: column;
        gap: 4rem;
    }

    .mountain-tag-group__title {
        margin: 0 0 1rem;
        color: rgb(161 161 170);
        font-family: "Noto Sans TC", "Noto Sans JP", sans-serif;
        font-size: 0.75rem;
        font-weight: 400;
        letter-spacing: 0.18em;
    }

    .mountain-tag-grid {
        display: grid;
        grid-template-columns: repeat(
            var(--mountain-tag-columns, 5),
            minmax(0, 1fr)
        );
        gap: 0.3rem;
    }

    .mountain-tag-card {
        position: relative;
        min-width: 0;
        background: #1a1a1a;
    }

    .mountain-tag-card__link {
        position: relative;
        display: block;
        aspect-ratio: 177 / 100;
        overflow: hidden;
        color: inherit;
        text-decoration: none;
        container-type: inline-size;
    }

    .mountain-tag-card img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition:
            transform 0.6s cubic-bezier(0.16, 1, 0.3, 1),
            opacity 0.4s ease;
    }

    .mountain-tag-card .mountain-tag-card__contours {
        position: absolute;
        inset: 0;
        z-index: 3;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0;
        transform: none;
        transition: opacity 0.4s ease;
    }

    .mountain-tag-card__overlay {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: clamp(0.4rem, 8cqw, 1.5rem);
        z-index: 2;
        background: rgb(255 255 255 / 0.74);
        color: #111827;
        opacity: 0;
        transition: opacity 0.4s ease;
    }

    .mountain-tag-card__overlay h3 {
        position: relative;
        z-index: 4;
        margin: 0;
        font-family: "Noto Sans TC", "Noto Sans JP", sans-serif;
        font-size: clamp(0.65rem, 9cqw, 1.25rem);
        font-weight: 400;
        letter-spacing: 0.08em;
        text-align: center;
    }

    .mountain-tag-card__overlay p {
        position: relative;
        z-index: 4;
        display: flex;
        align-items: baseline;
        gap: 0.3rem;
        margin: 0.6rem 0 0;
        font-family: "PT Sans", sans-serif;
        font-size: clamp(0.55rem, 6cqw, 1rem);
    }

    .mountain-tag-card__overlay p span {
        font-size: clamp(0.45rem, 4cqw, 0.65rem);
        letter-spacing: 0.1em;
    }

    .mountain-tag-card--without-cover .mountain-tag-card__overlay {
        opacity: 1;
        background: #1a1a1a;
        color: rgb(228 228 231);
    }

    @media (hover: hover) {
        .mountain-tag-card:hover img:not(.mountain-tag-card__contours),
        .mountain-tag-card:focus-within img:not(.mountain-tag-card__contours) {
            opacity: 0;
            transform: scale(1.05);
        }

        .mountain-tag-card:hover .mountain-tag-card__contours.is-ready,
        .mountain-tag-card:focus-within .mountain-tag-card__contours.is-ready {
            opacity: 0.82;
        }

        .mountain-tag-card:hover .mountain-tag-card__overlay,
        .mountain-tag-card:focus-within .mountain-tag-card__overlay {
            opacity: 1;
        }

        .mountain-tag-card--without-cover:hover .mountain-tag-card__overlay,
        .mountain-tag-card--without-cover:focus-within .mountain-tag-card__overlay {
            background: rgb(255 255 255 / 0.92);
            color: #111827;
        }
    }

    @media (max-width: 768px) and (hover: none) {
        .mountain-tag-card.show-info img:not(.mountain-tag-card__contours) {
            opacity: 0;
            transform: scale(1.05);
        }

        .mountain-tag-card.show-info .mountain-tag-card__contours.is-ready {
            opacity: 0.82;
        }

        .mountain-tag-card.show-info .mountain-tag-card__overlay {
            opacity: 1;
        }

        .mountain-tag-card--without-cover.show-info .mountain-tag-card__overlay {
            background: rgb(255 255 255 / 0.92);
            color: #111827;
        }
    }

    .mountain-contour-attribution {
        margin: 2rem 0 0;
        color: rgb(82 82 91);
        font-size: 0.5625rem;
        letter-spacing: 0.03em;
        text-align: right;
    }

    .mountain-contour-attribution a {
        color: inherit;
        transition: color 160ms ease;
    }

    .mountain-contour-attribution a:hover {
        color: rgb(161 161 170);
    }

    @media (prefers-reduced-motion: reduce) {
        .mountain-tag-card .mountain-tag-card__contours {
            transition: none;
        }
    }

    @media (max-width: 1024px) {
        .mountain-tag-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 640px) {
        .mountain-tag-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 2px;
        }

        .mountain-tag-card__link {
            aspect-ratio: 1;
        }

        .mountain-tag-card img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .mountain-tag-card:not(.mountain-tag-card--without-cover)
            .mountain-tag-card__overlay {
            display: none;
        }

        .mountain-tag-card.show-info:not(.mountain-tag-card--without-cover)
            .mountain-tag-card__overlay {
            display: flex;
        }

        .mountain-tag-card--without-cover .mountain-tag-card__overlay {
            padding: 0.35rem;
        }

        .mountain-tag-card--without-cover .mountain-tag-card__overlay h3 {
            font-size: 0.65rem;
            letter-spacing: 0.02em;
        }

        .mountain-tag-card--without-cover .mountain-tag-card__overlay p {
            margin-top: 0.25rem;
            font-size: 0.55rem;
        }
    }
</style>
