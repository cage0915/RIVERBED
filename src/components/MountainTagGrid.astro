---
import { getImageUrl, R2_DOMAIN } from "../lib/constants";
import {
    DEFAULT_MOUNTAIN_TAG_SORT,
    sortMountainTags,
} from "../lib/mountain-tag-sort";
import { DEFAULT_MOUNTAIN_VIEW_SETTINGS } from "../lib/mountain-view-settings";

interface MountainTagCard {
    name: string;
    elevation: number;
    latitude: number;
    coverKey?: string;
}

interface MountainTagGroup {
    id: string;
    label: string;
    mountains: MountainTagCard[];
}

interface Props {
    groups: MountainTagGroup[];
    tagColumns?: number;
}

const {
    groups,
    tagColumns = DEFAULT_MOUNTAIN_VIEW_SETTINGS.tagColumns,
} = Astro.props;
const isDev = import.meta.env.DEV;
const sortedGroups = groups.map((group) => ({
    ...group,
    mountains: sortMountainTags(group.mountains, DEFAULT_MOUNTAIN_TAG_SORT),
}));
---

<div
    class="mountain-tag-view"
    data-mountain-tag-sort
    style={`--mountain-tag-columns: ${tagColumns}`}
>
    <div
        class="mountain-tag-sort-toolbar"
        role="group"
        aria-label="Mountain tag sorting"
    >
        <button
            class="mountain-tag-sort-badge is-active"
            type="button"
            data-sort-key="elevation"
            aria-pressed="true"
        >
            <span>高度</span>
            <span data-sort-icon aria-hidden="true">↓</span>
        </button>
        <button
            class="mountain-tag-sort-badge"
            type="button"
            data-sort-key="latitude"
            aria-pressed="false"
        >
            <span>緯度</span>
            <span data-sort-icon aria-hidden="true">↕</span>
        </button>
    </div>

    <div class="mountain-tag-groups">
    {
        sortedGroups.filter((group) => group.mountains.length > 0).map((group) => (
            <section class="mountain-tag-group" aria-labelledby={`mountain-region-${group.id}`}>
                <h2 id={`mountain-region-${group.id}`} class="mountain-tag-group__title">
                    {group.label}
                </h2>
                <div class="mountain-tag-grid">
                    {group.mountains.map((mountain) => {
                        const coverUrl = mountain.coverKey
                            ? getImageUrl(mountain.coverKey)
                            : undefined;
                        const fallbackUrl = mountain.coverKey
                            ? `${R2_DOMAIN}/${mountain.coverKey}`
                            : undefined;

                        return (
                            <article
                                class:list={[
                                    "mountain-tag-card",
                                    !coverUrl && "mountain-tag-card--without-cover",
                                ]}
                                data-mountain-name={mountain.name}
                                data-mountain-elevation={mountain.elevation}
                                data-mountain-latitude={mountain.latitude}
                            >
                                <a
                                    href={`/tags/${encodeURIComponent(mountain.name)}`}
                                    class="mountain-tag-card__link"
                                >
                                    {coverUrl && (
                                        <img
                                            src={coverUrl}
                                            alt={`${mountain.name} cover photo`}
                                            loading="lazy"
                                            onerror={
                                                isDev && fallbackUrl
                                                    ? `this.onerror=null; this.src='${fallbackUrl}';`
                                                    : undefined
                                            }
                                        />
                                    )}
                                    <div class="mountain-tag-card__overlay">
                                        <h3>{mountain.name}</h3>
                                        <p>
                                            {mountain.elevation.toLocaleString("en-US")}
                                            <span>m</span>
                                        </p>
                                    </div>
                                </a>
                            </article>
                        );
                    })}
                </div>
            </section>
        ))
    }
    </div>
</div>

<script>
    import {
        DEFAULT_MOUNTAIN_TAG_SORT,
        nextMountainTagSort,
        sortMountainTags,
        type MountainTagSort,
        type MountainTagSortKey,
    } from "../lib/mountain-tag-sort";

    const initMountainTagSort = () => {
        document
            .querySelectorAll<HTMLElement>("[data-mountain-tag-sort]")
            .forEach((view) => {
                if (view.dataset.sortReady) return;
                view.dataset.sortReady = "true";

                let currentSort: MountainTagSort | null = {
                    ...DEFAULT_MOUNTAIN_TAG_SORT,
                };
                const buttons = Array.from(
                    view.querySelectorAll<HTMLButtonElement>("[data-sort-key]"),
                );

                const updateButtons = () => {
                    buttons.forEach((button) => {
                        const key = button.dataset.sortKey as MountainTagSortKey;
                        const isActive = currentSort?.key === key;
                        button.classList.toggle("is-active", isActive);
                        button.setAttribute("aria-pressed", String(isActive));
                        const icon = button.querySelector<HTMLElement>(
                            "[data-sort-icon]",
                        );
                        if (icon) {
                            icon.textContent = isActive
                                ? currentSort?.direction === "desc"
                                    ? "↓"
                                    : "↑"
                                : "↕";
                        }
                    });
                };

                const sortGroups = () => {
                    view.querySelectorAll<HTMLElement>(".mountain-tag-grid")
                        .forEach((grid) => {
                            const cards = Array.from(
                                grid.querySelectorAll<HTMLElement>(
                                    ":scope > .mountain-tag-card",
                                ),
                            ).map((element) => ({
                                element,
                                name: element.dataset.mountainName || "",
                                elevation: Number(
                                    element.dataset.mountainElevation,
                                ),
                                latitude: Number(
                                    element.dataset.mountainLatitude,
                                ),
                            }));

                            sortMountainTags(cards, currentSort).forEach(
                                ({ element }) => grid.appendChild(element),
                            );
                        });
                };

                buttons.forEach((button) => {
                    button.addEventListener("click", () => {
                        currentSort = nextMountainTagSort(
                            currentSort,
                            button.dataset.sortKey as MountainTagSortKey,
                        );
                        sortGroups();
                        updateButtons();
                    });
                });
            });
    };

    initMountainTagSort();
    document.addEventListener("astro:after-swap", initMountainTagSort);
</script>

<style>
    .mountain-tag-sort-toolbar {
        display: flex;
        justify-content: flex-end;
        gap: 0.45rem;
        margin-bottom: 1rem;
    }

    .mountain-tag-sort-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        padding: 0.2rem 0.5rem;
        border: 1px solid rgb(255 255 255 / 0.14);
        border-radius: 999px;
        background: rgb(255 255 255 / 0.04);
        color: rgb(161 161 170);
        font: inherit;
        font-size: 0.65rem;
        line-height: 1.2;
        cursor: pointer;
        transition:
            border-color 0.18s ease,
            background 0.18s ease,
            color 0.18s ease;
    }

    .mountain-tag-sort-badge:hover {
        border-color: rgb(255 255 255 / 0.3);
        color: rgb(228 228 231);
    }

    .mountain-tag-sort-badge.is-active {
        border-color: rgb(255 255 255 / 0.72);
        background: rgb(255 255 255 / 0.2);
        color: white;
        backdrop-filter: blur(4px);
    }

    .mountain-tag-groups {
        display: flex;
        flex-direction: column;
        gap: 4rem;
    }

    .mountain-tag-group__title {
        margin: 0 0 1rem;
        color: rgb(161 161 170);
        font-family: "Noto Sans TC", "Noto Sans JP", sans-serif;
        font-size: 0.75rem;
        font-weight: 400;
        letter-spacing: 0.18em;
    }

    .mountain-tag-grid {
        display: grid;
        grid-template-columns: repeat(
            var(--mountain-tag-columns, 5),
            minmax(0, 1fr)
        );
        gap: 0.5rem;
    }

    .mountain-tag-card {
        position: relative;
        min-width: 0;
        background: #1a1a1a;
    }

    .mountain-tag-card__link {
        position: relative;
        display: block;
        aspect-ratio: 177 / 100;
        overflow: hidden;
        color: inherit;
        text-decoration: none;
    }

    .mountain-tag-card img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .mountain-tag-card__overlay {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
        background: rgb(255 255 255 / 0.68);
        color: #111827;
        opacity: 0;
        transition: opacity 0.4s ease;
    }

    .mountain-tag-card__overlay h3 {
        margin: 0;
        font-family: "Noto Sans TC", "Noto Sans JP", sans-serif;
        font-size: 1.25rem;
        font-weight: 400;
        letter-spacing: 0.08em;
        text-align: center;
    }

    .mountain-tag-card__overlay p {
        display: flex;
        align-items: baseline;
        gap: 0.3rem;
        margin: 0.6rem 0 0;
        font-family: "PT Sans", sans-serif;
        font-size: 1rem;
    }

    .mountain-tag-card__overlay p span {
        font-size: 0.65rem;
        letter-spacing: 0.1em;
    }

    .mountain-tag-card--without-cover .mountain-tag-card__overlay {
        opacity: 1;
        background: #1a1a1a;
        color: rgb(228 228 231);
    }

    @media (hover: hover) {
        .mountain-tag-card:hover img {
            transform: scale(1.05);
        }

        .mountain-tag-card:hover .mountain-tag-card__overlay {
            opacity: 1;
        }
    }

    @media (hover: none) {
        .mountain-tag-card__overlay {
            justify-content: flex-end;
            background: linear-gradient(
                to top,
                rgb(0 0 0 / 0.72),
                rgb(0 0 0 / 0) 70%
            );
            color: white;
            opacity: 1;
        }
    }

    @media (max-width: 1024px) {
        .mountain-tag-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 640px) {
        .mountain-tag-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 2px;
        }

        .mountain-tag-card__link {
            aspect-ratio: 1;
        }

        .mountain-tag-card img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .mountain-tag-card:not(.mountain-tag-card--without-cover)
            .mountain-tag-card__overlay {
            display: none;
        }

        .mountain-tag-card--without-cover .mountain-tag-card__overlay {
            padding: 0.35rem;
        }

        .mountain-tag-card--without-cover .mountain-tag-card__overlay h3 {
            font-size: 0.65rem;
            letter-spacing: 0.02em;
        }

        .mountain-tag-card--without-cover .mountain-tag-card__overlay p {
            margin-top: 0.25rem;
            font-size: 0.55rem;
        }
    }
</style>
