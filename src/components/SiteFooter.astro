---
import RssLink from "./RssLink.astro";
import DalinShoot from "./DalinShoot.astro";
import { getFolderFooter } from "../lib/constants";
import { getPostVolumes } from "../lib/albums/post-volumes";
import { postVolumeCurve } from "../lib/post-volume-curve";

const currentPath = Astro.url.pathname;
const pathSegments = currentPath.split("/").filter(Boolean);
const currentFolderSlug = pathSegments[0];
const folderFooter = currentFolderSlug ? getFolderFooter(currentFolderSlug) : null;
const isDalin = currentFolderSlug === "dalin";

// A folder's own page closes on its post-volume curve, drawn on the scale
// every folder shares.
const isFolderPage = pathSegments.length === 1 && (isDalin || Boolean(folderFooter));
const postVolume = isFolderPage
    ? await getPostVolumes().then((volumes) =>
          postVolumeCurve(volumes.byFolder.get(currentFolderSlug) ?? [], volumes.max),
      )
    : null;
---

{(isDalin || folderFooter) && (
	<footer class={postVolume ? "pb-12" : "py-12"}>
		<div class="mx-auto max-w-[1100px] px-4 sm:px-8">
			{postVolume && (
				<svg class="post-volume" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
					<path class="post-volume-line" d={postVolume.line} />
				</svg>
			)}
			<div class:list={["flex justify-center text-center", { "mt-3": postVolume }]}>
				{isDalin ? (
					<div class="text-subtle"><DalinShoot /></div>
				) : (
					<p class="m-0 text-subtle font-sans tracking-[0.3em] text-sm">{folderFooter}</p>
				)}
			</div>
		</div>
	</footer>
)}

{/* Phones reach RSS from the navigation menu instead. */}
{currentPath === "/" && (
	<footer class="hidden pb-8 sm:block">
		<div class="mx-auto flex max-w-[1100px] justify-end px-4 sm:px-8">
			<RssLink />
		</div>
	</footer>
)}

<style>
	/* The curve band is as tall as the navbar (h-24): the tallest post across
	   every folder reaches its top. The footer mark follows just below it. */
	.post-volume {
		display: block;
		width: 100%;
		height: 6rem;
		overflow: visible;
	}

	.post-volume-line {
		fill: none;
		stroke: var(--color-muted);
		stroke-width: 1.25;
		stroke-linejoin: round;
		vector-effect: non-scaling-stroke;
	}
</style>
