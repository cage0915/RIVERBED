---
import RssLink from "./RssLink.astro";
import { getFolderFooter } from "../lib/constants";

const currentPath = Astro.url.pathname;
const currentFolderSlug = currentPath.split("/").filter(Boolean)[0];
const folderFooter = currentFolderSlug ? getFolderFooter(currentFolderSlug) : null;
---

{folderFooter && (
	<footer class="py-12 border-t border-white/5">
		<div class="mx-auto max-w-[1100px] px-4 sm:px-8 text-center">
			<p
				class="text-zinc-500 font-sans tracking-[0.3em] text-sm"
			>
				{folderFooter}
			</p>
		</div>
	</footer>
)}

{/* Phones reach RSS from the navigation menu instead. */}
{currentPath === "/" && (
	<footer class="hidden pb-8 sm:block">
		<div class="mx-auto flex max-w-[1100px] justify-end px-4 sm:px-8">
			<RssLink />
		</div>
	</footer>
)}
