---
interface AlbumLink {
    slug: string;
    title: string;
}

interface Props {
    previous?: AlbumLink;
    next?: AlbumLink;
}

const { previous, next } = Astro.props;
---

{
    (previous || next) && (
        <nav class="album-pagination" aria-label="文章導覽">
            <div class="pagination-side pagination-side--next">
                {next && (
                    <a
                        href={`/${next.slug}`}
                        class="pagination-link pagination-link--left"
                        rel="next"
                        aria-label={`下一篇：${next.title}`}
                    >
                        <span class="pagination-arrow" aria-hidden="true">←</span>
                        <span>{next.title}</span>
                    </a>
                )}
            </div>

            <div class="pagination-side pagination-side--previous">
                {previous && (
                    <a
                        href={`/${previous.slug}`}
                        class="pagination-link pagination-link--right"
                        rel="prev"
                        aria-label={`上一篇：${previous.title}`}
                    >
                        <span>{previous.title}</span>
                        <span class="pagination-arrow" aria-hidden="true">→</span>
                    </a>
                )}
            </div>
        </nav>
    )
}

<style>
    .album-pagination {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 1.5rem;
        margin-top: 4rem;
        padding-top: 1.5rem;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
    }

    .pagination-side {
        min-width: 0;
    }

    .pagination-side--previous {
        text-align: right;
    }

    .pagination-link {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        max-width: 100%;
        color: rgb(161 161 170);
        font-family: "Noto Sans TC", "Noto Sans JP", sans-serif;
        font-size: 0.875rem;
        font-weight: 300;
        letter-spacing: 0.08em;
        line-height: 1.5;
        text-decoration: none;
        transition: color 200ms ease;
    }

    .pagination-link--right {
        justify-content: flex-end;
    }

    .pagination-link:hover,
    .pagination-link:focus-visible {
        color: rgb(244 244 245);
    }

    .pagination-link:focus-visible {
        outline: 1px solid rgba(255, 255, 255, 0.5);
        outline-offset: 0.4rem;
    }

    .pagination-arrow {
        flex: 0 0 auto;
        font-size: 1rem;
        transition: transform 200ms ease;
    }

    .pagination-link--left:hover .pagination-arrow,
    .pagination-link--left:focus-visible .pagination-arrow {
        transform: translateX(-0.2rem);
    }

    .pagination-link--right:hover .pagination-arrow,
    .pagination-link--right:focus-visible .pagination-arrow {
        transform: translateX(0.2rem);
    }

    @media (max-width: 640px) {
        .album-pagination {
            gap: 1rem;
            margin-top: 3rem;
        }

        .pagination-link {
            align-items: flex-start;
            font-size: 0.8125rem;
        }
    }
</style>
