---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import SiteDevTools from "../components/SiteDevTools.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteNavigation from "../components/SiteNavigation.astro";
import ContentKeyboardNavigation from "../components/ContentKeyboardNavigation.astro";
import PhotoLightbox from "../components/PhotoLightbox.astro";
import PhotoPlaceholder from "../components/PhotoPlaceholder.astro";
import NavigationProgress from "../components/NavigationProgress.astro";
import YamaWalker from "../components/YamaWalker.astro";
import YamaCow from "../components/YamaCow.astro";
import YamaSki from "../components/YamaSki.astro";
import { getShareImageUrl } from "../lib/constants";
// Keep the shared font baseline to the weight every route uses. Fontsource's
// numbered CJK faces include unicode-range declarations, so browsers fetch
// only the chunks needed by the text on the current page.
import "@fontsource/noto-sans-jp/400.css";
import "@fontsource/pt-sans/400.css";
import "@fontsource/source-sans-3/400.css";
import "@fontsource/noto-sans-tc/400.css";
import "photoswipe/dist/photoswipe.css";

interface Props {
	title: string;
	/** Which walker strolls along the bottom of the page (Yama posts), if any. */
	walker?: "hiker" | "cow" | "ski";
	/** Meta and link-preview description. */
	description?: string;
	/** R2 asset key of the photo shown when the page is shared. */
	shareImage?: string;
	/** Open Graph type: an Album page is an article, everything else a website. */
	shareType?: "website" | "article";
}

const {
	title,
	walker,
	description = "RIVERBED",
	shareImage,
	shareType = "website",
} = Astro.props;
// Previews already name the site (og:site_name), so drop the title suffix.
const shareTitle = title.replace(/ - RIVERBED$/, "");
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const shareImageUrl = shareImage ? getShareImageUrl(shareImage) : undefined;
---

<!doctype html>
<html lang="zh-Hant" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<meta name="theme-color" content="#121212" />
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:site_name" content="RIVERBED" />
		<meta property="og:locale" content="zh_TW" />
		<meta property="og:type" content={shareType} />
		<meta property="og:title" content={shareTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		{shareImageUrl && <meta property="og:image" content={shareImageUrl} />}
		{shareImageUrl && <meta property="og:image:alt" content={shareTitle} />}
		<meta name="twitter:card" content={shareImageUrl ? "summary_large_image" : "summary"} />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="alternate" type="application/rss+xml" title="RIVERBED RSS" href="/rss.xml" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		{/* Theme: runs before the first paint so the page never flashes the
		   wrong theme. The visitor's choice (saved by the navbar toggle) wins,
		   else their system setting, which is followed live until they choose.
		   ClientRouter replaces <html>'s attributes on every navigation, so the
		   theme is copied onto each incoming page before it swaps in. The
		   listeners are installed once; the guard skips them if this reruns. */}
		<script is:inline>
			(() => {
				const KEY = "riverbed-theme";
				const BAR_COLORS = { dark: "#121212", light: "#e4e4e7" };
				const media = matchMedia("(prefers-color-scheme: light)");
				const saved = () => {
					try {
						const value = localStorage.getItem(KEY);
						return value === "light" || value === "dark" ? value : null;
					} catch {
						return null;
					}
				};
				const resolve = () => saved() ?? (media.matches ? "light" : "dark");
				const apply = (doc, theme) => {
					doc.documentElement.dataset.theme = theme;
					doc.querySelector('meta[name="theme-color"]')?.setAttribute("content", BAR_COLORS[theme]);
				};
				const switchTo = (theme) => {
					const root = document.documentElement;
					root.setAttribute("data-theme-switching", "");
					apply(document, theme);
					requestAnimationFrame(() => requestAnimationFrame(() => root.removeAttribute("data-theme-switching")));
				};

				apply(document, resolve());
				if (window.__riverbedTheme) return;
				window.__riverbedTheme = true;

				document.addEventListener("astro:before-swap", (event) => {
					apply(event.newDocument, document.documentElement.dataset.theme);
				});
				media.addEventListener("change", () => {
					if (!saved()) switchTo(resolve());
				});
				document.addEventListener("click", (event) => {
					if (!(event.target instanceof Element) || !event.target.closest("[data-theme-toggle]")) return;
					const next = document.documentElement.dataset.theme === "light" ? "dark" : "light";
					try {
						localStorage.setItem(KEY, next);
					} catch {}
					switchTo(next);
				});
			})();
		</script>
		<ClientRouter />
	</head>
	<body
		class="bg-page text-fg min-h-screen antialiased selection:bg-fill-strong selection:text-fg-strong"
	>
		<NavigationProgress />
		<SiteNavigation />

		<main class="mx-auto max-w-[1100px] px-4 sm:px-8 pt-28 pb-8">
			<slot />
		</main>

		<ContentKeyboardNavigation />
		<PhotoLightbox />
		<PhotoPlaceholder />
		<SiteFooter />
		{walker === "hiker" && <YamaWalker />}
		{walker === "cow" && <YamaCow />}
		{walker === "ski" && <YamaSki />}
		<SiteDevTools />
	</body>
</html>

<style is:global>
	/* Scrollbar: a quiet thumb on a track that matches the page background. */
	::-webkit-scrollbar {
		width: 8px;
	}
	::-webkit-scrollbar-track {
		background: var(--color-page);
	}
	::-webkit-scrollbar-thumb {
		background: var(--color-scrollbar);
		border-radius: 4px;
	}
	::-webkit-scrollbar-thumb:hover {
		background: var(--color-faint);
	}

	/* Firefox has no ::-webkit-scrollbar. Chromium would let scrollbar-color
	   override the rules above, so apply it only where they don't exist. */
	@supports not selector(::-webkit-scrollbar) {
		:root {
			scrollbar-color: var(--color-scrollbar) var(--color-page);
		}
	}

	:root {
		font-family: "Noto Sans TC", "Noto Sans JP", sans-serif;
		scrollbar-gutter: stable;
	}

	@media (max-width: 767px) {
		:root {
			scrollbar-gutter: auto;
		}
	}

</style>
