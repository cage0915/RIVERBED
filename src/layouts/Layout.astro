---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import SiteDevTools from "../components/SiteDevTools.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteNavigation from "../components/SiteNavigation.astro";
import ContentKeyboardNavigation from "../components/ContentKeyboardNavigation.astro";
import PhotoLightbox from "../components/PhotoLightbox.astro";
import PhotoFadeIn from "../components/PhotoFadeIn.astro";
import NavigationProgress from "../components/NavigationProgress.astro";
import YamaWalker from "../components/YamaWalker.astro";
import { getShareImageUrl } from "../lib/constants";
// Keep the shared font baseline to the weight every route uses. Fontsource's
// numbered CJK faces include unicode-range declarations, so browsers fetch
// only the chunks needed by the text on the current page.
import "@fontsource/noto-sans-jp/400.css";
import "@fontsource/pt-sans/400.css";
import "@fontsource/noto-sans-tc/400.css";
import "photoswipe/dist/photoswipe.css";

interface Props {
	title: string;
	/** Show the walking hiker along the bottom of the page (Yama posts). */
	hiker?: boolean;
	/** Meta and link-preview description. */
	description?: string;
	/** R2 asset key of the photo shown when the page is shared. */
	shareImage?: string;
	/** Open Graph type: an Album page is an article, everything else a website. */
	shareType?: "website" | "article";
}

const {
	title,
	hiker = false,
	description = "RIVERBED",
	shareImage,
	shareType = "website",
} = Astro.props;
// Previews already name the site (og:site_name), so drop the title suffix.
const shareTitle = title.replace(/ - RIVERBED$/, "");
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const shareImageUrl = shareImage ? getShareImageUrl(shareImage) : undefined;
---

<!doctype html>
<html lang="zh-Hant" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<meta name="theme-color" content="#121212" />
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:site_name" content="RIVERBED" />
		<meta property="og:locale" content="zh_TW" />
		<meta property="og:type" content={shareType} />
		<meta property="og:title" content={shareTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		{shareImageUrl && <meta property="og:image" content={shareImageUrl} />}
		{shareImageUrl && <meta property="og:image:alt" content={shareTitle} />}
		<meta name="twitter:card" content={shareImageUrl ? "summary_large_image" : "summary"} />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="alternate" type="application/rss+xml" title="RIVERBED RSS" href="/rss.xml" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<ClientRouter />
	</head>
	<body
		class="bg-[#121212] text-zinc-100 min-h-screen antialiased selection:bg-white/20 selection:text-white"
	>
		<NavigationProgress />
		<SiteNavigation />

		<main class="mx-auto max-w-[1100px] px-4 sm:px-8 pt-20 pb-8">
			<slot />
		</main>

		<ContentKeyboardNavigation />
		<PhotoLightbox />
		<PhotoFadeIn />
		<SiteFooter />
		{hiker && <YamaWalker />}
		<SiteDevTools />
	</body>
</html>

<style is:global>
	/* Scrollbar: a quiet thumb on a track that matches the page background. */
	::-webkit-scrollbar {
		width: 8px;
	}
	::-webkit-scrollbar-track {
		background: #121212;
	}
	::-webkit-scrollbar-thumb {
		background: #3f3f46;
		border-radius: 4px;
	}
	::-webkit-scrollbar-thumb:hover {
		background: #52525b;
	}

	/* Firefox has no ::-webkit-scrollbar. Chromium would let scrollbar-color
	   override the rules above, so apply it only where they don't exist. */
	@supports not selector(::-webkit-scrollbar) {
		:root {
			scrollbar-color: #3f3f46 #121212;
		}
	}

	:root {
		font-family: "Noto Sans TC", "Noto Sans JP", sans-serif;
		scrollbar-gutter: stable;
	}

	@media (max-width: 767px) {
		:root {
			scrollbar-gutter: auto;
		}
	}

</style>
